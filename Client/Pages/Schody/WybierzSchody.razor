    </div>

</Modal>

@code
{
    [Inject]
    private AppState AppState { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private int currnet_page = 1;
    private int ilosc_na_stronie = 3;
    private int currnet_pageReplace = 1;

    private string encodedUrl = "";

    private string? activeKey = "0";

    private List<Schody>? listaSchody;

    private bool czyModalEdycjiWidoczny = false;
    private string bladEdycji = "";
    private Guid? edytowanyRowId = null;
    private Schody? edytowaneSchody = null;

    private string ObrazBase64 = "";
    private List<PlikiZlecenProdukcyjnych> pliki = new List<PlikiZlecenProdukcyjnych>();
    private PlikiZlecenProdukcyjnych? Plik;

    private string? filtrTyp;

    private double? filtrWysokosc;
    private double? filtrSzerokosc;
    private double? filtrGlebokosc;

    protected override async Task OnInitializedAsync()
    {
        if (AppState != null)
        {
            AppState.SomeData = "";
        }

        encodedUrl = "Schody 1/4 zabieg w lewo";

        await Laduj_Uprawnienia();

        await Task.CompletedTask;
    }

    private const double Tolerancja = 20.0;

    private IEnumerable<Schody> ListaSchodyFiltrowana =>
        listaSchody.Where(s =>

            // Typ schodów
            (string.IsNullOrWhiteSpace(filtrTyp)
                || (s.Typ?.Contains(filtrTyp, StringComparison.OrdinalIgnoreCase) ?? false))

            // Wysokość ±20 mm
            && (!filtrWysokosc.HasValue
                || Math.Abs(s.Wysokosc - filtrWysokosc.Value) <= Tolerancja)

            // Szerokość ±20 mm
            && (!filtrSzerokosc.HasValue
                || Math.Abs(s.Szerokosc - filtrSzerokosc.Value) <= Tolerancja)

            // Głębokość ±20 mm
            && (!filtrGlebokosc.HasValue
                || Math.Abs(s.Glebokosc - filtrGlebokosc.Value) <= Tolerancja)

        );

    private void WyczyscFiltry()
    {
        filtrTyp = "";

        filtrWysokosc = null;
        filtrSzerokosc = null;
        filtrGlebokosc = null;
    }

    private Task OtworzModalEdycji(Schody schody)
    {
        edytowaneSchody = new Schody
        {
            Id = schody.Id,
            RowId = schody.RowId,
            Typ = schody.Typ,
            Uwagi = schody.Uwagi,
            Wysokosc = schody.Wysokosc,
            Szerokosc = schody.Szerokosc,
            Glebokosc = schody.Glebokosc,
            GlebokoscZabieg1 = schody.GlebokoscZabieg1,
            GlebokoscZabieg2 = schody.GlebokoscZabieg2,
            SzerokoscZabieg1 = schody.SzerokoscZabieg1,
            SzerokoscZabieg2 = schody.SzerokoscZabieg2,
            Wycofany_z_produkcji = schody.Wycofany_z_produkcji,
            RysunekPogladowy = schody.RysunekPogladowy?.ToArray() ?? Array.Empty<byte>(),
            RowIdPliku = schody.RowIdPliku,
            DataZapisu = schody.DataZapisu,
            KtoZapisal = schody.KtoZapisal
        };

        bladEdycji = "";

        ObrazBase64 = schody.RysunekPogladowy != null && schody.RysunekPogladowy.Length > 0
            ? $"data:image/png;base64,{Convert.ToBase64String(schody.RysunekPogladowy)}"
            : "";

        czyModalEdycjiWidoczny = true;

        return Task.CompletedTask;
    }

    private async Task OnFileChange(string rowIdPliku)
    {
        if (string.IsNullOrEmpty(rowIdPliku))
        {
            _ = _notice.Info(new()
            {
                Message = "Uwaga!!!!",
                Description = "Zamówienie nie posiada załączonego pliku!!!",
                Placement = NotificationPlacement.BottomLeft
            });
            return;
        }
        Plik = pliki.FirstOrDefault(p => p.RowId == rowIdPliku);

        if (Plik != null)
        {
            await DownloadFile(Plik.NazwaPliku);
        }
    }

    private async Task DownloadFile(string fileName)
    {
        try
        {
            //await Task.Delay(1000);  // Czekaj 2 sekundy przed próbą pobrania

            // Konstrukcja pełnego URL dla plików w wwwroot/uploads/
            var fileUrl = $"{NavigationManager.BaseUri}uploads_zlecenia/{fileName}";

            if (!Uri.TryCreate(fileUrl, UriKind.Absolute, out var uri))
            {
                Console.WriteLine("Nieprawidłowy URL: " + fileUrl);
                return;
            }

            using (var httpClient = new HttpClient())
            {
                httpClient.Timeout = TimeSpan.FromMinutes(10);
                Console.WriteLine($"Pobieranie pliku z URL: {fileUrl}");

                using (var response = await httpClient.GetAsync(uri, HttpCompletionOption.ResponseHeadersRead))
                {
                    if (response.IsSuccessStatusCode)
                    {
                        var contentStream = await response.Content.ReadAsStreamAsync();
                        var actualFileName = Path.GetFileName(uri.LocalPath);

                        using (var memoryStream = new MemoryStream())
                        {
                            await contentStream.CopyToAsync(memoryStream);
                            memoryStream.Seek(0, SeekOrigin.Begin);

                            // Wywołaj JavaScript do pobrania pliku
                            await JSRuntime.InvokeVoidAsync("BlazorDownloadFile", actualFileName, memoryStream.ToArray());
                        }

                        Console.WriteLine($"Plik został pobrany i zapisany: {actualFileName}");
                    }
                    else
                    {
                        Console.WriteLine($"Nie udało się pobrać pliku. {response.Content.Headers}");

                        _ = _notice.Error(new()
                        {
                            Message = "System napotkał problem. Plik mógł zostać niepoprawnie pobrany",
                            Description = response.Content.Headers.ToString(),
                            Placement = NotificationPlacement.BottomLeft
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Wystąpił błąd podczas pobierania pliku: {ex.Message} / {ex.StackTrace}");
            _ = _notice.Error(new()
            {
                Message = ex.Message,
                Description = ex.StackTrace,
                Placement = NotificationPlacement.BottomLeft
            });
        }
    }


    private async Task WklejRysunek()
    {
        var base64 = await JS.InvokeAsync<string>("clipboardImage.readImage");

        if (!string.IsNullOrWhiteSpace(base64))
        {
            ObrazBase64 = base64;

            var index = base64.IndexOf(',');

            if (index >= 0)
                base64 = base64[(index + 1)..];

            edytowaneSchody.RysunekPogladowy =
                Convert.FromBase64String(base64);

            StateHasChanged();
        }
    }

    private void UsunRysunek()
    {
        edytowaneSchody.RysunekPogladowy = Array.Empty<byte>();
        ObrazBase64 = "";
    }

    // Zamknięcie modala
    private void ZamknijModalEdycji()
    {
        czyModalEdycjiWidoczny = false;
        edytowanyRowId = null;
        bladEdycji = "";

        edytowaneSchody = new Schody();
    }

    private bool bCzekajNaZapis = false;

    private async Task ZapiszEdycje()
    {

        if (bCzekajNaZapis)
        {
            return; // Jeśli już trwa zapis, nie rób nic
        }

        bCzekajNaZapis = true;

        try
        {
            bladEdycji = "";

            if (string.IsNullOrWhiteSpace(edytowaneSchody.Typ))
            {
                bladEdycji = "Wybierz typ schodów.";
                bCzekajNaZapis = false;
                return;
            }

            HttpResponseMessage response;

            // Nowy rekord
            if (edytowaneSchody.Id == 0)
            {
                edytowaneSchody.DataZapisu = DateTime.Now;

                response = await Http.PostAsJsonAsync(
                    "api/Schody",
                    edytowaneSchody);
            }
            // Edycja istniejącego
            else
            {
                edytowaneSchody.DataZapisu = DateTime.Now;

                response = await Http.PutAsJsonAsync(
                    "api/Schody",
                    edytowaneSchody);
            }

            if (response.IsSuccessStatusCode)
            {
                czyModalEdycjiWidoczny = false;

                // odśwież listę
                listaSchody = await Http.GetFromJsonAsync<List<Schody>>("api/Schody")
                               ?? new List<Schody>();

                StateHasChanged();
            }
            else
            {
                bladEdycji = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            bladEdycji = ex.Message;
        }

        bCzekajNaZapis = false;
    }

    private async Task OnPrzesuniecieChanged()
    {
        await Task.Delay(100); // Opcjonalne opóźnienie, aby upewnić się, że wartość została zaktualizowana
    }


    private async Task OnTabClick()
    {
        //Console.WriteLine($"Kliknięto zakładkę: {activeKey}");

        if (activeKey == "0")
        {

            StateHasChanged();

            await Task.Yield(); // Upewnij się, że UI jest zaktualizowane przed pobraniem danych

            listaSchody = await Http.GetFromJsonAsync<List<Schody>>("api/Schody");

            await LoadFiles();

            StateHasChanged();
        }

    }

    private async Task LoadFiles()
    {
        try
        {
            var response = await Http.GetAsync($"api/FileUploadZlec/all-files-sat");

            if (response.IsSuccessStatusCode)
            {
                var fileList = await response.Content.ReadFromJsonAsync<List<PlikiZlecenProdukcyjnych>>();
                if (fileList != null)
                {
                    // Filtruj pliki, jeśli użytkownik nie jest administratorem
                    //if (!boolAdmin)
                    //{
                    fileList = fileList.Where(p => p.WidocznyDlaWszystkich).ToList();
                    //}

                    // Upewnij się, że pole Uwagi nie jest null lub pusty string
                    foreach (var itm in fileList)
                    {
                        itm.Uwagi ??= string.Empty;
                    }

                    pliki = fileList;
                }
                else
                {
                    pliki = new List<PlikiZlecenProdukcyjnych>();
                }
            }
            else
            {
                // Obsługa błędów dla przypadków nieudanych odpowiedzi
                if (response.StatusCode == HttpStatusCode.NotFound)
                {
                    // Obsługa przypadku 404 Not Found
                    Console.Error.WriteLine($"404 Not Found: The file with name: SAT was not found.");
                }
                else
                {
                    // Obsługa innych błędów
                    Console.Error.WriteLine($"Error loading files: {response.StatusCode} - {response.ReasonPhrase}");
                }
                pliki = new List<PlikiZlecenProdukcyjnych>();
            }
        }
        catch (HttpRequestException httpRequestException)
        {
            // Obsługa błędów połączenia HTTP
            Console.Error.WriteLine($"HTTP request error: {httpRequestException.Message}");
            pliki = new List<PlikiZlecenProdukcyjnych>();
        }
        catch (JsonException jsonException)
        {
            // Obsługa błędów deserializacji JSON
            Console.Error.WriteLine($"JSON parsing error: {jsonException.Message}");
            pliki = new List<PlikiZlecenProdukcyjnych>();
        }
        catch (Exception ex)
        {
            // Globalna obsługa innych wyjątków
            Console.Error.WriteLine($"An unexpected error occurred while loading files: {ex.Message}");
            pliki = new List<PlikiZlecenProdukcyjnych>();
        }
    }

    public async Task deleteRow(string rowId)
    {
        if (listaSchody == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/Schody/{rowId}");

            if (response.IsSuccessStatusCode)
            {
                listaSchody = await Http.GetFromJsonAsync<List<Schody>>("api/Schody") ?? new();

                StateHasChanged();

                Console.WriteLine("Rekord został pomyślnie usunięty.");
            }
            else
            {
                Console.WriteLine($"Błąd podczas usuwania rekordu: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"******* Błąd {ex.Message}");
        }
    }

    private void ZmienIloscNaStronie(PaginationEventArgs args)
    {
        ilosc_na_stronie = args.PageSize;
    }

    private Task UpdateCurrentPage(PaginationEventArgs args)
    {
       // Console.WriteLine(currnet_page);
        currnet_page = args.Page;
       // Console.WriteLine(currnet_page);

        return SomeOtherMethod(); // Wywołanie innej metody po aktualizacji strony
    }

    private async Task SomeOtherMethod()
    {

        currnet_pageReplace = currnet_page;
        await LocalStorage.SaveStringAsync("currnet_page", currnet_page.ToString());
        //Console.WriteLine($"Zapisałem currnet_page : {currnet_page}");
        await Task.CompletedTask;
    }

    private async Task GoBack()
    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }

    // Uprawnienia
    private bool boolOdczyt = false;
    private bool boolZmiana = false;
    private bool boolZapis = false;
    private bool boolUsuniecia = false;
    private bool boolAdmin = false;
    private string RowIdPracownika = "---";
    private string RowIdDzal = "";
    private string user = "";
    private List<UprawnieniaPracownikaViewModel>? uprawnienia;

    private async Task Laduj_Uprawnienia()
    {

        user = await LocalStorage.GetStringAsync("user");

        string nazwaTabeli = "Schody";

        if (user == null)
        {
            return;
        }

        try
        {
            uprawnienia = await Http.GetFromJsonAsync<List<UprawnieniaPracownikaViewModel>>($"api/ZwrocSatus/{user}/{nazwaTabeli}");
        }
        catch (System.Net.Http.HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            Console.WriteLine("Brak danych!!!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Błąd!!! Info:{ex.Message}");
        }

        if (uprawnienia != null)
        {
            if (uprawnienia.Count > 0)
            {

                var znalezioneElementy = uprawnienia.Where(uprawnienie => uprawnienie.TableName == nazwaTabeli);

                if (znalezioneElementy.Count() > 0)
                {
                    var szuk = znalezioneElementy.FirstOrDefault(x => x.TableName == nazwaTabeli);

                    if (szuk != null)
                    {
                        boolOdczyt = szuk.Odczyt;
                        boolZmiana = szuk.Zmiana;
                        boolUsuniecia = szuk.Usuniecie;
                        boolAdmin = szuk.Administrator;
                        boolZapis = szuk.Zapis;
                        RowIdPracownika = szuk.RowId;
                        RowIdDzal = szuk.RowIdDzialu;

                    }
                }
            }
        }
    }

}