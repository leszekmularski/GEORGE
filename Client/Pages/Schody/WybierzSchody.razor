    <TabPane Key="1" Tab="Wyszukiwarka schodów">

        @if (listaSchody == null)
        {
            <div class="skeleton-wrapper">
                <div class="row">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card skeleton-card">
                                <div class="skeleton-image"></div>
                                <div class="card-body">
                                    <div class="skeleton-line skeleton-line-title"></div>
                                    <div class="skeleton-line skeleton-line-short"></div>
                                    <div class="skeleton-line skeleton-line-medium"></div>
                                    <div class="skeleton-line skeleton-line-short"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (!listaSchody.Any())
        {
            <div class="text-center py-5 my-4">
                <div class="empty-state">
                    <div class="empty-state-icon mb-4">
                        <i class="bi bi-door-open" style="font-size: 5rem; color: #6c757d;"></i>
                    </div>
                    <h4 class="text-muted mb-3">Brak schodów w bazie</h4>
                    <p class="text-secondary mb-4">Nie masz jeszcze żadnych drzwi. Dodaj pierwsze schody, aby rozpocząć pracę.</p>
                    <button class="btn btn-primary btn-lg" @onclick="() => OtworzModalEdycji(new Schody())">
                        <i class="bi bi-plus-circle me-2"></i>Dodaj pierwszy model schodów
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="card mb-3">

                @if (boolZapis || boolAdmin)
                {
                    <div class="col-md-2">
                        <button class="btn btn-primary" @onclick="() => OtworzModalEdycji(new Schody())">Dodaj nowe schody</button>
                    </div>
                }

                <div class="card-body">

                    <div class="row g-3 align-items-end">

                        <!-- Typ -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Typ schodów</label>
                            <Input @bind-Value="filtrTyp"
                                   Placeholder="np. Schody proste"
                                   AllowClear
                                   Class="w-100" />
                        </div>

                        <!-- Wysokość -->
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Wysokość ±20 mm</label>
                            <AntDesign.InputNumber @bind-Value="filtrWysokosc"
                                                   class="form-control w-100" />
                        </div>

                        <!-- Szerokość -->
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Szerokość ±20 mm</label>
                            <AntDesign.InputNumber @bind-Value="filtrSzerokosc"
                                                   class="form-control w-100" />
                        </div>

                        <!-- Głębokość -->
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Głębokość ±20 mm</label>
                            <AntDesign.InputNumber @bind-Value="filtrGlebokosc"
                                                   class="form-control w-100" />
                        </div>

                        <!-- Button -->
                        <div class="col-md-2">
                            <Button Type="@ButtonType.Default"
                                    Block
                                    Icon="@IconType.Outline.Clear"
                                    OnClick="WyczyscFiltry"
                                    class="w-100"
                                    style="height: 38px;">
                                Wyczyść
                            </Button>
                        </div>

                    </div>

                </div>
            </div>
            <Layout>
             <Content>
                    <table class="table table-bordered table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>Rysunek</th>
                            <th>Typ</th>
                            <th>Wysokość [mm]</th>
                            <th>Szerokość [mm]</th>
                            <th>Głębokość [mm]</th>
                            <th style="width: 120px;">Akcja</th>
                        </tr>
                    </thead>
                    <tbody>

                        @for (int i = (currnet_page - 1) * ilosc_na_stronie; i < currnet_page * ilosc_na_stronie; i++)
                        {

                        if (i >= ListaSchodyFiltrowana.Count()) // Sprawdź, czy indeks jest poza zakresem listy danych
                        {
                            break; // Wyjście z pętli, jeśli indeks jest poza zakresem
                        }

                            var schody = ListaSchodyFiltrowana.ElementAt(i);

                            <tr>
                                <td>
                                    @if (schody.RysunekPogladowy?.Length > 20)
                                    {
                                        <a target="_blank" href="data:image/png;base64,@Convert.ToBase64String(schody.RysunekPogladowy)">
                                            <img title="zew:@schody.SzerokoscZabieg1 wew:@schody.SzerokoscZabieg2"
                                                 src="data:image/png;base64,@Convert.ToBase64String(schody.RysunekPogladowy)"
                                                 style="width: 150px; height: auto; object-fit: contain; border: 1px solid #ccc;" />
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Brak</span>
                                    }
                                </td>
                                <td>@(schody.Typ ?? "")</td>
                                <td>@schody.Wysokosc</td>
                                <td>@schody.Szerokosc</td>
                                <td>@schody.Glebokosc</td>
                                <td>
                                    <div class="d-flex gap-1">

                                        <Button Type="@ButtonType.Primary"
                                                Block
                                                Icon="@IconType.Outline.Download"
                                                Disabled="@(schody.RowIdPliku == Guid.Empty)"
                                                OnClick="() => OnFileChange(schody.RowIdPliku.ToString())">
                                            Pobierz
                                        </Button>

                                        @if (boolZmiana || boolAdmin)
                                        {
                                            <Tooltip Title="Edytuj">
                                                <Button Type="primary"
                                                        Size="small"
                                                        Icon="@IconType.Outline.Edit"
                                                        OnClick="() => OtworzModalEdycji(schody)" />
                                            </Tooltip>
                                        }

                                        @if (boolUsuniecia || boolAdmin)
                                        {
                                            <Popconfirm Title="Czy chcesz usunąć dane?"
                                                        OnConfirm="()=> deleteRow(schody.RowId.ToString())"
                                                        OkText="Tak"
                                                        CancelText="Nie">
                                                <Tooltip Title="Usuń połączenie">
                                                    <Button Type="danger"
                                                            Size="small"
                                                            Icon="@IconType.Outline.Delete"
                                                            Danger />
                                                </Tooltip>
                                            </Popconfirm>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                 </Content>
                <Footer>
                    <Pagination DefaultCurrent="@currnet_pageReplace" Total="@ListaSchodyFiltrowana.Count()" OnShowSizeChange="ZmienIloscNaStronie"
                                PageSize="@ilosc_na_stronie" OnChange="UpdateCurrentPage" />
                        <br />
                        <label>Liczba załadowanych rekordów: @ListaSchodyFiltrowana.Count() / Strona @currnet_page</label>

                </Footer>
            </Layout>
        }

    </TabPane>

</Tabs>

<!-- Modal edycji -->
