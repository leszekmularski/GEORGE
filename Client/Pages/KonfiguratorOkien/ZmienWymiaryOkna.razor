@using GEORGE.Client.Pages.Models
@using GEORGE.Shared.ViewModels
@inject GEORGE.Client.Pages.KonfiguratorOkien.ShapeTransferService ShapeService

@if (Model == null)
{
    <p class="text-muted">Brak danych do edycji okna.</p>
}
else
{
    <EditForm Model="Model">
        <DataAnnotationsValidator />

        <AntDesign.Tabs DefaultActiveKey="1" Type="@TabType.Line">

            @* ═══════════════════════════════════════════════════════════ *@
            @* ZAKŁADKA 1: WYMIARY                                        *@
            @* ═══════════════════════════════════════════════════════════ *@
            <AntDesign.TabPane Key="1" Tab="Wymiary">
                @{
                    // ⭐ Pokazujemy TYLKO właściwości z gabarytOkna = true
                    var wymiaryProps = Model.EditableProperties
                    .Select((p, i) => (Index: i, Prop: p))
                    .Where(x => x.Prop.gabarytOkna && !x.Prop.systemowa)
                    .ToList();
                }

                @if (wymiaryProps.Any())
                {
                    @foreach (var (index, prop) in wymiaryProps)
                    {
                        <div class="mb-3" style="padding: 8px; border-bottom: 1px solid #f0f0f0;">
                            <label style="font-weight: 500; color: #333; display: block; margin-bottom: 4px;">
                                @prop.Label
                            </label>

                            @if (!prop.IsReadOnly)
                            {
                                <div style="display: flex; align-items: center; gap: 5px;">
                                    <AntDesign.InputNumber Value="@Model.GetPropertyValue(index)"
                                                           ValueChanged="@(async (double value) =>
                                                            {
                                                                var currentProp = Model.EditableProperties[index];
                                                                var lbl = currentProp.Label?.ToLower() ?? "";

                                                                bool czySzerokosc = lbl.Trim().StartsWith("szerokość");
                                                                bool czyWysokosc = lbl.Trim().StartsWith("wysokość");
                                                                bool czyPromien = lbl.Trim().StartsWith("promień okna");
                                                                bool czyKwadrat = lbl.Trim().StartsWith("wymiar okna kwadratowego");

                                                                double staraSzer = Model.Szerokosc;   // ← 1250
                                                                double staraWys = Model.Wysokosc;    // ← 1000

                                                                jestZmianaGabarytow = Model.UpdateEditableProperty(index, value);

                                                                Console.WriteLine($"[DEBUG] ZmienWymiaryOkna.razor: ValueChanged dla index={index}, Label='{lbl}', Nowa wartość={value}, jestZmianaGabarytow={jestZmianaGabarytow}");

                                                                if (jestZmianaGabarytow)
                                                                {
                                                                    bool rozstawPionowe = czySzerokosc || czyPromien || czyKwadrat;
                                                                    bool rozstawPoziome = czyWysokosc || czyPromien || czyKwadrat;
                                                                    bool rozciagnij = czySzerokosc || czyWysokosc || czyPromien || czyKwadrat;

                                                                    double nowaSzer = Model.Szerokosc;   // ← 2500
                                                                    double nowaWys = Model.Wysokosc;    // ← 1000

                                                                    // ⭐ Skaluj shapes ze starych wymiarów
                                                                    if (1 > 3)
                                                                        LineUtils.SkalujShapesDoWymiarowRozciagajacZeStarymiWymiarami(
                                                                        ShapeService.Shapes, staraSzer, staraWys, nowaSzer, nowaWys);

                                                             
                                                                    if (1 > 3)
                                                                    await PodzielLinieSymetrycznieAsync(
                                                                        ustawTylkoLinie: true,
                                                                        pionowe: rozstawPionowe,
                                                                        poziome: rozstawPoziome,
                                                                        rozciagnijLinie: rozciagnij);
                                                                }

                                                                StateHasChanged();
                                                            })"
                                           Style="flex: 1;" />

                                                                                                <AntDesign.Button Type="@ButtonType.Default"
                                                                                                                  Icon="calculator"
                                                                                                                  OnClick="@(() => ShowCalculator(index))"
                                                                                                                  Size="small"
                                                                                                                  Style="height: 32px;" />
                                                                                            </div>
                                }
                            else
                            {
                                <AntDesign.InputNumber Value="@Model.GetPropertyValue(index)"
                                                       Style="width: 100%;"
                                                       Disabled="true" />
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">Brak właściwości wymiarów.</p>
                }
            </AntDesign.TabPane>

            @* ═══════════════════════════════════════════════════════════ *@
            @* ZAKŁADKA 2: LINIE (pionowe + poziome + szczegóły)          *@
            @* ═══════════════════════════════════════════════════════════ *@
            <AntDesign.TabPane Key="2" Tab="Linie">
                @{
                    // ============================================================
                    // ZBIERZ WSZYSTKIE WŁAŚCIWOŚCI LINII
                    // ============================================================

                    var wszystkieLinie = Model.EditableProperties
                    .Select((p, i) => (Index: i, Prop: p))
                    .Where(x => !x.Prop.gabarytOkna &&
                    !string.IsNullOrEmpty(x.Prop.NazwaObiektu) &&
                    x.Prop.NazwaObiektu.ToLower().Contains("linia"))
                    .ToList();

                    // Grupuj właściwości po linii
                    var grupyLinii = wszystkieLinie
                    .GroupBy(x => x.Prop.SplitGroupId ?? x.Prop.ShapeId)
                    .ToList();

                    // Linie pionowe
                    var liniePionowe = grupyLinii
                    .Where(g => g.Any(x => x.Prop.IsPionowa))
                    .ToList();

                    // Linie poziome
                    var liniePoziome = grupyLinii
                    .Where(g => g.Any(x => x.Prop.IsPozioma))
                    .ToList();

                    // Linie skośne
                    var linieSkosne = grupyLinii
                    .Where(g => g.Any(x => x.Prop.IsSkosna))
                    .ToList();

                    // Diagnostyka
                    var wszystkieLinieBezFlag = wszystkieLinie
                    .Where(x => !x.Prop.IsPionowa
                    && !x.Prop.IsPozioma
                    && !x.Prop.IsSkosna
                    && x.Prop.Label?.Trim() != "Kąt w stopniach"
                    && x.Prop.Label?.Trim() != "Kąt linii")
                    .ToList();
                }

                @* ================================================================
                   DIAGNOSTYKA
                   ================================================================ *@
                <div style="background: #fffbe6; padding: 8px 12px; margin-bottom: 12px; border: 1px solid #ffe58f; border-radius: 6px; font-size: 12px;">
                    🔍 <b>Linie:</b>
                    wszystkich=@grupyLinii.Count,
                    pionowe=@liniePionowe.Count,
                    poziome=@liniePoziome.Count,
                    skośne=@linieSkosne.Count
                </div>

                @if (!wszystkieLinie.Any())
                {
                    <p class="text-muted">
                        Brak właściwości linii (NazwaObiektu nie zawiera "linia").
                    </p>
                }
                else
                {
                    @* ============================================================
                       LINIE PIONOWE
                       ============================================================ *@
                    @if (liniePionowe.Any())
                    {
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 10px; margin-bottom: 8px;">
                            <h6 style="margin: 0; color: #1890ff; font-weight: 600;">
                                📏 Linie pionowe (@liniePionowe.Count)
                            </h6>

                            <AntDesign.Button Type="@ButtonType.Primary"
                                              Icon="pic-center"
                                              Size="small"
                                              OnClick="@(() => PodzielLinieSymetrycznieAsync(
                                                false,
                                                pionowe: true,
                                                poziome: false))">
                    Rozstaw pionowe
                </AntDesign.Button>
            </div>

                        <div style="max-height: 400px; overflow-y: auto; padding: 2px; margin-bottom: 15px;">
                @{
                                int licznikPion = 0;
                            }

                            @foreach (var grupa in liniePionowe)
                            {
                                licznikPion++;

                                var edytowalne = grupa
                                .Where(x => !x.Prop.IsReadOnly)
                                .ToList();

                                var tylkoOdczyt = grupa
                                .Where(x => x.Prop.IsReadOnly)
                                .ToList();

                                <div style="border: 1px solid #91d5ff; border-radius: 6px; margin-bottom: 8px; background: white; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">

                                    @* ------------------------------------------------
                                       NAGŁÓWEK
                                       ------------------------------------------------ *@
                                    <div style="background: #e6f7ff; padding: 6px 10px; display: flex; justify-content: space-between; align-items: center;">
                                        <b style="color: #1890ff; font-size: 13px;">
                                            📏 Linia pionowa #@licznikPion
                                        </b>

                                        <span style="color: #888; font-size: 10px;">
                                            ID:
                                            @(grupa.Key?.Length >= 50
                                                                        ? grupa.Key.Substring(0, 50) + "..."
                                                                        : grupa.Key)
                        </span>
                    </div>

                                    @* ------------------------------------------------
                                       PUNKTY + AKCJE
                                       ------------------------------------------------ *@
                                    <div style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; flex-wrap: wrap;">

                        @foreach (var (index, prop) in edytowalne)
                                        {
                                            <div style="display: flex; align-items: center; gap: 6px; flex: 1 1 220px; min-width: 200px;">
                                                <label style="font-weight: 500; color: #444; font-size: 12px; white-space: nowrap; margin: 0;">
                                                    @prop.Label
                                                </label>

                                                <AntDesign.InputNumber Value="@Model.GetPropertyValue(index)"
                                                                       ValueChanged="@(async (double value) =>
                                                  await HandleLiniaPionowaChange(index, value))"
                                                   Style="flex: 1; min-width: 90px; height: 32px;" />
                        </div>
                                                }

                                        @* ------------------------------------------------
                                           PRZYCISKI AKCJI
                                           ------------------------------------------------ *@
                                        @if (edytowalne.Any())
                                        {
                                            var pierwszyIndex = edytowalne.First().Index;

                                            <div style="display: flex; align-items: center; gap: 5px; margin-left: auto; flex-shrink: 0;">
                                                <AntDesign.Button Type="@ButtonType.Default"
                                                                  Icon="calculator"
                                                                  OnClick="@(() => ShowCalculator(pierwszyIndex))"
                                                                  Size="small"
                                                                  Style="height: 32px;" />

                                                <span title="Usuń całą tę linię z modelu">
                                                    <AntDesign.Button Type="@ButtonType.Primary"
                                                                      Icon="delete"
                                                                      Size="small"
                                                                      OnClick="@(() => UsunLinie(pierwszyIndex))"
                                                                      Style="height: 32px;" />
                                                </span>
                                            </div>
                                        }
                                    </div>

                                    @* ------------------------------------------------
                                       WŁAŚCIWOŚCI TYLKO DO ODCZYTU
                                       ------------------------------------------------ *@
                                    @if (tylkoOdczyt.Any())
                                    {
                                        <div style="border-top: 1px solid #f0f0f0; background: #fafafa; padding: 5px 10px;">
                                            <div style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap;">
                                                @foreach (var (index, prop) in tylkoOdczyt)
                                                {
                                                    <div style="display: flex; align-items: center; gap: 5px;">
                                                        <label style="color: #888; font-size: 11px; margin: 0; white-space: nowrap;">
                                                            @prop.Label
                                                        </label>

                                                        <AntDesign.InputNumber Value="@Model.GetPropertyValue(index)"
                                                                               Style="width: 100px; height: 28px;"
                                                                               Disabled="true" />
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @* ================================================================
                       LINIE POZIOME
                       ================================================================ *@
                    @if (liniePoziome.Any())
                    {
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 10px; margin-bottom: 8px;">
                            <h6 style="margin: 0; color: #52c41a; font-weight: 600;">
                                📐 Linie poziome (@liniePoziome.Count)
                            </h6>

                            <AntDesign.Button Type="@ButtonType.Primary"
                                              Icon="pic-center"
                                              Size="small"
                                              OnClick="@(() => PodzielLinieSymetrycznieAsync(
                                                                                                                                              false,
                                                                                                                                              pionowe: false,
                                                                                                                                              poziome: true))">
                    Rozstaw poziome
                </AntDesign.Button>
            </div>

                        <div style="max-height: 400px; overflow-y: auto; padding: 2px; margin-bottom: 15px;">
                @{
                                int licznikPoz = 0;
                            }

                            @foreach (var grupa in liniePoziome)
                            {
                                licznikPoz++;

                                var edytowalne = grupa
                                .Where(x => !x.Prop.IsReadOnly)
                                .ToList();

                                var tylkoOdczyt = grupa
                                .Where(x => x.Prop.IsReadOnly)
                                .ToList();

                                <div style="border: 1px solid #b7eb8f; border-radius: 6px; margin-bottom: 8px; background: white; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">

                                    @* NAGŁÓWEK *@
                                    <div style="background: #f6ffed; padding: 6px 10px; display: flex; justify-content: space-between; align-items: center;">
                                        <b style="color: #52c41a; font-size: 13px;">
                                            📐 Linia pozioma #@licznikPoz
                                        </b>

                                        <span style="color: #888; font-size: 10px;">
                                            ID:
                                            @(grupa.Key?.Length >= 50
                                                                        ? grupa.Key.Substring(0, 50) + "..."
                                                                        : grupa.Key)
                        </span>
                    </div>

                                    @* PUNKTY + AKCJE *@
                                    <div style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; flex-wrap: wrap;">

                        @foreach (var (index, prop) in edytowalne)
                                        {
                                            <div style="display: flex; align-items: center; gap: 6px; flex: 1 1 220px; min-width: 200px;">
                                                <label style="font-weight: 500; color: #444; font-size: 12px; white-space: nowrap; margin: 0;">
                                                    @prop.Label
                                                </label>

                                                <AntDesign.InputNumber Value="@Model.GetPropertyValue(index)"
                                                                       ValueChanged="@(async (double value) =>
                                                     await HandleLiniaPoziomaChange(index, value))"
                                                   Style="flex: 1; min-width: 90px; height: 32px;" />
                        </div>
                                                }

                                        @* AKCJE *@
                                        @if (edytowalne.Any())
                                        {
                                            var pierwszyIndex = edytowalne.First().Index;

                                            <div style="display: flex; align-items: center; gap: 5px; margin-left: auto; flex-shrink: 0;">
                                                <AntDesign.Button Type="@ButtonType.Default"
                                                                  Icon="calculator"
                                                                  OnClick="@(() => ShowCalculator(pierwszyIndex))"
                                                                  Size="small"
                                                                  Style="height: 32px;" />

                                                <span title="Usuń całą tę linię z modelu">
                                                    <AntDesign.Button Type="@ButtonType.Primary"
                                                                      Icon="delete"
                                                                      Size="small"
                                                                      OnClick="@(() => UsunLinie(pierwszyIndex))"
                                                                      Style="height: 32px;" />
                                                </span>
                                            </div>
                                        }
                                    </div>

                                    @* WŁAŚCIWOŚCI TYLKO DO ODCZYTU *@
                                    @if (tylkoOdczyt.Any())
                                    {
                                        <div style="border-top: 1px solid #f0f0f0; background: #fafafa; padding: 5px 10px;">
                                            <div style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap;">
                                                @foreach (var (index, prop) in tylkoOdczyt)
                                                {
                                                    <div style="display: flex; align-items: center; gap: 5px;">
                                                        <label style="color: #888; font-size: 11px; margin: 0; white-space: nowrap;">
                                                            @prop.Label
                                                        </label>

                                                        <AntDesign.InputNumber Value="@Model.GetPropertyValue(index)"
                                                                               Style="width: 100px; height: 28px;"
                                                                               Disabled="true" />
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @* ================================================================
                       LINIE SKOŚNE
                       ================================================================ *@
                    @if (linieSkosne.Any())
                    {
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 10px; margin-bottom: 8px;">
                            <h6 style="margin: 0; color: #fa8c16; font-weight: 600;">
                                📐 Linie skośne (@linieSkosne.Count)
                            </h6>
                        </div>

                        <div style="max-height: 400px; overflow-y: auto; padding: 2px; margin-bottom: 15px;">
                            @{
                                int licznikSko = 0;
                            }

                            @foreach (var grupa in linieSkosne)
                            {
                                licznikSko++;

                                var edytowalne = grupa
                                .Where(x => !x.Prop.IsReadOnly)
                                .ToList();

                                var tylkoOdczyt = grupa
                                .Where(x => x.Prop.IsReadOnly)
                                .ToList();

                                <div style="border: 1px solid #ffd591; border-radius: 6px; margin-bottom: 8px; background: white; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">

                                    @* NAGŁÓWEK *@
                                    <div style="background: #fff7e6; padding: 6px 10px; display: flex; justify-content: space-between; align-items: center;">
                                        <b style="color: #fa8c16; font-size: 13px;">
                                            📐 Linia skośna #@licznikSko
                                        </b>

                                        <span style="color: #888; font-size: 10px;">
                                            ID:
                                            @(grupa.Key?.Length >= 50
                                                                        ? grupa.Key.Substring(0, 50) + "..."
                                                                        : grupa.Key)
                        </span>
                    </div>

                                    @* PUNKTY + AKCJE *@
                                    <div style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; flex-wrap: wrap;">

                        @foreach (var (index, prop) in edytowalne)
                                        {
                                            <div style="display: flex; align-items: center; gap: 6px; flex: 1 1 220px; min-width: 200px;">
                                                <label style="font-weight: 500; color: #444; font-size: 12px; white-space: nowrap; margin: 0;">
                                                    @prop.Label
                                                </label>

                                                <AntDesign.InputNumber Value="@Model.GetPropertyValue(index)"
                                                                       ValueChanged="@(async (double value) =>
                                                        await HandleLiniaSkosnaChange(index, value))"
                                                   Style="flex: 1; min-width: 90px; height: 32px;" />
                        </div>
                                                }

                                        @* AKCJE *@
                                        @if (edytowalne.Any())
                                        {
                                            var pierwszyIndex = edytowalne.First().Index;

                                            <div style="display: flex; align-items: center; gap: 5px; margin-left: auto; flex-shrink: 0;">
                                                <AntDesign.Button Type="@ButtonType.Default"
                                                                  Icon="calculator"
                                                                  OnClick="@(() => ShowCalculator(pierwszyIndex))"
                                                                  Size="small"
                                                                  Style="height: 32px;"
                                                                  Title="Kalkulator" />

                                                <span title="Usuń całą tę linię z modelu">
                                                    <AntDesign.Button Type="@ButtonType.Primary"
                                                                      Icon="delete"
                                                                      Size="small"
                                                                      OnClick="@(() => UsunLinie(pierwszyIndex))"
                                                                      Style="height: 32px;" />
                                                </span>
                                            </div>
                                        }
                                    </div>

                                    @* WŁAŚCIWOŚCI TYLKO DO ODCZYTU *@
                                    @if (tylkoOdczyt.Any())
                                    {
                                        <div style="border-top: 1px solid #f0f0f0; background: #fafafa; padding: 5px 10px;">
                                            <div style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap;">
                                                @foreach (var (index, prop) in tylkoOdczyt)
                                                {
                                                    <div style="display: flex; align-items: center; gap: 5px;">
                                                        <label style="color: #888; font-size: 11px; margin: 0; white-space: nowrap;">
                                                            @prop.Label
                                                        </label>

                                                        <AntDesign.InputNumber Value="@Model.GetPropertyValue(index)"
                                                                               Style="width: 100px; height: 28px;"
                                                                               Disabled="true" />
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </AntDesign.TabPane>

            @* ═══════════════════════════════════════════════════════════ *@
            @* ZAKŁADKA 3: KOLORYSTYKA                                     *@
            @* ═══════════════════════════════════════════════════════════ *@
            <AntDesign.TabPane Key="3" Tab="Kolorystyka">
                <div class="mb-2">
                    <label>Kolor zewnętrzny</label>
                    <AntDesign.Input @bind-Value="Model.KolorZewnetrzny" Style="width: 100%;" />
                </div>

                <div class="mb-2">
                    <label>Kolor wewnętrzny</label>
                    <AntDesign.Input @bind-Value="Model.KolorWewnetrzny" Style="width: 100%;" />
                </div>

                <div class="mb-2">
                    <label>Kolor szyby</label>
                    <AntDesign.Input @bind-Value="Model.KolorSzyby" Style="width: 100%;" />
                </div>
            </AntDesign.TabPane>

            @* ═══════════════════════════════════════════════════════════ *@
            @* ZAKŁADKA 4: SZCZEGÓŁY TECHNICZNE                            *@
            @* ═══════════════════════════════════════════════════════════ *@
            <AntDesign.TabPane Key="4" Tab="Szczegóły techniczne">
                <div class="mb-2">
                    <label>Typ szyby</label>
                    <AntDesign.Input @bind-Value="Model.TypSzyby" Style="width: 100%;" />
                </div>

                <div class="mb-2">
                    <label>Typ klamki</label>
                    <AntDesign.Input @bind-Value="Model.TypKlamki" Style="width: 100%;" />
                </div>

                <div class="mb-2">
                    <label>Typ uszczelek</label>
                    <AntDesign.Input @bind-Value="Model.TypUszczelek" Style="width: 100%;" />
                </div>

                <div class="mb-2">
                    <label>Typ osłon przeciwsłonecznych</label>
                    <AntDesign.Input @bind-Value="Model.TypOslonPrzeciwsłonecznych" Style="width: 100%;" />
                </div>

                <div class="mb-2">
                    <label>Typ montażu</label>
                    <AntDesign.Input @bind-Value="Model.TypMontazu" Style="width: 100%;" />
                </div>
            </AntDesign.TabPane>

            @* ═══════════════════════════════════════════════════════════ *@
            @* ZAKŁADKA 5: PARAMETRY CIEPLNE                               *@
            @* ═══════════════════════════════════════════════════════════ *@
            <AntDesign.TabPane Key="5" Tab="Parametry cieplne">
                <div style="display: flex; align-items: center; gap: 5px; margin-bottom: 10px;">
                    <label style="width: 150px;">Grubość pakietu</label>
                    <AntDesign.InputNumber @bind-Value="Model.GruboscPakietu"
                                           Style="flex: 1;"
                                           OnChange="async (float value) => await ZapiszDoRodzica()" />
                    <INOUT_KALKULATOR @bind-WynikFloat="Model.GruboscPakietu" _sizeButton="Large" Naglowek="Grubość pakietu" />
                </div>

                <div style="display: flex; align-items: center; gap: 5px; margin-bottom: 10px;">
                    <label style="width: 150px;">Uw szyby</label>
                    <AntDesign.InputNumber @bind-Value="Model.WspolczynnikPrzepuszczalnosciCieplaSzyby"
                                           Style="flex: 1;"
                                           OnChange="async (float value) => await ZapiszDoRodzica()" />
                    <INOUT_KALKULATOR @bind-WynikFloat="Model.WspolczynnikPrzepuszczalnosciCieplaSzyby" _sizeButton="Large" Naglowek="Uw szyby" />
                </div>

                <div style="display: flex; align-items: center; gap: 5px; margin-bottom: 10px;">
                    <label style="width: 150px;">Uw okna</label>
                    <AntDesign.InputNumber @bind-Value="Model.WspolczynnikPrzepuszczalnosciCieplaOkna"
                                           Style="flex: 1;"
                                           OnChange="async (float value) => await ZapiszDoRodzica()" />
                    <INOUT_KALKULATOR @bind-WynikFloat="Model.WspolczynnikPrzepuszczalnosciCieplaOkna" _sizeButton="Large" Naglowek="Uw okna" />
                </div>
            </AntDesign.TabPane>

        </AntDesign.Tabs>
    </EditForm>

    @* ═══════════════════════════════════════════════════════════ *@
    @* MODAL KALKULATORA — POZA EditForm i POZA Tabs               *@
    @* ═══════════════════════════════════════════════════════════ *@
    @if (_calculatorVisible)
    {
        <AntDesign.Modal Title="Kalkulator"
                         Visible="true"
                         OnOk="@HandleCalculatorOk"
                         OnCancel="@HandleCalculatorCancel"
                         Width="350">
            <div style="padding: 10px;">
                <div style="background-color: #f0f0f0; padding: 10px; margin-bottom: 10px; text-align: right; font-size: 20px; font-weight: bold; border: 1px solid #d9d9d9; border-radius: 4px; min-height: 40px;">
                    @(_calculatorExpression.Length > 0 ? _calculatorExpression : "0")
                </div>

                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px;">
                    <AntDesign.Button OnClick="@(() => AppendToCalculator("7"))" Block>7</AntDesign.Button>
                    <AntDesign.Button OnClick="@(() => AppendToCalculator("8"))" Block>8</AntDesign.Button>
                    <AntDesign.Button OnClick="@(() => AppendToCalculator("9"))" Block>9</AntDesign.Button>
                    <AntDesign.Button OnClick="@(() => AppendToCalculator("/"))" Type="@ButtonType.Primary" Block>÷</AntDesign.Button>

                    <AntDesign.Button OnClick="@(() => AppendToCalculator("4"))" Block>4</AntDesign.Button>
                    <AntDesign.Button OnClick="@(() => AppendToCalculator("5"))" Block>5</AntDesign.Button>
                    <AntDesign.Button OnClick="@(() => AppendToCalculator("6"))" Block>6</AntDesign.Button>
                    <AntDesign.Button OnClick="@(() => AppendToCalculator("*"))" Type="@ButtonType.Primary" Block>×</AntDesign.Button>

                    <AntDesign.Button OnClick="@(() => AppendToCalculator("1"))" Block>1</AntDesign.Button>
                    <AntDesign.Button OnClick="@(() => AppendToCalculator("2"))" Block>2</AntDesign.Button>
                    <AntDesign.Button OnClick="@(() => AppendToCalculator("3"))" Block>3</AntDesign.Button>
                    <AntDesign.Button OnClick="@(() => AppendToCalculator("-"))" Type="@ButtonType.Primary" Block>−</AntDesign.Button>

                    <AntDesign.Button OnClick="@(() => AppendToCalculator("0"))" Block>0</AntDesign.Button>
                    <AntDesign.Button OnClick="@(() => AppendToCalculator("."))" Block>.</AntDesign.Button>
                    <AntDesign.Button OnClick="@CalculateResult" Type="@ButtonType.Primary"
                                      Style="background-color: #52c41a; border-color: #52c41a;" Block>=</AntDesign.Button>
                    <AntDesign.Button OnClick="@(() => AppendToCalculator("+"))" Type="@ButtonType.Primary" Block>+</AntDesign.Button>

                    <AntDesign.Button OnClick="@ClearCalculator" Type="@ButtonType.Primary" Block>C</AntDesign.Button>
                    <AntDesign.Button OnClick="@BackspaceCalculator" Block>⌫</AntDesign.Button>
                    <AntDesign.Button OnClick="@(() => AppendToCalculator("("))" Block>(</AntDesign.Button>
                    <AntDesign.Button OnClick="@(() => AppendToCalculator(")"))" Block>)</AntDesign.Button>
                </div>

                <div style="display: flex; gap: 5px; margin-top: 10px;">
                    <AntDesign.Button OnClick="@UseCurrentValue" Type="@ButtonType.Default" Block>
                        Użyj bieżącej wartości
                    </AntDesign.Button>
                    <AntDesign.Button OnClick="@ClearCalculator" Type="@ButtonType.Default" Block>
                        Wyczyść
                    </AntDesign.Button>
                </div>
            </div>
        </AntDesign.Modal>
    }
}

@code {
    [Parameter]
    public ConstWlasciwosciOkna? Model { get; set; }

    [Parameter]
    public EventCallback<ConstWlasciwosciOkna> OnSave { get; set; }

    private bool jestZmianaGabarytow = false;

    public async Task ZapiszDoRodzica()
    {
        await OnSave.InvokeAsync(Model);
    }

    private bool _calculatorVisible = false;
    private string _calculatorExpression = "";
    private int _currentEditingIndex = -1;

    private void ShowCalculator(int index)
    {
        _currentEditingIndex = index;
        _calculatorExpression = Model?.GetPropertyValue(index).ToString() ?? "";
        _calculatorVisible = true;
    }

    // ═══════════════════════════════════════════════════════════════
    //  HANDLER: zmiana właściwości linii PIONOWEJ
    //  Reguła: zmiana X pionowej → tylko ta pionowa się rusza
    //          zmiana Y1/Y2 pionowej → pionowa przyciąga się do najbliższej poziomej
    // ═══════════════════════════════════════════════════════════════
    private async Task HandleLiniaPionowaChange(int index, double value)
    {
        if (Model == null) return;

        var prop = Model.EditableProperties[index];
        var lbl = prop.Label?.ToLower() ?? "";
        bool czyX = lbl.StartsWith("x1") || lbl.StartsWith("x2");

        Model.UpdateEditableProperty(index, value);

        Console.WriteLine($"🔵 HandleLiniaPionowaChange: index={index}, label='{prop.Label}', value={value}, czyX: {czyX}");
        Console.WriteLine($"🔵 HandleLiniaPionowaChange: lbl: {lbl}");

        // ⭐ Jeśli edytowano X pionowej i jest konflikt SplitGroupId z inną pionową
        //    o innym X — rozdziel grupy
        if (czyX && !string.IsNullOrEmpty(prop.SplitGroupId))
        {
            RozdzielKonfliktGrupPionowych(prop.SplitGroupId!);
        }

        StateHasChanged();
        await Task.CompletedTask;
    }

    private void RozdzielKonfliktGrupPionowych(string groupId)
    {
        Console.WriteLine($"⚠️ RozdzielKonfliktGrupPionowych: próba rozdzielenia grupy {groupId}");
        // Znajdź wszystkie pionowe w tej grupie (właściwości)
        var pionoweWgrupie = Model!.EditableProperties
            .Select((p, i) => (Index: i, Prop: p))
            .Where(x => x.Prop.SplitGroupId == groupId && x.Prop.IsPionowa)
            .GroupBy(x => x.Prop.ShapeId)
            .ToList();

        if (pionoweWgrupie.Count <= 1) return;

        Console.WriteLine($"⚠️ RozdzielKonfliktGrupPionowych: grupa {groupId} ma {pionoweWgrupie.Count} różnych pionowych");

        // ⭐ 1. Zaktualizuj EditableProperties
        var mapaShapeIdNaNowyGroupId = new Dictionary<string, string>();

        foreach (var g in pionoweWgrupie)
        {
            var noweGroupId = Guid.NewGuid().ToString();
            mapaShapeIdNaNowyGroupId[g.Key!] = noweGroupId;

            foreach (var (i, p) in g)
            {
                p.SplitGroupId = noweGroupId;
            }

            Console.WriteLine($"   → ShapeId {g.Key?.Substring(0, 8)} dostał nowy SplitGroupId={noweGroupId.Substring(0, 8)}");
        }

        // ⭐ 2. Zaktualizuj ShapeService.Shapes — to jest KLUCZOWE!
        if (ShapeService?.Shapes != null)
        {
            foreach (var line in ShapeService.Shapes.OfType<XLineShape>())
            {
                if (line.ID != null && mapaShapeIdNaNowyGroupId.TryGetValue(line.ID, out var nowyGroupId))
                {
                    line.SplitGroupId = nowyGroupId;
                    Console.WriteLine($"   🔧 Shape {line.ID.Substring(0, 8)}: SplitGroupId → {nowyGroupId.Substring(0, 8)}");
                }
            }
        }
    }

    // ═══════════════════════════════════════════════════════════════
    //  HANDLER: zmiana właściwości linii POZIOMEJ
    //  Reguła: zmiana Y poziomej → automatycznie dopasuj końce pionowych stycznych
    //          zmiana X poziomej (jeśli w ogóle) → nic
    // ═══════════════════════════════════════════════════════════════
    private async Task HandleLiniaPoziomaChange(int index, double value)
    {
        if (Model == null || index < 0 || index >= Model.EditableProperties.Count)
            return;

        var prop = Model.EditableProperties[index];
        var lbl = prop.Label?.ToLower() ?? "";

        Console.WriteLine($"🟢 HandleLiniaPoziomaChange: index={index}, label='{prop.Label}', value={value}");

        // 1. Zapisz wartość
        Model.UpdateEditableProperty(index, value);

        // 2. Rozpoznaj którą właściwość edytowano
        bool czyY = lbl.StartsWith("y1") || lbl.StartsWith("y2") ||
                    lbl.Contains("w osi y1") || lbl.Contains("w osi y2");

        if (czyY)
        {
            // ⭐ KLUCZOWE: propaguj styczność — pionowe końce dopasuj do poziomych
            await PropagujStycznoscPionowychDoPoziomychAsync();
        }

        StateHasChanged();
    }

    // ═══════════════════════════════════════════════════════════════
    //  HANDLER: zmiana właściwości linii SKOŚNEJ
    // ═══════════════════════════════════════════════════════════════
    private async Task HandleLiniaSkosnaChange(int index, double value)
    {
        if (Model == null || index < 0 || index >= Model.EditableProperties.Count)
            return;

        Model.UpdateEditableProperty(index, value);

        Console.WriteLine($"🟠 HandleLiniaSkosnaChange: index={index}, value={value}");

        // Skośne — brak automatycznej propagacji (użytkownik edytuje ręcznie)
        StateHasChanged();
        await Task.CompletedTask;
    }

    // ═══════════════════════════════════════════════════════════════
    //  PROPAGACJA STYCZNOŚCI — pionowe końce dopasuj do poziomych
    // ═══════════════════════════════════════════════════════════════
    private async Task PropagujStycznoscPionowychDoPoziomychAsync()
    {
        if (Model == null) return;

        // Zbierz Y wszystkich poziomych
        var pozycjePoziome = new List<double>();

        var liniePoziome = Model.EditableProperties
            .Select((p, i) => (Index: i, Prop: p))
            .Where(x => x.Prop.IsPozioma &&
                        (x.Prop.Label?.ToLower().StartsWith("y1") == true ||
                         x.Prop.Label?.ToLower().Contains("w osi y1") == true))
            .Select(x => Model.GetPropertyValue(x.Index))
            .ToList();

        pozycjePoziome.AddRange(liniePoziome);

        // Granice: 0, Y poziomych, Wysokosc
        var wszystkieGraniceY = new List<double> { 0 };
        wszystkieGraniceY.AddRange(pozycjePoziome);
        wszystkieGraniceY.Add(Model.Wysokosc);
        wszystkieGraniceY = wszystkieGraniceY
            .Distinct()
            .OrderBy(y => y)
            .ToList();

        Console.WriteLine($"📐 PropagujStycznosc: granice Y = [{string.Join(", ", wszystkieGraniceY.Select(g => g.ToString("F0")))}]");

        // Znajdź wszystkie pionowe (grupy)
        var grupyPionowe = Model.EditableProperties
            .Select((p, i) => (Index: i, Prop: p))
            .Where(x => x.Prop.IsPionowa)
            .GroupBy(x => x.Prop.SplitGroupId ?? x.Prop.ShapeId)
            .ToList();

        foreach (var grupa in grupyPionowe)
        {
            string gid = grupa.Key ?? "";

            // Pobierz aktualne Y1, Y2 pionowej
            var y1Prop = grupa.FirstOrDefault(x =>
                x.Prop.Label?.ToLower().StartsWith("y1") == true ||
                x.Prop.Label?.ToLower().Contains("w osi y1") == true);

            var y2Prop = grupa.FirstOrDefault(x =>
                x.Prop.Label?.ToLower().StartsWith("y2") == true ||
                x.Prop.Label?.ToLower().Contains("w osi y2") == true);

            if (y1Prop.Prop == null || y2Prop.Prop == null)
            {
                Console.WriteLine($"   ⏭️ Pionowa {gid}: brak Y1/Y2 — pomijam");
                continue;
            }

            double y1Akt = Model.GetPropertyValue(y1Prop.Index);
            double y2Akt = Model.GetPropertyValue(y2Prop.Index);

            // Znajdź nowe granice
            double noweY1 = ZnajdzNajblizszaGranice(wszystkieGraniceY, y1Akt, "dolna");
            double noweY2 = ZnajdzNajblizszaGranice(wszystkieGraniceY, y2Akt, "gorna");

            if (noweY1 >= noweY2)
            {
                Console.WriteLine($"   ⚠️ Pionowa {gid}: noweY1({noweY1:F0}) >= noweY2({noweY2:F0}) — pomijam");
                continue;
            }

            Console.WriteLine($"   📏 Pionowa {gid}: Y [{y1Akt:F0},{y2Akt:F0}] → [{noweY1:F0},{noweY2:F0}]");

            Model.UpdateEditableProperty(y1Prop.Index, noweY1);
            Model.UpdateEditableProperty(y2Prop.Index, noweY2);
        }

        await Task.CompletedTask;
    }

    // ═══════════════════════════════════════════════════════════════
    //  PRZYCIĄGNIJ PIONOWĄ DO POZIOMEJ (ręczna zmiana Y pionowej)
    // ═══════════════════════════════════════════════════════════════
    private async Task PrzyciagnijPionowaDoPoziomej(string? groupId)
    {
        if (Model == null || string.IsNullOrEmpty(groupId)) return;

        // Zbierz Y wszystkich poziomych + granice okna
        var granice = new List<double> { 0 };
        granice.AddRange(
            Model.EditableProperties
                .Where(p => p.IsPozioma &&
                            (p.Label?.ToLower().StartsWith("y1") == true ||
                             p.Label?.ToLower().Contains("w osi y1") == true))
                .Select(p => p.Value));
        granice.Add(Model.Wysokosc);
        granice = granice.Distinct().OrderBy(y => y).ToList();

        // Znajdź Y1/Y2 tej pionowej
        var pionoweProps = Model.EditableProperties
            .Select((p, i) => (Index: i, Prop: p))
            .Where(x => (x.Prop.SplitGroupId ?? x.Prop.ShapeId) == groupId &&
                        x.Prop.IsPionowa)
            .ToList();

        var y1 = pionoweProps.FirstOrDefault(x =>
            x.Prop.Label?.ToLower().StartsWith("y1") == true);
        var y2 = pionoweProps.FirstOrDefault(x =>
            x.Prop.Label?.ToLower().StartsWith("y2") == true);

        if (y1.Prop == null || y2.Prop == null) return;

        double y1v = Model.GetPropertyValue(y1.Index);
        double y2v = Model.GetPropertyValue(y2.Index);

        // Przyciągnij
        double newY1 = ZnajdzNajblizszaGranice(granice, y1v, "dolna");
        double newY2 = ZnajdzNajblizszaGranice(granice, y2v, "gorna");

        if (newY1 < newY2)
        {
            Model.UpdateEditableProperty(y1.Index, newY1);
            Model.UpdateEditableProperty(y2.Index, newY2);
            Console.WriteLine($"   🧲 Przyciągnięto pionową {groupId}: Y → [{newY1:F0},{newY2:F0}]");
        }

        await Task.CompletedTask;
    }

    // ═══════════════════════════════════════════════════════════════
    //  POMOCNICZA: najbliższa granica Y
    // ═══════════════════════════════════════════════════════════════
    private double ZnajdzNajblizszaGranice(List<double> granice, double y, string preferencja)
    {
        if (granice == null || granice.Count == 0)
            return y;

        if (preferencja == "dolna")
        {
            var kandydaci = granice.Where(g => g <= y + 0.5).ToList();
            return kandydaci.Any() ? kandydaci.Max() : granice.Min();
        }
        else
        {
            var kandydaci = granice.Where(g => g >= y - 0.5).ToList();
            return kandydaci.Any() ? kandydaci.Min() : granice.Max();
        }
    }

    // ═══════════════════════════════════════════════════════════════
    //  PODZIEL LINIE SYMETRYCZNIE — wersja poprawiona
    // ═══════════════════════════════════════════════════════════════

    /// <summary>
    /// Rozstawia linie symetrycznie.
    ///
    /// WAŻNE: grupowanie robimy po SplitGroupId ?? ShapeId, ale TYLKO w obrębie
    /// tej samej orientacji (pionowe osobno, poziome osobno). Grupa która zawiera
    /// i pionowe i poziome jest traktowana jako błąd i logowana.
    ///
    /// Po rozstawieniu linii wywołujemy propagację styczności (Y pionowych
    /// dopasowuje się do najbliższej poziomej, z którą się styka).
    /// </summary>
    private async Task PodzielLinieSymetrycznieAsync(
        bool ustawTylkoLinie = false,
        bool pionowe = true,
        bool poziome = true,
        bool rozciagnijLinie = false)
    {
        if (Model?.EditableProperties == null || Model.EditableProperties.Count == 0)
            return;

        // Rozstawianie ma zmieniać wyłącznie położenie na osi. Zapamiętujemy
        // rzeczywiste zakresy pionowych odcinków po ID, ponieważ SplitGroupId
        // może obejmować więcej niż jeden odcinek i późniejsza synchronizacja
        // grupy potrafiła zastąpić ich Y1/Y2 zakresem całej ramy.
        var zakresyPionowePrzedRozstawieniem = !rozciagnijLinie
            ? ShapeService.Shapes.OfType<XLineShape>()
                .Where(l => Math.Abs(l.X1 - l.X2) < 0.001)
                .ToDictionary(l => l.ID, l => (l.Y1, l.Y2))
            : new Dictionary<string, (double Y1, double Y2)>();

        Console.WriteLine($"📐 PodzielLinie: START, Szerokosc={Model.Szerokosc}, Wysokosc={Model.Wysokosc}");

        // ─────────────────────────────────────────────────────────────
        // 1. Zbuduj grupy właściwości – każda grupa = jedna linia logiczna
        // ─────────────────────────────────────────────────────────────
        var grupyWlasciwosci = Model.EditableProperties
            .Select((p, i) => (Index: i, Prop: p))
            .Where(x => x.Prop.ShapeId != null && !string.IsNullOrEmpty(x.Prop.NazwaObiektu))
            .GroupBy(x => x.Prop.SplitGroupId ?? x.Prop.ShapeId)
            .ToList();

        // ─────────────────────────────────────────────────────────────
        // 2. Rozdziel grupy po orientacji — NIE mieszamy pionowych z poziomymi
        // ─────────────────────────────────────────────────────────────
        var grupyPionowe = new List<(List<int> IndexesX1, List<int> IndexesX2, string GroupId)>();
        var grupyPoziome = new List<(List<int> IndexesY1, List<int> IndexesY2, string GroupId)>();

        foreach (var grupa in grupyWlasciwosci)
        {
            bool maPionowa = grupa.Any(g => g.Prop.IsPionowa);
            bool maPozioma = grupa.Any(g => g.Prop.IsPozioma);

            // ⚠️ Grupa mieszana — to błąd, ale logujemy i próbujemy uratować
            //    traktując ją jako DWIE osobne logiczne linie.
            if (maPionowa && maPozioma)
            {
                Console.WriteLine($"⚠️ Grupa MIESZANA klucz='{grupa.Key}' — rozbijam na pionową i poziomą");
            }

            // Zbierz X1/X2 z części pionowej
            var x1Props = grupa
                .Where(g => g.Prop.IsPionowa &&
                    (g.Prop.Label?.ToLower().StartsWith("x1") == true ||
                     g.Prop.Label?.ToLower().Contains("w osi x1") == true))
                .Select(g => g.Index).ToList();

            var x2Props = grupa
                .Where(g => g.Prop.IsPionowa &&
                    (g.Prop.Label?.ToLower().StartsWith("x2") == true ||
                     g.Prop.Label?.ToLower().Contains("w osi x2") == true))
                .Select(g => g.Index).ToList();

            // Zbierz Y1/Y2 z części poziomej
            var y1Props = grupa
                .Where(g => g.Prop.IsPozioma &&
                    (g.Prop.Label?.ToLower().StartsWith("y1") == true ||
                     g.Prop.Label?.ToLower().Contains("w osi y1") == true))
                .Select(g => g.Index).ToList();

            var y2Props = grupa
                .Where(g => g.Prop.IsPozioma &&
                    (g.Prop.Label?.ToLower().StartsWith("y2") == true ||
                     g.Prop.Label?.ToLower().Contains("w osi y2") == true))
                .Select(g => g.Index).ToList();

            // ⚠️ KLUCZ: dodajemy do listy TYLKO jeśli grupa ma odpowiednią orientację
            //    i NIE jest grupą mieszaną (albo — jeśli mieszana — dodajemy do obu list)
            if (x1Props.Any() && (!maPozioma || maPionowa))
            {
                grupyPionowe.Add((x1Props, x2Props, grupa.Key!));
            }

            if (y1Props.Any() && (!maPionowa || maPozioma))
            {
                grupyPoziome.Add((y1Props, y2Props, grupa.Key!));
            }
        }

        Console.WriteLine($"📐 PodzielLinie: pionowe={grupyPionowe.Count}, poziome={grupyPoziome.Count}");

        // ─────────────────────────────────────────────────────────────
        // 3. Rozstaw PIONOWE symetrycznie (X równo rozłożone w szerokości)
        //    ⭐ SORTUJ grupy po aktualnym X żeby nie zamieniać kolejności
        // ─────────────────────────────────────────────────────────────
        if (pionowe && grupyPionowe.Count > 0 && Model.Szerokosc > 0)
        {
            double odstep = Model.Szerokosc / (grupyPionowe.Count + 1);

            // ⭐ Sortuj grupy po aktualnym X (rosnąco — od lewej do prawej)
            var grupyPionowePosortowane = grupyPionowe
                .OrderBy(g => Model.GetPropertyValue(g.IndexesX1[0]))
                .ToList();

            Console.WriteLine($"📐 PION — sortowanie grup po X (od lewej do prawej):");
            for (int k = 0; k < grupyPionowePosortowane.Count; k++)
            {
                var g = grupyPionowePosortowane[k];
                double aktX = Model.GetPropertyValue(g.IndexesX1[0]);
                Console.WriteLine($"   [{k}] grupa={g.GroupId.Substring(0, Math.Min(8, g.GroupId.Length))} " +
                                  $"aktualne X={aktX:F1} → nowe X={Math.Round(odstep * (k + 1), 0):F1}");
            }

            for (int i = 0; i < grupyPionowePosortowane.Count; i++)
            {
                double nowaPozycjaX = Math.Round(odstep * (i + 1), 0);
                var (indexesX1, indexesX2, groupId) = grupyPionowePosortowane[i];

                double aktX = Model.GetPropertyValue(indexesX1[0]);
                Console.WriteLine($"📐 PION grupa={groupId.Substring(0, Math.Min(8, groupId.Length))}: " +
                                  $"X {aktX:F1} → {nowaPozycjaX}");

                foreach (var idx in indexesX1)
                    Model.UpdateEditableProperty(idx, nowaPozycjaX);

                foreach (var idx in indexesX2)
                    Model.UpdateEditableProperty(idx, nowaPozycjaX);
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 4. Rozstaw POZIOME symetrycznie (Y równo rozłożone w wysokości)
        //    ⭐ SORTUJ grupy po aktualnym Y żeby nie zamieniać kolejności
        // ─────────────────────────────────────────────────────────────
        if (poziome && grupyPoziome.Count > 0 && Model.Wysokosc > 0)
        {
            double odstep = Model.Wysokosc / (grupyPoziome.Count + 1);

            // ⭐ Sortuj grupy po aktualnym Y (rosnąco — od góry do dołu)
            var grupyPoziomePosortowane = grupyPoziome
                .OrderBy(g => Model.GetPropertyValue(g.IndexesY1[0]))
                .ToList();

            Console.WriteLine($"📐 POZ — sortowanie grup po Y (od góry do dołu):");
            for (int k = 0; k < grupyPoziomePosortowane.Count; k++)
            {
                var g = grupyPoziomePosortowane[k];
                double aktY = Model.GetPropertyValue(g.IndexesY1[0]);
                Console.WriteLine($"   [{k}] grupa={g.GroupId.Substring(0, Math.Min(8, g.GroupId.Length))} " +
                                  $"aktualne Y={aktY:F1} → nowe Y={Math.Round(odstep * (k + 1), 0):F1}");
            }

            for (int i = 0; i < grupyPoziomePosortowane.Count; i++)
            {
                double nowaPozycjaY = Math.Round(odstep * (i + 1), 0);
                var (indexesY1, indexesY2, groupId) = grupyPoziomePosortowane[i];

                double aktY = Model.GetPropertyValue(indexesY1[0]);
                Console.WriteLine($"📐 POZ grupa={groupId.Substring(0, Math.Min(8, groupId.Length))}: " +
                                  $"Y {aktY:F1} → {nowaPozycjaY}");

                foreach (var idx in indexesY1)
                    Model.UpdateEditableProperty(idx, nowaPozycjaY);

                foreach (var idx in indexesY2)
                    Model.UpdateEditableProperty(idx, nowaPozycjaY);
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 5. Styczność zmieniamy tylko w trybie jawnego rozciągania.
        // Zwykłe „Rozstaw pionowe/poziome” ma zmienić wyłącznie pozycję
        // na osi, bez zamiany krótkich odcinków w linie na całą wysokość.
        // ─────────────────────────────────────────────────────────────
        if (rozciagnijLinie)
        {
            PropagujStycznoscPionowychDoPoziomych(
                grupyPionowe,
                grupyPoziome);
        }

        // ─────────────────────────────────────────────────────────────
        // 6. Napraw zdegenerowane linie (punkty → odcinki)
        // ─────────────────────────────────────────────────────────────
        NaprawZdegenerowaneLinie(ShapeService.Shapes, Model.Szerokosc, Model.Wysokosc);

        if (rozciagnijLinie)
        {
            Console.WriteLine("📐 PodzielLinie: rozciągam linie do shapes (zmiana wymiarów)");

            await LineUtils.ExtendOrShortenLinesWithTangencyAsync(ShapeService.Shapes, 0.5);
            await LineUtils.ShortenLinesInsideShapes(ShapeService.Shapes, 1);
        }

        if (!rozciagnijLinie)
        {
            foreach (var line in ShapeService.Shapes.OfType<XLineShape>())
            {
                if (!zakresyPionowePrzedRozstawieniem.TryGetValue(line.ID, out var zakres))
                    continue;

                // Najpierw przywróć wartości modelu, aby zapis do rodzica nie
                // odtworzył błędnego zakresu z całej ramy.
                foreach (var (index, prop) in Model.EditableProperties.Select((p, i) => (i, p))
                    .Where(x => x.p.ShapeId == line.ID && x.p.IsPionowa))
                {
                    var label = prop.Label?.ToLowerInvariant() ?? string.Empty;
                    if (label.StartsWith("y1") || label.Contains("w osi y1"))
                        Model.UpdateEditableProperty(index, zakres.Y1);
                    else if (label.StartsWith("y2") || label.Contains("w osi y2"))
                        Model.UpdateEditableProperty(index, zakres.Y2);
                }

                // Setter właściwości może zmodyfikować line w trakcie pętli;
                // końcowe UpdatePoints jest źródłem prawdy dla canvasa.
                line.UpdatePoints(new List<XPoint>
                {
                    new(line.X1, zakres.Y1),
                    new(line.X2, zakres.Y2)
                });
            }
        }

        if (!ustawTylkoLinie)
            await ZapiszDoRodzica();
    }

    // ═══════════════════════════════════════════════════════════════
    //  PROPAGACJA STYCZNOŚCI
    //  Dla każdej pionowej:
    //    - Y1 dopasuj do najbliższej poziomej, która jest powyżej / na Y1
    //    - Y2 dopasuj do najbliższej poziomej, która jest poniżej / na Y2
    // ═══════════════════════════════════════════════════════════════
    private void PropagujStycznoscPionowychDoPoziomych(
        List<(List<int> IndexesX1, List<int> IndexesX2, string GroupId)> grupyPionowe,
        List<(List<int> IndexesY1, List<int> IndexesY2, string GroupId)> grupyPoziome)
    {
        if (grupyPionowe.Count == 0 || grupyPoziome.Count == 0)
        {
            Console.WriteLine("📐 PropagujStycznosc: brak pionowych lub poziomych — pomijam");
            return;
        }

        // Zbierz aktualne Y wszystkich poziomych (jako lista dostępnych granic)
        // Każda grupa pozioma ma konkretne Y1=Y2 (linia pozioma).
        var pozycjePoziome = new List<double>();
        foreach (var (y1Idxs, y2Idxs, gid) in grupyPoziome)
        {
            double y = 0;
            if (y1Idxs.Any())
                y = Model!.GetPropertyValue(y1Idxs[0]);

            pozycjePoziome.Add(y);
        }
        pozycjePoziome = pozycjePoziome.Distinct().OrderBy(y => y).ToList();

        Console.WriteLine($"📐 PropagujStycznosc: Y poziomych = [{string.Join(", ", pozycjePoziome.Select(p => p.ToString("F0")))}]");

        // Dodaj granice okna: 0 i Wysokosc — pionowe zawsze muszą dochodzić do krawędzi okna
        var wszystkieGraniceY = new List<double> { 0 };
        wszystkieGraniceY.AddRange(pozycjePoziome);
        wszystkieGraniceY.Add(Model!.Wysokosc);
        wszystkieGraniceY = wszystkieGraniceY.Distinct().OrderBy(y => y).ToList();

        // Dla każdej pionowej: znajdź przedział, w którym się znajduje
        foreach (var (x1Idxs, x2Idxs, gid) in grupyPionowe)
        {
            if (!x1Idxs.Any())
                continue;

            // Aktualna pozycja X pionowej
            double xPion = Model!.GetPropertyValue(x1Idxs[0]);

            // Aktualne Y pionowej (przed propagacją)
            // Trzeba znaleźć właściwości Y1/Y2 dla tej grupy — ale w grupyPionowe
            // trzymamy tylko indeksy X1/X2, więc musimy zajrzeć do Model
            double y1Aktual = ZnajdzY1DlaGrupy(gid);
            double y2Aktual = ZnajdzY2DlaGrupy(gid);

            Console.WriteLine($"📐 Pionowa {gid}: aktualne Y=[{y1Aktual:F0}, {y2Aktual:F0}]");

            // ⭐ Znajdź nowe granice: najbliższa granica <= y1Aktual i najbliższa >= y2Aktual
            double noweY1 = ZnajdzNajblizszaGranice(wszystkieGraniceY, y1Aktual, preferencja: "dolna");
            double noweY2 = ZnajdzNajblizszaGranice(wszystkieGraniceY, y2Aktual, preferencja: "gorna");

            // Zabezpieczenie — Y1 nie może być większe od Y2
            if (noweY1 >= noweY2)
            {
                Console.WriteLine($"⚠️ Pionowa {gid}: noweY1 ({noweY1:F0}) >= noweY2 ({noweY2:F0}) — pomijam");
                continue;
            }

            Console.WriteLine($"📐 Pionowa {gid}: nowe Y=[{noweY1:F0}, {noweY2:F0}]");

            // Zaktualizuj Y1 i Y2 dla tej konkretnej grupy pionowej
            UstawY1DlaGrupy(gid, noweY1);
            UstawY2DlaGrupy(gid, noweY2);
        }
    }

    // ═══════════════════════════════════════════════════════════════
    //  POMOCNICZE — wyszukiwanie Y1/Y2 i ustawianie w Model
    // ═══════════════════════════════════════════════════════════════
    private double ZnajdzY1DlaGrupy(string groupId)
    {
        var y1Prop = Model!.EditableProperties
            .Select((p, i) => (Index: i, Prop: p))
            .FirstOrDefault(x =>
                (x.Prop.SplitGroupId ?? x.Prop.ShapeId) == groupId &&
                x.Prop.IsPionowa &&
                (x.Prop.Label?.ToLower().StartsWith("y1") == true ||
                 x.Prop.Label?.ToLower().Contains("w osi y1") == true));

        return y1Prop.Prop != null ? Model.GetPropertyValue(y1Prop.Index) : 0;
    }

    private double ZnajdzY2DlaGrupy(string groupId)
    {
        var y2Prop = Model!.EditableProperties
            .Select((p, i) => (Index: i, Prop: p))
            .FirstOrDefault(x =>
                (x.Prop.SplitGroupId ?? x.Prop.ShapeId) == groupId &&
                x.Prop.IsPionowa &&
                (x.Prop.Label?.ToLower().StartsWith("y2") == true ||
                 x.Prop.Label?.ToLower().Contains("w osi y2") == true));

        return y2Prop.Prop != null ? Model.GetPropertyValue(y2Prop.Index) : 0;
    }

    private void UstawY1DlaGrupy(string groupId, double y)
    {
        var y1Props = Model!.EditableProperties
            .Select((p, i) => (Index: i, Prop: p))
            .Where(x =>
                (x.Prop.SplitGroupId ?? x.Prop.ShapeId) == groupId &&
                x.Prop.IsPionowa &&
                (x.Prop.Label?.ToLower().StartsWith("y1") == true ||
                 x.Prop.Label?.ToLower().Contains("w osi y1") == true))
            .Select(x => x.Index)
            .ToList();

        foreach (var idx in y1Props)
            Model.UpdateEditableProperty(idx, y);
    }

    private void UstawY2DlaGrupy(string groupId, double y)
    {
        var y2Props = Model!.EditableProperties
            .Select((p, i) => (Index: i, Prop: p))
            .Where(x =>
                (x.Prop.SplitGroupId ?? x.Prop.ShapeId) == groupId &&
                x.Prop.IsPionowa &&
                (x.Prop.Label?.ToLower().StartsWith("y2") == true ||
                 x.Prop.Label?.ToLower().Contains("w osi y2") == true))
            .Select(x => x.Index)
            .ToList();

        foreach (var idx in y2Props)
            Model.UpdateEditableProperty(idx, y);
    }

    private static void NaprawZdegenerowaneLinie(
        List<IShapeDC> shapes, double szerokosc, double wysokosc)
    {
        var linie = shapes.OfType<XLineShape>().ToList();

        // ⭐ Znajdź linie poziome (Y wewnątrz okna, nie na krawędziach)
        var liniePoziomeY = linie
            .Where(l => Math.Abs(l.Y1 - l.Y2) < 0.001)               // pozioma
            .Where(l => l.Y1 > 0.5 && l.Y1 < wysokosc - 0.5)         // nie na krawędziach
            .Select(l => l.Y1)
            .Distinct()
            .OrderBy(y => y)
            .ToList();

        // ⭐ Zbierz granice: 0, linie poziome, wysokosc
        var granice = new List<double> { 0 };

        // ⭐ Usuń duplikaty z tolerancją
        granice = granice
            .OrderBy(y => y)
            .Aggregate(new List<double>(), (acc, y) =>
            {
                if (acc.Count == 0 || Math.Abs(acc.Last() - y) > 0.5)
                    acc.Add(y);
                return acc;
            });

        granice.AddRange(liniePoziomeY);
        granice.Add(wysokosc);
        granice = granice.Distinct().OrderBy(y => y).ToList();

        Console.WriteLine($"🔧 NaprawZdegenerowaneLinie: granice Y = [{string.Join(", ", granice.Select(g => g.ToString("F0")))}]");

        // ⭐ Grupuj punkty-pionowe po X
        var punktyPionowe = linie
            .Where(l => Math.Abs(l.X1 - l.X2) < 0.001 &&
                        Math.Abs(l.Y1 - l.Y2) < 0.001)               // punkt
            .Where(l => l.StalySlupek || l.RuchomySlupek || l.DualRama)
            .GroupBy(l => Math.Round(l.X1, 0))
            .ToList();

        foreach (var grupaX in punktyPionowe)
        {
            // ⭐ Sortuj punkty w grupie po Y (od góry do dołu)
            var punkty = grupaX.OrderBy(l => l.Y1).ToList();

            Console.WriteLine($"🔧 Grupa X={grupaX.Key:F0}: {punkty.Count} punktów, " +
                              $"przedziały={granice.Count - 1}");

            // ⭐ KLUCZOWE: przypisz kolejne przedziały do kolejnych punktów
            for (int i = 0; i < punkty.Count; i++)
            {
                var line = punkty[i];

                double yStart, yEnd;

                if (i < granice.Count - 1)
                {
                    // ⭐ Punkt i-ty → przedział i-ty
                    yStart = granice[i];
                    yEnd = granice[i + 1];
                }
                else
                {
                    // Więcej punktów niż przedziałów – ostatni przedział
                    yStart = granice[granice.Count - 2];
                    yEnd = granice[granice.Count - 1];
                }

                // ⭐ Zabezpieczenie przed zerową długością
                if (Math.Abs(yEnd - yStart) < 0.5)
                {
                    Console.WriteLine($"⚠️ NaprawZdegenerowaneLinie: przedział zerowy dla punktu Y={line.Y1:F0}. Pomijam.");
                    continue;
                }

                line.X2 = line.X1;
                line.Y1 = yStart;
                line.Y2 = yEnd;

                Console.WriteLine($"🔧 Naprawa pionowej {line.ID.Substring(0, 8)}: " +
                                  $"({line.X1:F0},{line.Y1:F0})→({line.X2:F0},{line.Y2:F0})");
            }
        }
    }

    // ═══════════════════════════════════════════════════════════════
    //  USUŃ Linię — wyszukiwanie po indeksie właściwości
    //  (analogicznie do HandleLiniaPionowaChange(index, value))
    //
    //  1. Bierze właściwość o `index`
    //  2. Wyznacza jej grupę: (SplitGroupId ?? ShapeId) — czyli CAŁĄ linię
    //  3. Usuwa XLineShape z ShapeService.Shapes
    //  4. Usuwa wszystkie właściwości tej grupy z Model.EditableProperties
    // ═══════════════════════════════════════════════════════════════
    private async Task UsunLinie(int index)
    {
        if (Model?.EditableProperties == null
            || index < 0
            || index >= Model.EditableProperties.Count)
            return;

        var prop = Model.EditableProperties[index];

        string? groupId = prop.SplitGroupId ?? prop.ShapeId;
        string? shapeId = prop.ShapeId;

        if (string.IsNullOrEmpty(groupId))
        {
            Console.WriteLine($"⚠️ UsunLinie: brak GroupId/ShapeId dla index={index}");
            return;
        }

        Console.WriteLine($"🗑️ UsunLinie(index={index}): label='{prop.Label}', " +
                          $"groupId={groupId}, shapeId={shapeId}");

        // 1) usuń kształt z ShapeService
        if (!string.IsNullOrEmpty(shapeId) && ShapeService?.Shapes != null)
        {
            var shape = ShapeService.Shapes.FirstOrDefault(s => s.ID == shapeId);
            if (shape != null)
            {
                ShapeService.Shapes.Remove(shape);
                Console.WriteLine($"   → usunięto shape ID={shapeId}");
            }
        }

        // 2) usuń WSZYSTKIE właściwości tej grupy (cała linia, nie tylko jedna)
        var doUsuniecia = Model.EditableProperties
            .Where(p => (p.SplitGroupId ?? p.ShapeId) == groupId)
            .ToList();

        foreach (var p in doUsuniecia)
            Model.EditableProperties.Remove(p);

        Console.WriteLine($"   → usunięto {doUsuniecia.Count} właściwości grupy {groupId}");

        // 3) jeśli kalkulator był otwarty na usuwanej właściwości — zamknij
        if (_currentEditingIndex == index || _currentEditingIndex >= Model.EditableProperties.Count)
        {
            _calculatorVisible = false;
            _currentEditingIndex = -1;
        }

        // 4) odśwież rodzica + UI
        await ZapiszDoRodzica();
        StateHasChanged();
    }

    private void AppendToCalculator(string value) => _calculatorExpression += value;

    private void ClearCalculator() => _calculatorExpression = "";

    private void BackspaceCalculator()
    {
        if (_calculatorExpression.Length > 0)
            _calculatorExpression = _calculatorExpression.Substring(0, _calculatorExpression.Length - 1);
    }

    private void UseCurrentValue()
    {
        if (Model?.EditableProperties != null && _currentEditingIndex >= 0 &&
            _currentEditingIndex < Model.EditableProperties.Count)
        {
            _calculatorExpression = Model.GetPropertyValue(_currentEditingIndex).ToString();
        }
    }

    private void CalculateResult()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_calculatorExpression))
                return;

            var dataTable = new System.Data.DataTable();
            var result = dataTable.Compute(
                _calculatorExpression.Replace("×", "*").Replace("÷", "/").Replace("−", "-"),
                null);
            _calculatorExpression = Convert.ToDouble(result).ToString("0.#####");
        }
        catch
        {
            _calculatorExpression = "Błąd";
            Task.Delay(1000).ContinueWith(_ =>
            {
                _calculatorExpression = "";
                InvokeAsync(StateHasChanged);
            });
        }
    }

    private async Task HandleCalculatorOk()
    {
        if (_currentEditingIndex >= 0 && !string.IsNullOrWhiteSpace(_calculatorExpression))
        {
            try
            {
                var dataTable = new System.Data.DataTable();
                var result = dataTable.Compute(
                    _calculatorExpression.Replace("×", "*").Replace("÷", "/").Replace("−", "-"),
                    null);
                double finalValue = Convert.ToDouble(result);

                Model.UpdateEditableProperty(_currentEditingIndex, finalValue);
                await ZapiszDoRodzica();
            }
            catch
            {
                Model.UpdateEditableProperty(_currentEditingIndex, 0);
                await ZapiszDoRodzica();
            }
        }

        _calculatorVisible = false;
        _currentEditingIndex = -1;
    }

    private Task HandleCalculatorCancel()
    {
        _calculatorVisible = false;
        _currentEditingIndex = -1;
        return Task.CompletedTask;
    }
