                                                <td>@model.NazwaKonfiguracji</td>
                                                <td>@model.Typ</td>
                                                <td>
                                                    @if (model.Rysunek?.Length > 0)
                                                    {
                                                        <img src="data:image/png;base64,@Convert.ToBase64String(model.Rysunek)" width="60" height="60" />
                                                    }
                                                    else
                                                    {

                                                        <span class="text-muted">Brak</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        else if (CzyMozliwePolaczenie(pierwszyModel, model))
                                        {
                                            <tr @onclick="() => WybierzModel(model, selDol, selGora, selLewa, selPrawa, false, selSlStaly, selSlRuchomy)">
                                                <td>@model.NazwaKonfiguracji</td>
                                                <td>@model.Typ</td>
                                                <td>
                                                    @if (model.Rysunek?.Length > 0)
                                                    {
                                                        <img src="data:image/png;base64,@Convert.ToBase64String(model.Rysunek)" width="60" height="60" />
                                                    }
                                                    else
                                                    {

                                                        <span class="text-muted">Brak</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
