    // Wybór modelu
    private async Task WybierzModel(KonfModele model, bool stronaDol, bool stronaGora, bool stronaLewa, bool stronaPrawa, bool bStyczny, bool bSlupekStaly, bool bSlupekRuchomy)
    {

        boolStyczny = bStyczny; // Przypisujemy wartość przekazaną z parametru

        Console.WriteLine($"WybierzModel - START - stronaDol: {stronaDol}, stronaGora: {stronaGora}, stronaLewa: {stronaLewa}, stronaPrawa: {stronaPrawa}, boolStyczny: {boolStyczny}, bSlupekStaly: {bSlupekStaly}, bSlupekRuchomy: {bSlupekRuchomy}");

        if (!selDol && !selGora && !selLewa && !selPrawa && !selDolStyczne && !selGoraStyczne && !selLewaStyczne && !selPrawaStyczne)
        {
            BladKonfiguracji = "Wybierz co najmniej jedną stronę (Dół, Góra, Lewa, Prawa).";
            _ = _notice.Warning(new()
            {
                Message = BladKonfiguracji,
                Description = "Uwaga!",
                Placement = NotificationPlacement.BottomLeft
            });
            return;
        }

        if (model == null)
        {
            BladKonfiguracji = "Wybierz co najmniej jedną stronę wybrany - model jest pusty.";
            _ = _notice.Warning(new()
            {
                Message = BladKonfiguracji,
                Description = "Uwaga!",
                Placement = NotificationPlacement.BottomLeft
            });
            return;
        }

        BladKonfiguracji = "";

        if (!boolStyczny && model.Typ.Contains("Słupek") && drugiModel == null)
        {
            selSlStaly = true;
            bSlupekStaly = true;

            _notice.Warning(new()
            {
                Message = "Wybór słupka stałego jest wymuszony przy połączeniu stycznym ze słupkiem.",
                Description = "Uwaga!",
                Placement = NotificationPlacement.BottomLeft,
                Duration = 4
            });
        }
        else if (!boolStyczny && !model.Typ.Contains("Słupek") && drugiModel == null && bSlupekStaly && pierwszyModel != null && !pierwszyModel.Typ.Contains("Słupek"))
        {
            selSlStaly = false;
            bSlupekStaly = false;
            _notice.Warning(new()
            {
                Message = "W razie konieczności wybierz ponownie słupek stały.",
                Description = "Uwaga!",
                Placement = NotificationPlacement.BottomLeft,
                Duration = 4
            });
        }

        Console.WriteLine("WybierzModel - START");

        try
        {
            var response = await Http.GetAsync($"api/konfmodeleelementy/powiazaniajuzzaznaczone/{model.RowId}");
            if (!response.IsSuccessStatusCode)
            {
                BladKonfiguracji = $"Błąd odczytu powiązania: {response.StatusCode}";
                Console.WriteLine(BladKonfiguracji);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<MVCKonfModele>();
            if (result?.KonfSystem == null || result.KonfSystem.Count == 0)
            {
                BladKonfiguracji = "Brak danych powiązanych";
                Console.WriteLine(BladKonfiguracji);
                return;
            }

            var warunki = new List<Func<KonfSystem, bool>>();

            if (stronaDol) warunki.Add(x => x.WystepujeDol);
            if (stronaGora) warunki.Add(x => x.WystepujeGora);
            if (stronaLewa) warunki.Add(x => x.WystepujeLewa);
            if (stronaPrawa) warunki.Add(x => x.WystepujePrawa);

            if (bSlupekRuchomy && pierwszyModel == null) warunki.Add(x => x.Typ == "Słupek ruchomy");
            if (bSlupekStaly && pierwszyModel == null) warunki.Add(x => x.Typ == "Słupek stały");

            if (model.Typ.Contains("Słupek") && boolStyczny)
            {
                warunki.Clear();
                warunki.Add(x => x.Typ == "Słupek stały");
            }

            // Filtrujemy rekordy spełniające WSZYSTKIE warunki
            var pasujaceSystemy = result.KonfSystem.Where(x => warunki.All(w => w(x))).ToList();

            // Jeśli nie ma dokładnie jednego pasującego rekordu → błąd
            if (pasujaceSystemy.Count != 1)
            {
                BladKonfiguracji = pasujaceSystemy.Count == 0
                ? "Nie znaleziono pasującego systemu konfiguracyjnego. Zmień występowanie elementu. Np. zaznacz tylko lewy/górny/prawy!"
                : $"Znaleziono {pasujaceSystemy.Count} {(pasujaceSystemy.Count == 1 ? "pasujący system" : "pasujące systemy")}. Wymagane jest dokładnie jedno dopasowanie. W przypadku dopasowania skrzydła z słupkiem ruchomym zaznacz opcję <Słupek ruchomy> i jako pierwszy wybierz model z ruchomym słupkiem";
                _message.Info(BladKonfiguracji, 5);

                BladKonfiguracji += "\r\n";

                foreach (var test in pasujaceSystemy)
                {
                    Console.WriteLine($"Pasujący system: {test.Nazwa}, WystepujeDol: {test.WystepujeDol}, WystepujeGora: {test.WystepujeGora}, WystepujeLewa: {test.WystepujeLewa}, WystepujePrawa: {test.WystepujePrawa}, Typ: {test.Typ}");
                    BladKonfiguracji += $"Pasujący system: {test.Nazwa}, WystepujeDol: {test.WystepujeDol}, WystepujeGora: {test.WystepujeGora}, WystepujeLewa: {test.WystepujeLewa}, WystepujePrawa: {test.WystepujePrawa}, Typ: {test.Typ}";
                    BladKonfiguracji += "\r\n";
                }

                Console.WriteLine(BladKonfiguracji);
                return;
            }

            // Sprawdzamy, czy wszystkie pasujące rekordy mają ten sam Indeks
            if (pasujaceSystemy.Select(x => x.IndeksElementu).Distinct().Count() > 1)
            {
                BladKonfiguracji = $"Model jest zbudowany z więcej niż jednego typu elementów. Prawdopodobnie element dolny może być różny od pozostałych. Pomiń jedną ze stron i sprawdź! [Znalezione indeksy: {string.Join(", ", pasujaceSystemy.Select(x => x.IndeksElementu).Distinct())}]";
                await _message.Info(BladKonfiguracji, 5);
                Console.WriteLine(BladKonfiguracji);
                return;
            }

            // Pobieramy JEDYNY pasujący rekord
            var pasujacy = pasujaceSystemy.First();

            // var pasujacy = result.KonfSystem.FirstOrDefault(x =>
            //     (stronaDol && x.WystepujeDol) ||
            //     (stronaGora && x.WystepujeGora) ||
            //     (stronaLewa && x.WystepujeLewa) ||
            //     (stronaPrawa && x.WystepujePrawa));

            if (pasujacy == null)
            {
                BladKonfiguracji = "Nie znaleziono pasującego elementu. Zmień występowanie elementu. Np. zaznacz tylko lewy/górny/prawy!";
                await _message.Info(BladKonfiguracji, 5);
                Console.WriteLine(BladKonfiguracji);
                return;
            }

            Console.WriteLine($"Wybór modelu: {model.NazwaKonfiguracji}, pasujący: {pasujacy.Nazwa} WystepujeDol: {pasujacy.WystepujeDol} = {stronaDol}");

            if (pierwszyModel == null)
            {

                SelectedModelPierwszyId = model.RowId.ToString();

                pierwszyModel = pasujacy;
                offsetX = 0; // Resetuj offset
                offsetY = 0; // Resetuj offset


                StyczneRectHeight = (pasujacy.PoziomDol ?? 0) - (pasujacy.PoziomGora ?? 0);

                AktualizujSvg();
            }
            else if (drugiModel == null)
            {
                SelectedModelDrugiId = model.RowId.ToString();

                drugiModel = pasujacy;

                AktualizujSvg();                          // 1. generuj combinedSvg

                await InvokeAsync(StateHasChanged);      // 2. wymuś render Blazora

                await Task.Delay(100);                    // 3. krótka pauza lub: await Task.Yield();
                await JSRuntime.InvokeVoidAsync("svgHelper.centerAndFit");
                await Task.Delay(100);
                await JSRuntime.InvokeVoidAsync("svgHelper.initGuideLines");

            }

            await InvokeAsync(StateHasChanged);

            Console.WriteLine($"Wybór modelu: KONIEC");

        }
        catch (Exception ex)
        {
            BladKonfiguracji = $"Błąd: {ex.Message}";
            Console.WriteLine(BladKonfiguracji);
        }
    }

    // Generowanie SVG z większym obszarem roboczym
    private void AktualizujSvg()
    {

        if (pierwszyModel == null && drugiModel == null && !boolStyczny)
        {
            combinedSvg = "";
            return;
        }

        var svgParts = new List<string>();
        double centerX = 300; // Środek obszaru roboczego (600x600/2)
        double centerY = 300;

        // 🔹 1️⃣ Pierwszy model - zawsze na środku
        if (pierwszyModel != null)
        {
            svgParts.Add($@"
            <g id=""model1"" transform=""translate({centerX}, {centerY})"">
    {ExtractInnerSvg(NormalizeSvg(pierwszyModel.SVG))}
            </g>");
        }

        // 🔹 2️⃣ Drugi model lub prostokąt zastępczy.
        // Model 1 pozostaje nieruchomy. Wszystkie transformacje modelu 2
        // są wykonywane na zewnętrznej grupie #model2-transform.
        if (drugiModel != null)
        {
            double secondX = centerX + offsetX;
            double secondY = centerY + offsetY;
            string baseTransform = FormattableString.Invariant(
                $"translate({secondX}, {secondY})");

            if (boolStyczny)
            {
                double pasujacyPierwszy = pierwszyModel == null
                    ? 0
                    : Math.Abs((pierwszyModel.PionLewa - pierwszyModel.PionPrawa) ?? 0);

                double pasujacyWymiarY = Math.Abs(
                    (drugiModel.PoziomGora - drugiModel.PoziomDol) ?? 0);
                double pasujacyWymiarX = Math.Abs(
                    (drugiModel.PionLewa - drugiModel.PionPrawa) ?? 0);

                if (pasujacyWymiarY == 0) pasujacyWymiarY = 5;
                if (pasujacyWymiarX == 0) pasujacyWymiarX = 5;

                double roznicaY = Math.Abs(pasujacyPierwszy - pasujacyWymiarY);
                double roznicaX = Math.Abs(pasujacyPierwszy - pasujacyWymiarX);
                double rectWidth = roznicaY < roznicaX
                    ? pasujacyWymiarY
                    : pasujacyWymiarX;

                string widthSvg = rectWidth.ToString(
                    System.Globalization.CultureInfo.InvariantCulture);
                string heightSvg = StyczneRectHeight.ToString(
                    System.Globalization.CultureInfo.InvariantCulture);

                svgParts.Add($@"
                <g id=""model2-transform""
                   transform=""{baseTransform}""
                   data-base-transform=""{baseTransform}"">
                    <g id=""model2""><rect x=""0"" y=""0""
                        width=""{widthSvg}"" height=""{heightSvg}""
                        fill=""#e0e0e0"" fill-opacity=""0.5""
                        stroke=""#000"" stroke-width=""1"" /></g>
                </g>");
            }
            else
            {
                svgParts.Add($@"
                <g id=""model2-transform""
                   transform=""{baseTransform}""
                   data-base-transform=""{baseTransform}"">
                    <g id=""model2"">{ExtractInnerSvg(NormalizeSvg(drugiModel.SVG))}</g>
                </g>");
            }
        }

        // 🔹 3️⃣ Złożenie końcowego SVG
        var _combinedSvg = $@"
        <svg xmlns=""http://www.w3.org/2000/svg"" width=""600"" height=""600""
             viewBox=""0 0 600 600"" preserveAspectRatio=""xMidYMid meet"">
            <g id=""zoom-group"">
    {string.Join("", svgParts)}
            </g>
        </svg>";

        if (boolStyczny)
        {
            combinedSvgStyczne = _combinedSvg;
            SvgKeyStyczne = Guid.NewGuid().ToString();
        }
        else
        {
            combinedSvg = _combinedSvg;
            SvgKey = Guid.NewGuid().ToString();
        }

        string NormalizeSvg(string svg) =>
            svg?
            .Replace("id=\"guide-line-horizontalMax\"", "data-name=\"guide-line-horizontalMax\"")
            .Replace("id=\"guide-line-vertical\"", "data-name=\"guide-line-vertical\"")
            .Trim('\uFEFF', '\u200B', '\u0000')
            .Replace("\r", "").Replace("\n", "").Trim() ?? "";

    }


    // Pomocnicze metody do przetwarzania SVG
    private string NormalizeSvg(string svg) => svg?.Trim('\uFEFF', '\u200B', '\u0000').Replace("\r", "").Replace("\n", "").Trim() ?? "";

    private string ExtractInnerSvg(string svg)
    {
        if (string.IsNullOrWhiteSpace(svg)) return "";
        int start = svg.IndexOf('>') + 1;
        int end = svg.LastIndexOf("</svg>", StringComparison.OrdinalIgnoreCase);
        return (start > 0 && end > start) ? svg.Substring(start, end - start).Trim() : svg;
    }

