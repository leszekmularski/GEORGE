            window.svgHelper.bakeModel2Transform = function () {

            try {

                const svg = document.querySelector(".scaled-svg > svg");

                if (!svg) {
                    console.warn("[bakeModel2Transform] Brak SVG");
                    return "";
                }

                const model2 = svg.querySelector("#model2");

                if (!model2) {
                    console.warn("[bakeModel2Transform] Brak #model2");
                    return "";
                }

                const transform = model2.getAttribute("transform") || "";

                console.log(
                    "[bakeModel2Transform] Aktualny transform:",
                    transform
                );

                if (!transform.trim()) {
                    console.log(
                        "[bakeModel2Transform] model2 nie posiada transformacji."
                    );

                    return model2.outerHTML;
                }

                /*
                 * KLUCZOWA RZECZ:
                 *
                 * Pobieramy macierz transformacji model2
                 * względem SVG.
                 */
                const ctm = model2.getCTM();

                if (!ctm) {
                    console.warn(
                        "[bakeModel2Transform] Nie udało się pobrać CTM."
                    );

                    return model2.outerHTML;
                }

                /*
                 * Tworzymy kopię model2.
                 * Oryginalny model2 na ekranie pozostaje nietknięty.
                 */
                const clone = model2.cloneNode(true);

                /*
                 * Transformację parenta trzeba rozłożyć
                 * na elementy znajdujące się wewnątrz model2.
                 */
                const elements = clone.querySelectorAll(
                    "line, path, circle, rect, ellipse, polygon, polyline"
                );

                /*
                 * Macierz transformacji model2
                 */
                const matrixValues =
                    `matrix(${ctm.a} ${ctm.b} ${ctm.c} ${ctm.d} ${ctm.e} ${ctm.f})`;

                /*
                 * Przenosimy transformację na wszystkie
                 * elementy potomne.
                 *
                 * Nie ruszamy model1.
                 */
                elements.forEach(el => {

                    const existing = el.getAttribute("transform");

                    if (existing) {

                        el.setAttribute(
                            "transform",
                            `${matrixValues} ${existing}`
                        );

                    } else {

                        el.setAttribute(
                            "transform",
                            matrixValues
                        );
                    }
                });

                /*
                 * Teraz usuwamy transformację z #model2
                 */
                clone.removeAttribute("transform");

                console.log(
                    "[bakeModel2Transform] ✅ Transformacja model2 została przeniesiona."
                );

                return clone.outerHTML;

            }
            catch (e) {

                console.error(
                    "[bakeModel2Transform] Błąd:",
                    e
                );

                return "";
            }
        };

