            await Task.Delay(100);
            await JSRuntime.InvokeVoidAsync("svgHelper.initGuideLines");
            await Task.Yield();
            await JSRuntime.InvokeVoidAsync("svgHelper.move", toffsetX, toffsetY);
            await Task.Delay(50);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Błąd generowania nowego SVG: {ex.Message}");
        }
    }
