        // ============================================================
        // USTAWIENIE WIDOKU WZGLĘDEM ZAPISANEJ TRANSFORMACJI BAZOWEJ
        // ============================================================
        //
        // rotationDelta - obrót względem widoku bazowego
        // mirror        - czy wykonać odbicie lustrzane
        //
        // Funkcja nie kumuluje transformacji.
        // Za każdym razem bazowa transformacja jest przekazywana
        // osobno i stanowi punkt wyjścia.
        // ============================================================

            window.svgHelper.applyModelsViewTransform = function (
            baseTransform,
            rotationDelta,
            mirror,          // odbicie poziome (góra ↔ dół) — stara nazwa, zachowana dla zgodności
            mirrorVertical   // odbicie pionowe (lewo ↔ prawo) — NOWY, opcjonalny
        ) {
            try {
                const group = window.svgHelper.ensureModelsGroup();

                if (!group) {
                    console.error("[applyModelsViewTransform] Brak #models-group");
                    return false;
                }

                const bbox = group.getBBox();
                const cx = bbox.x + bbox.width / 2;
                const cy = bbox.y + bbox.height / 2;

                const transforms = [];

                // 1. Bazowa transformacja (zachowuje oryginalny układ modeli)
                if (baseTransform && baseTransform.trim() !== "") {
                    transforms.push(baseTransform);
                }

                // 2. Obrót względem środka grupy modeli
                const angle = ((Number(rotationDelta) % 360) + 360) % 360;
                if (angle !== 0) {
                    transforms.push(`rotate(${angle}, ${cx}, ${cy})`);
                }

                // 3. Odbicie POZIOME (góra ↔ dół) — oś pozioma y = cy
                if (mirror === true) {
                    transforms.push(`translate(0, ${2 * cy}) scale(1, -1)`);
                }

                // 4. Odbicie PIONOWE (lewo ↔ prawo) — oś pionowa x = cx
                if (mirrorVertical === true) {
                    transforms.push(`translate(${2 * cx}, 0) scale(-1, 1)`);
                }

                const finalTransform = transforms.join(" ");

                if (finalTransform) {
                    group.setAttribute("transform", finalTransform);
                } else {
                    group.removeAttribute("transform");
                }

                console.log("[applyModelsViewTransform]", {
                    rotationDelta: angle,
                    mirror: mirror,
                    mirrorVertical: mirrorVertical,
                    transform: finalTransform
                });

                return true;
            }
            catch (e) {
                console.error("[applyModelsViewTransform]", e);
                return false;
            }
        };

        // ============================================================
        // SILNIK TRANSFORMACJI MODELI
        // Edycja pojedyncza działa na #model2-transform.
        // Rzuty CAD działają na #models-group obejmującej oba modele.
        // ============================================================
        (function () {
            const SVG_NS = "http://www.w3.org/2000/svg";
            const helper = window.svgHelper = window.svgHelper || {};

            function getSvg() {
                return document.querySelector(".scaled-svg svg") ||
                       document.querySelector("svg");
            }

            function getZoomGroup() {
                return getSvg()?.querySelector("#zoom-group") || null;
            }

            function getModel2() {
                return getSvg()?.querySelector("#model2") || null;
            }

            function getWrapper(createIfMissing = true) {
                const svg = getSvg();
                if (!svg) return null;

                let wrapper = svg.querySelector("#model2-transform");
                if (wrapper || !createIfMissing) return wrapper;

                const model2 = getModel2();
                if (!model2 || !model2.parentNode) return null;

                wrapper = document.createElementNS(SVG_NS, "g");
                wrapper.setAttribute("id", "model2-transform");

                const oldTransform = model2.getAttribute("transform");
                model2.removeAttribute("transform");
                model2.parentNode.insertBefore(wrapper, model2);
                wrapper.appendChild(model2);

                if (oldTransform) {
                    wrapper.setAttribute("transform", oldTransform);
                    wrapper.setAttribute("data-base-transform", oldTransform);
                }

                console.info("[Transformacje] Utworzono wrapper #model2-transform.");
                return wrapper;
            }

            // Grupa wspólnego widoku CAD. Zawiera OBA modele:
            // model1 oraz wrapper modelu2. Ruch/obrót/odbicie pojedynczego
            // modelu nadal działa na #model2-transform, natomiast zapis rzutów
            // operuje na #models-group i zachowuje wzajemne położenie modeli.
            function getModelsGroup(createIfMissing = true) {
                const svg = getSvg();
                const zoomGroup = getZoomGroup();
                if (!svg || !zoomGroup) return null;

                let group = svg.querySelector("#models-group");
                if (!group && !createIfMissing) return null;

                if (!group) {
                    group = document.createElementNS(SVG_NS, "g");
                    group.setAttribute("id", "models-group");
                    zoomGroup.insertBefore(group, zoomGroup.firstChild);
                }

                const model1 = svg.querySelector("#model1");
                const model2Wrapper = getWrapper();

                // Przenosimy oba modele do wspólnego rodzica bez zmiany
                // ich lokalnych transformacji i bez zmiany geometrii.
                if (model1 && model1.parentNode !== group) group.appendChild(model1);
                if (model2Wrapper && model2Wrapper.parentNode !== group) group.appendChild(model2Wrapper);

                return group;
            }

            function matrixOf(wrapper) {
                const svg = getSvg();
                if (!svg || !wrapper) return null;

                const consolidated = wrapper.transform.baseVal.consolidate();
                const source = consolidated ? consolidated.matrix : svg.createSVGMatrix();
                const copy = svg.createSVGMatrix();
                copy.a = source.a; copy.b = source.b;
                copy.c = source.c; copy.d = source.d;
                copy.e = source.e; copy.f = source.f;
                return copy;
            }

            function setMatrix(wrapper, matrix) {
                const svg = getSvg();
                if (!svg || !wrapper || !matrix) return false;

                const transform = svg.createSVGTransform();
                transform.setMatrix(matrix);
                wrapper.transform.baseVal.initialize(transform);
                return true;
            }

            // Środek modelu liczony jest w jego własnym układzie współrzędnych.
            // Dzięki temu odbicie nie zależy od transformacji rodzica (#zoom-group)
            // ani od aktualnego przesunięcia wrappera.
            function getModel2LocalCenter() {
                const model2 = getModel2();
                if (!model2) return null;

                const bbox = model2.getBBox();
                return {
                    x: bbox.x + bbox.width / 2,
                    y: bbox.y + bbox.height / 2
                };
            }

            function transformAroundCenter(operation) {
                const svg = getSvg();
                const wrapper = getWrapper();
                if (!svg || !wrapper) return false;

                const center = getModel2LocalCenter();
                const current = matrixOf(wrapper);
                if (!center || !current) return false;

                // Transformację wykonujemy w lokalnym układzie modelu 2:
                // najpierw przesunięcie środka do (0,0), potem obrót/odbicie,
                // a na końcu powrót środka. Mnożenie z prawej strony jest tu istotne.
                const toCenter = svg.createSVGMatrix().translate(center.x, center.y);
                const operationMatrix = operation(svg.createSVGMatrix());
                const fromCenter = svg.createSVGMatrix().translate(-center.x, -center.y);
                const localOperation = toCenter
                    .multiply(operationMatrix)
                    .multiply(fromCenter);
                const result = current.multiply(localOperation);

                return setMatrix(wrapper, result);
            }

            // Transformacja elementu wokół jego własnego środka bbox.
            // Używana dla wspólnej grupy CAD (model1 + model2).
            function transformElementAroundCenter(element, operation) {
                const svg = getSvg();
                if (!svg || !element) return false;

                const bbox = element.getBBox();
                const cx = bbox.x + bbox.width / 2;
                const cy = bbox.y + bbox.height / 2;
                const current = matrixOf(element);
                if (!current) return false;

                const localOperation = svg.createSVGMatrix()
                    .translate(cx, cy)
                    .multiply(operation(svg.createSVGMatrix()))
                    .translate(-cx, -cy);

                return setMatrix(element, current.multiply(localOperation));
            }

            // Transformacja całej grupy względem punktu w układzie SVG.
            function transformElementAroundPoint(element, x, y, operation) {
                const svg = getSvg();
                if (!svg || !element) return false;

                const current = matrixOf(element);
                if (!current) return false;

                const localOperation = svg.createSVGMatrix()
                    .translate(x, y)
                    .multiply(operation(svg.createSVGMatrix()))
                    .translate(-x, -y);

                return setMatrix(element, current.multiply(localOperation));
            }

            function baseTransform(wrapper) {
                return wrapper?.getAttribute("data-base-transform") || "";
            }

            function setBaseTransform(wrapper, value) {
                if (!wrapper) return;
                if (value && value.trim()) wrapper.setAttribute("data-base-transform", value);
                else wrapper.removeAttribute("data-base-transform");
            }

            function toggleFlip(attribute, operation) {
                const wrapper = getWrapper();
                if (!wrapper) return false;

                const active = wrapper.getAttribute(attribute) === "true";
                const ok = transformAroundCenter(matrix => operation(matrix, active));
                if (ok) wrapper.setAttribute(attribute, active ? "false" : "true");
                return ok;
            }

            // API grupy wspólnego widoku — obejmuje model1 i model2.
            helper.ensureModelsGroup = function () {
                return getModelsGroup();
            };

            helper.getModelsGroupTransform = function () {
                const group = getModelsGroup();
                return group ? (group.getAttribute("transform") || "") : null;
            };

            // Reset/odtworzenie transformacji WSPÓLNEJ grupy CAD.
            // Nie dotykamy transformacji modelu2 — jego indywidualne
            // przesunięcie i odbicie muszą pozostać niezależne.
            helper.setModelsGroupTransform = function (transform) {
                const group = getModelsGroup();
                if (!group) return false;

                if (transform && transform.trim()) group.setAttribute("transform", transform);
                else group.removeAttribute("transform");

                return true;
            };

            // Odczyt i odtworzenie odbicia nakładanego bezpośrednio na #model2.
            // Te funkcje są potrzebne, gdy pomiar chwilowo resetuje wrapper.
            helper.getModel2Transform = function () {
                const model2 = getModel2();
                return model2 ? (model2.getAttribute("transform") || "") : null;
            };

            helper.setModel2Transform = function (transform) {
                const model2 = getModel2();
                if (!model2) return false;

                if (transform && transform.trim()) {
                    model2.setAttribute("transform", transform);

                    const vertical = /scale\s*\(\s*-1\s*,\s*1\s*\)/.test(transform);
                    const horizontal = /scale\s*\(\s*1\s*,\s*-1\s*\)/.test(transform);

                    model2.setAttribute("data-mirror-vertical", vertical ? "true" : "false");
                    model2.setAttribute("data-mirror-horizontal", horizontal ? "true" : "false");
                } else {
                    model2.removeAttribute("transform");
                    model2.setAttribute("data-mirror-vertical", "false");
                    model2.setAttribute("data-mirror-horizontal", "false");
                }

                return true;
            };

            helper.move = function (dx, dy) {
                const wrapper = getWrapper();
                const svg = getSvg();
                const current = matrixOf(wrapper);
                if (!wrapper || !svg || !current) return null;

                const scale = Number(helper.zoomLevel) || 1;
                current.e += Number(dx || 0) / scale;
                current.f += Number(dy || 0) / scale;
                setMatrix(wrapper, current);

                return { x: current.e * scale, y: -current.f * scale };
            };

            helper.moveonlyedit = function (dx, dy) {
                return helper.move(dx, dy);
            };

            helper.rotateSecondModel = function () {
                const ok = transformAroundCenter(matrix => matrix.rotate(90));
                if (ok) console.info("[Transformacje] Obrót modelu 2 o 90°.");
                return ok;
            };

            // Odbicie wykonujemy bezpośrednio na #model2, a nie na wrapperze.
            // Dzięki temu nie zależymy od macierzy przesunięcia/obrotu wrappera.
            function ustawOdbicieModelu2(kierunek, wlacz) {
                const model2 = getModel2();
                if (!model2) {
                    console.error("[Transformacje] Nie znaleziono #model2.");
                    return false;
                }

                if (!wlacz) {
                    model2.removeAttribute("transform");
                    model2.setAttribute("data-mirror-vertical", "false");
                    model2.setAttribute("data-mirror-horizontal", "false");
                    return true;
                }

                const bbox = model2.getBBox();
                const cx = bbox.x + bbox.width / 2;
                const cy = bbox.y + bbox.height / 2;

                if (kierunek === "vertical") {
                    // Odbicie względem osi pionowej x=cx: x' = 2*cx - x.
                    model2.setAttribute("transform", `translate(${2 * cx}, 0) scale(-1, 1)`);
                    model2.setAttribute("data-mirror-vertical", "true");
                    model2.setAttribute("data-mirror-horizontal", "false");
                    console.info("[Transformacje] Model 2 odbity względem osi pionowej.", {
                        cx: cx, transform: model2.getAttribute("transform")
                    });
                } else {
                    // Odbicie względem osi poziomej y=cy: y' = 2*cy - y.
                    model2.setAttribute("transform", `translate(0, ${2 * cy}) scale(1, -1)`);
                    model2.setAttribute("data-mirror-horizontal", "true");
                    model2.setAttribute("data-mirror-vertical", "false");
                    console.info("[Transformacje] Model 2 odbity względem osi poziomej.", {
                        cy: cy, transform: model2.getAttribute("transform")
                    });
                }
                return true;
            }

            // ODBICIE WZGLĘDEM LINII PIONOWEJ — lewo/prawo.
            helper.flipSecondModelAcrossVerticalAxis = function () {
                const model2 = getModel2();
                if (!model2) return false;
                const active = model2.getAttribute("data-mirror-vertical") === "true";
                return ustawOdbicieModelu2("vertical", !active);
            };

            // Zachowanie zgodności ze starszymi nazwami.
            helper.flipSecondModelHorizontally = helper.flipSecondModelAcrossVerticalAxis;

            // ODBICIE WZGLĘDEM LINII POZIOMEJ — góra/dół.
            helper.flipSecondModelVertically = function () {
                const model2 = getModel2();
                if (!model2) return false;
                const active = model2.getAttribute("data-mirror-horizontal") === "true";
                return ustawOdbicieModelu2("horizontal", !active);
            };

            // Stare wywołanie przed obrotem nie musi już wypalać geometrii.
            helper.bakeHorizontalFlipModel2 = function () {
                return true;
            };

            // Operacje „All” dotyczą obu modeli, tak jak w pierwotnym
            // mechanizmie rzutów CAD. Operacje bez „All” nadal dotyczą tylko model2.
            helper.rotateAllModel = function () {
                const group = getModelsGroup();
                if (!group) return false;
                const ok = transformElementAroundCenter(group, matrix => matrix.rotate(90));
                if (ok) console.info("[Transformacje] Obrócono wspólny układ obu modeli o 90°.");
                return ok;
            };

            helper.flipAllModelsHorizontally = function () {
                const group = getModelsGroup();
                const svg = getSvg();
                if (!group || !svg) return false;
                const vb = svg.viewBox.baseVal;
                const centerY = vb.y + vb.height / 2;
                return transformElementAroundPoint(group, 0, centerY, matrix => matrix.scale(1, -1));
            };

            helper.flipAllModelsVertically = function () {
                const group = getModelsGroup();
                const svg = getSvg();
                if (!group || !svg) return false;
                const vb = svg.viewBox.baseVal;
                const centerX = vb.x + vb.width / 2;
                return transformElementAroundPoint(group, centerX, 0, matrix => matrix.scale(-1, 1));
            };

            // Przy zapisie rzutów transformujemy wspólną grupę, a nie model2.
            // Dzięki temu oba modele obracają się/odbijają razem, zachowując
            // wzajemne położenie ustalone podczas edycji połączenia.
            helper.applyModelsViewTransform = function (
                savedBaseTransform, rotationDelta, mirror, mirrorVertical
            ) {
                const group = getModelsGroup();
                if (!group) return false;

                if (savedBaseTransform && savedBaseTransform.trim()) {
                    group.setAttribute("transform", savedBaseTransform);
                } else {
                    group.removeAttribute("transform");
                }

                const angle = Number(rotationDelta) || 0;
                if (angle && !transformElementAroundCenter(group, matrix => matrix.rotate(angle))) {
                    return false;
                }

                // mirror = góra/dół; mirrorVertical = lewo/prawo.
                // Tak jak w pierwotnym mechanizmie zapisu, odbicie jest
                // wykonywane względem środka wspólnej grupy obu modeli.
                if (mirror === true) {
                    if (!transformElementAroundCenter(group, matrix => matrix.scale(1, -1))) {
                        return false;
                    }
                }

                if (mirrorVertical === true) {
                    if (!transformElementAroundCenter(group, matrix => matrix.scale(-1, 1))) {
                        return false;
                    }
                }

                console.info("[applyModelsViewTransform] Zastosowano rzut do obu modeli.", {
                    rotationDelta: angle,
                    mirror,
                    mirrorVertical,
                    transform: group.getAttribute("transform") || ""
                });
                return true;
            };

            helper.resetModel2Position = function () {
                const wrapper = getWrapper();
                if (!wrapper) return false;

                // Reset do położenia bazowego modelu 2, bez obrotu i odbić.
                const base = baseTransform(wrapper);
                if (base) wrapper.setAttribute("transform", base);
                else wrapper.removeAttribute("transform");

                ustawOdbicieModelu2("vertical", false);
                wrapper.setAttribute("data-flip-x", "false");
                wrapper.setAttribute("data-flip-y", "false");
                return true;
            };

            helper.getModel2Position = function () {
                const wrapper = getWrapper();
                const matrix = matrixOf(wrapper);
                if (!wrapper || !matrix) return null;
                return {
                    x: matrix.e,
                    y: -matrix.f,
                    transform: wrapper.getAttribute("transform") || ""
                };
            };

            // Diagnostyka uwzględnia wrapper jako rodzica modelu 2.
            const previousDiagnostic = helper.getDiagnosticTransforms;
            helper.getDiagnosticTransforms = function () {
                const svg = getSvg();
                const ids = ["model1", "model2", "model2-transform"];
                const result = {};
                ids.forEach(id => {
                    const element = svg?.querySelector("#" + id);
                    if (!element) {
                        result[id] = { exists: false };
                        return;
                    }
                    const m = element.getCTM();
                    const p = element.parentElement;
                    const pm = p?.getCTM();
                    const toObject = value => value ? {
                        a: value.a, b: value.b, c: value.c,
                        d: value.d, e: value.e, f: value.f
                    } : null;
                    result[id] = {
                        exists: true,
                        transform: element.getAttribute("transform"),
                        matrix: toObject(m),
                        parent: p ? {
                            id: p.id,
                            transform: p.getAttribute("transform"),
                            matrix: toObject(pm)
                        } : null
                    };
                });
                console.log("[Transformacje] Diagnostyka:", result);
                return result;
            };

            console.info("[Transformacje] Aktywny silnik: nieruchomy model 1, transformowany model 2.");
        })();

</script>

<div class="container-fluid mt-3">
    <div class="row mb-3">
        <div class="col">
            @if (czekajNaZaladowanieDanych)
            {
                <div class="text-center mt-5">
                    <Spin Size="large" />
                    <p class="mt-3">Ładowanie danych, proszę czekać...</p>
                </div>
            }
            else
            {
                <div class="d-flex align-items-stretch gap-3">
                    <div class="flex-grow-1">
                        <label class="form-label">Wybierz system:</label>
                        <select class="form-select" @onchange="@(async (args) => await OnSystemSelected(args))">
                            <option value="" disabled selected="@(string.IsNullOrEmpty(SelectedSystemId))">-- Wybierz system --</option>
                            @foreach (var system in Systemy)
                            {
                                <option value="@system.RowId" selected="@(system.RowId.ToString() == SelectedSystemId)">
                                    @system.Nazwa_Systemu
                                </option>
                            }
                        </select>
                    </div>

                    <div class="d-flex align-items-end">
                        <Tooltip Placement="@Placement.TopRight" Title="Wróć do poprzedniej strony">
                            <Button class="btn btn-outline-secondary d-flex align-items-center gap-2"
                                    Icon="@IconType.Fill.Backward"
                                    Style="height: 38px; white-space: nowrap;"
                                    OnClick="GoBack">
                                <span class="d-none d-md-inline">Wróć do poprzedniej strony</span>
                                <span class="d-md-none">Wróć</span>
                            </Button>
                        </Tooltip>
                    </div>
                </div>
            }
        </div>
    </div>

    <Tabs OnChange="() => OnTabChange(activeKey)" @bind-ActiveKey="@activeKey" Animated>

        <TabPane Key="0" Tab="Istniejące konfiguracje">
            <h4>
                Lista zapisanych połączeń (@(FiltrowanePolaczenia?.Count() ?? 0))
                <Button Icon="@IconType.Outline.Read" OnClick="OdswiezDane" />
            </h4>

            @if (listaPolaczen == null)
            {
                <p><em>Wybierz system i poczekaj na załadowanie danych...</em></p>
            }
            else if (!listaPolaczen.Any())
            {
                <p><strong>Brak zapisanych połączeń.</strong></p>
            }
            else
            {
                <div class="d-flex align-items-center gap-2 mb-3">

                    <span class="fw-bold">Pokaż:</span>

                    <Button Type="@(filtrPolaczen == "WSZYSTKIE" ? ButtonType.Primary : ButtonType.Default)"
                            OnClick="@(() => UstawFiltr("WSZYSTKIE"))">
                        Wszystkie
                    </Button>

                    <Button Type="@(filtrPolaczen == "STYCZNE" ? ButtonType.Primary : ButtonType.Default)"
                            OnClick="@(() => UstawFiltr("STYCZNE"))">
                        Tylko styczne
                    </Button>

                    <Button Type="@(filtrPolaczen == "PRZEKROJE" ? ButtonType.Primary : ButtonType.Default)"
                            OnClick="@(() => UstawFiltr("PRZEKROJE"))">
                        Tylko przekroje
                    </Button>

                </div>

                <table class="table table-bordered table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>Rysunek</th>
                            <th>Opis</th>
                            <th>Strona</th>
                            <th>X [mm]</th>
                            <th>Y [mm]</th>
                            <th>Kąt [°]</th>
                            <th style="width: 120px;">Akcja</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var polaczenie in FiltrowanePolaczenia)
                        {
                            <tr>
                                <td>
                                    @if (polaczenie.RysunekPrzekroju?.Length > 20 && polaczenie.RysunekPrzekrojuStyczny?.Length > 20)
                                    {

                                        <a href="#" onclick="event.preventDefault(); openImageInNewTab('@Convert.ToBase64String(polaczenie.RysunekPrzekroju)')">
                                            <img title="zew:@polaczenie.ElementZewnetrznyId &nbsp; wew:@polaczenie.ElementWewnetrznyId"
                                                 src="data:image/png;base64,@Convert.ToBase64String(polaczenie.RysunekPrzekroju)"
                                                 style="width: 120px; height: auto; object-fit: contain; border: 1px solid #ddd;" />
                                        </a>

                                        <a href="#" onclick="event.preventDefault(); openImageInNewTab('@Convert.ToBase64String(polaczenie.RysunekPrzekrojuStyczny)')">
                                            <img title="Połączenie styczne zew:@polaczenie.ElementZewnetrznyId wew:@polaczenie.ElementWewnetrznyId"
                                                 src="data:image/png;base64,@Convert.ToBase64String(polaczenie.RysunekPrzekrojuStyczny)"
                                                 style="width: 150px; height: auto; object-fit: contain; border: 1px solid #ccc;" />
                                        </a>
                                    }
                                    else if (polaczenie.RysunekPrzekroju?.Length > 20 && polaczenie.RysunekPrzekrojuStyczny?.Length < 20)
                                    {
                                        <a href="#" onclick="event.preventDefault(); openImageInNewTab('@Convert.ToBase64String(polaczenie.RysunekPrzekroju)')">
                                            <img title="zew:@polaczenie.ElementZewnetrznyId wew:@polaczenie.ElementWewnetrznyId"
                                                 src="data:image/png;base64,@Convert.ToBase64String(polaczenie.RysunekPrzekroju)"
                                                 style="width: 150px; height: auto; object-fit: contain; border: 1px solid #ccc;" />
                                        </a>
                                    }
                                    else if (polaczenie.RysunekPrzekroju?.Length < 20 && polaczenie.RysunekPrzekrojuStyczny?.Length > 20)
                                    {
                                        <a href="#" onclick="event.preventDefault(); openImageInNewTab('@Convert.ToBase64String(polaczenie.RysunekPrzekrojuStyczny)')">
                                            <img title="Połączenie styczne zew:@polaczenie.ElementZewnetrznyId wew:@polaczenie.ElementWewnetrznyId"
                                                 src="data:image/png;base64,@Convert.ToBase64String(polaczenie.RysunekPrzekrojuStyczny)"
                                                 style="width: 150px; height: auto; object-fit: contain; border: 1px solid #ccc;" />
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Brak</span>
                                    }
                                </td>
                                <td>@(polaczenie.OpisPolaczenia ?? "")</td>
                                <td>@polaczenie.StronaPolaczenia</td>
                                @if (polaczenie.DodatkowyWarunek == "STYCZNE")
                                {
                                    <td>@polaczenie.PrzesuniecieXStycznej</td>
                                    <td>@polaczenie.PrzesuniecieYStycznej</td>
                                }
                                else
                                {
                                    <td>@polaczenie.PrzesuniecieX</td>
                                    <td>@polaczenie.PrzesuniecieY</td>
                                }
                                <td>@polaczenie.ZapisanyKat</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <Tooltip Title="Edytuj połączenie">
                                            <Button Type="primary"
                                                    Size="small"
                                                    Icon="@IconType.Outline.Edit"
                                                    OnClick="() => PrzelaczIOtworz(polaczenie)" />
                                        </Tooltip>

                                        <Popconfirm Title="Czy chcesz usunąć dane?"
                                                    OnConfirm="()=> deleteRow(polaczenie.RowId.ToString())"
                                                    OkText="Tak"
                                                    CancelText="Nie">
                                            <Tooltip Title="Usuń połączenie">
                                                <Button Type="danger"
                                                        Size="small"
                                                        Icon="@IconType.Outline.Delete"
                                                        Danger />
                                            </Tooltip>
                                        </Popconfirm>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

        </TabPane>

        <TabPane Key="1" Tab="Konfigurator połączeń - przekroje">

            <div class="row">
