                deltaY_mm: deltaY_mm,
                success: newDisplacement &&
                         Math.abs(newDisplacement.x_mm - targetX_mm) < 0.1 &&
                         Math.abs(newDisplacement.y_mm - targetY_mm) < 0.1
            };
        };

