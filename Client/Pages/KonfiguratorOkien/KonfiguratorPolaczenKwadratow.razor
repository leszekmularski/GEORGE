        // Funkcja do przywracania SVG z bazy
            window.svgHelper.restoreSvgFromString = function(svgString) {
        try {
            console.log("🔄 restoreSvgFromString - start");

            const container = document.querySelector(".scaled-svg");
            if (!container) {
                console.error("❌ Container .scaled-svg not found");
                return false;
            }

            // Wyczyść kontener
            container.innerHTML = '';

            // Sprawdź czy mamy do czynienia z div czy bezpośrednio svg
            let svgElement = null;

            // Opcja 1: Jeśli string zawiera div.scaled-svg
            if (svgString.includes('<div')) {
                console.log("📦 String zawiera div - używam innerHTML");

                // Tymczasowy kontener do parsowania
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = svgString;

                // Znajdź svg w kontenerze
                svgElement = tempDiv.querySelector('svg');

                if (!svgElement) {
                    console.error("❌ Nie znaleziono <svg> w stringu");
                    return false;
                }

                // Klonuj element SVG
                const clonedSvg = svgElement.cloneNode(true);
                container.appendChild(clonedSvg);

            } else if (svgString.includes('<svg')) {
                console.log("📦 String zawiera bezpośrednio <svg>");

                // Parsuj jako XML
                const parser = new DOMParser();
                const svgDoc = parser.parseFromString(svgString, "image/svg+xml");

                // Sprawdź błędy parsowania
                const parserError = svgDoc.querySelector("parsererror");
                if (parserError) {
                    console.error("❌ Błąd parsowania:", parserError.textContent);

                    // Próbuj alternatywnie z innerHTML
                    container.innerHTML = svgString;
                    svgElement = container.querySelector('svg');

                    if (!svgElement) {
                        return false;
                    }
                } else {
                    svgElement = svgDoc.querySelector('svg');

                    if (!svgElement) {
                        console.error("❌ Brak <svg> po parsowaniu");
                        return false;
                    }

                    // Importuj i dodaj do kontenera
                    const importedSvg = document.importNode(svgElement, true);
                    container.appendChild(importedSvg);
                }
            } else {
                console.error("❌ String nie zawiera ani <div> ani <svg>");
                return false;
            }

            // Upewnij się, że mamy właściwe atrybuty SVG
            if (svgElement) {
                if (!svgElement.getAttribute('width')) {
                    svgElement.setAttribute('width', '600');
                }
                if (!svgElement.getAttribute('height')) {
                    svgElement.setAttribute('height', '600');
                }
                if (!svgElement.getAttribute('viewBox')) {
                    svgElement.setAttribute('viewBox', '0 0 600 600');
                }
                if (!svgElement.getAttribute('preserveAspectRatio')) {
                    svgElement.setAttribute('preserveAspectRatio', 'xMidYMid meet');
                }
            }

            console.log("✅ SVG przywrócony pomyślnie");
            return true;

        } catch (e) {
            console.error("❌ restoreSvgFromString error:", e);

            // Ostateczna próba - bezpośredni innerHTML
            try {
                const container = document.querySelector(".scaled-svg");
                if (container) {
                    container.innerHTML = svgString;
                    console.log("✅ SVG przywrócony przez innerHTML (fallback)");
                    return true;
                }
            } catch (e2) {
                console.error("❌ Fallback też zawiódł:", e2);
            }

            return false;
        }
    };

