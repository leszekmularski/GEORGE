    // Otwarcie modala edycji
    private async Task ZaladujDaneModalEdycji(KonfPolaczenie polaczenie)
    {
        try
        {
            Console.WriteLine("🔄 Rozpoczynam ładowanie danych modal edycji...");

            await JSRuntime.InvokeVoidAsync("svgHelper.resetModel2Position");
            await Task.Delay(50);

            edytowanePolaczenie = polaczenie;
            edytowanyRowId = polaczenie.RowId;
            edytowanyOpis = polaczenie.OpisPolaczenia ?? "";
            edytowanaStrona = polaczenie.StronaPolaczenia ?? "";

            // Formularz = konwencja fizyczna (Y+ = góra), jak w bazie.
            edytowanePrzesuniecieX = polaczenie.PrzesuniecieX;
            edytowanePrzesuniecieY = polaczenie.PrzesuniecieY;
            edytowanePrzesuniecieXStycznej = polaczenie.PrzesuniecieXStycznej;
            edytowanePrzesuniecieYStycznej = polaczenie.PrzesuniecieYStycznej;

            Console.WriteLine(
                $"[ZaladujDaneModalEdycji] Strona='{NormalizujStrone(edytowanaStrona)}', " +
                $"X={edytowanePrzesuniecieX}, Y={edytowanePrzesuniecieY}, " +
                $"Xs={edytowanePrzesuniecieXStycznej}, Ys={edytowanePrzesuniecieYStycznej}");

            old_edytowanePrzesuniecieX = edytowanePrzesuniecieX;
            old_edytowanePrzesuniecieY = edytowanePrzesuniecieY;
            old_edytowanePrzesuniecieXStycznej = edytowanePrzesuniecieXStycznej;
            old_edytowanePrzesuniecieYStycznej = edytowanePrzesuniecieYStycznej;

            edytowanyKat = polaczenie.ZapisanyKat;
            SelectedModelPierwszyId = polaczenie.RowIdModelu.ToString();
            SelectedModelDrugiId = polaczenie.RowIdModeluDrugi.ToString();

            old_ElementZewnetrznyToSlupek = polaczenie.ElementZewnetrznyToSlupek;
            old_ElementWewnetrznyToSlupek = polaczenie.ElementWewnetrznyToSlupek;

            wybranyKierunekBudowy = polaczenie.KierunekBudowy;

            Console.WriteLine(
                $"📋 Podstawowe dane. Model1={SelectedModelPierwszyId}, Model2={SelectedModelDrugiId}");

            var response1 = await Http.GetAsync(
                $"api/konfmodeleelementy/powiazaniajuzzaznaczone/{SelectedModelPierwszyId}");
            if (!response1.IsSuccessStatusCode)
            {
                BladKonfiguracji = $"Błąd odczytu powiązania: {response1.StatusCode} #1";
                return;
            }
            var result1 = await response1.Content.ReadFromJsonAsync<MVCKonfModele>();
            if (result1?.KonfSystem == null || result1.KonfSystem.Count == 0)
            {
                BladKonfiguracji = "Brak danych powiązanych #1";
                return;
            }
            pierwszyModel = result1.KonfSystem.First();

            StyczneRectHeight =
                (pierwszyModel.PoziomDol ?? 0) -
                (pierwszyModel.PoziomGora ?? 0);

            var response2 = await Http.GetAsync(
                $"api/konfmodeleelementy/powiazaniajuzzaznaczone/{SelectedModelDrugiId}");
            if (!response2.IsSuccessStatusCode)
            {
                BladKonfiguracji = $"Błąd odczytu powiązania: {response2.StatusCode} #2";
                return;
            }
            var result2 = await response2.Content.ReadFromJsonAsync<MVCKonfModele>();
            if (result2?.KonfSystem == null || result2.KonfSystem.Count == 0)
            {
                BladKonfiguracji = "Brak danych powiązanych #2";
                return;
            }
            drugiModel = result2.KonfSystem.First();

            // W bazie słupki stałe i ruchome są zapisane jako odległości
            // od osi profilu. Formularz zachowuje te wartości bez ponownego
            // dodawania osi. Przeliczamy tylko parę aktywną w zakładce.
            bool slupStaly = pierwszyModel.Typ?.Contains(
                "Słupek stały",
                StringComparison.OrdinalIgnoreCase) == true;
            bool slupRuchomy = pierwszyModel.Typ?.Contains(
                "Słupek ruchomy",
                StringComparison.OrdinalIgnoreCase) == true;

            if (slupStaly || slupRuchomy)
            {
                if (boolStyczny)
                {
                    var formularz = slupStaly
                        ? PrzeliczSlupkaStalegoDoFormularza(
                            edytowanePrzesuniecieXStycznej,
                            edytowanePrzesuniecieYStycznej,
                            edytowanaStrona)
                        : PrzeliczSlupkaRuchomegoDoFormularza(
                            edytowanePrzesuniecieXStycznej,
                            edytowanePrzesuniecieYStycznej,
                            edytowanaStrona);

                    edytowanePrzesuniecieXStycznej = formularz.X;
                    edytowanePrzesuniecieYStycznej = formularz.Y;
                }
                else
                {
                    var formularz = slupStaly
                        ? PrzeliczSlupkaStalegoDoFormularza(
                            edytowanePrzesuniecieX,
                            edytowanePrzesuniecieY,
                            edytowanaStrona)
                        : PrzeliczSlupkaRuchomegoDoFormularza(
                            edytowanePrzesuniecieX,
                            edytowanePrzesuniecieY,
                            edytowanaStrona);

                    edytowanePrzesuniecieX = formularz.X;
                    edytowanePrzesuniecieY = formularz.Y;
                }

                old_edytowanePrzesuniecieX = edytowanePrzesuniecieX;
                old_edytowanePrzesuniecieY = edytowanePrzesuniecieY;
                old_edytowanePrzesuniecieXStycznej = edytowanePrzesuniecieXStycznej;
                old_edytowanePrzesuniecieYStycznej = edytowanePrzesuniecieYStycznej;

                Console.WriteLine(
                    $"[ZaladujDaneModalEdycji] typ1={pierwszyModel.Typ}, " +
                    $"slupStaly={slupStaly}, slupRuchomy={slupRuchomy}, " +
                    $"strona={edytowanaStrona}, formularz=" +
                    $"({(boolStyczny ? edytowanePrzesuniecieXStycznej : edytowanePrzesuniecieX):F3}," +
                    $"{(boolStyczny ? edytowanePrzesuniecieYStycznej : edytowanePrzesuniecieY):F3})");
            }

            czyModalEdycjiWidoczny = true;

            if (string.IsNullOrEmpty(combinedSvg) && string.IsNullOrEmpty(combinedSvgStyczne))
            {
                AktualizujSvg();
            }

            await InvokeAsync(StateHasChanged);
            await Task.Delay(500);

            if (!string.IsNullOrEmpty(polaczenie.KonfiguracjaSVG))
            {
                Console.WriteLine("📦 Wczytano SVG z bazy");
                var loadResult = await JSRuntime.InvokeAsync<bool>(
                    "svgHelper.loadSvgPreserveTransform",
                    polaczenie.KonfiguracjaSVG);

                if (loadResult)
                {
                    await Task.Delay(300);

                    var model2Transform = await JSRuntime.InvokeAsync<string>("eval",
                        "(function() { const m2 = document.querySelector('#model2'); " +
                        "return m2 ? (m2.getAttribute('transform') || 'BRAK') : 'NIE ISTNIEJE'; })()");

                    Console.WriteLine($"📐 Transformacja model2: {model2Transform}");

                    bool brakTransformacji =
                        string.IsNullOrEmpty(model2Transform)
                        || model2Transform == "BRAK"
                        || model2Transform == "NIE ISTNIEJE"
                        || model2Transform == "null";

                    if (brakTransformacji)
                    {
                        double fizX = boolStyczny
                            ? edytowanePrzesuniecieXStycznej
                            : edytowanePrzesuniecieX;
                        double fizY = boolStyczny
                            ? edytowanePrzesuniecieYStycznej
                            : edytowanePrzesuniecieY;

                        var scaleResult = await JSRuntime.InvokeAsync<double>("eval",
                            "(function() { const zg = document.querySelector('#zoom-group'); " +
                            "if (!zg) return 1; const t = zg.getAttribute('transform') || ''; " +
                            "const m = t.match(/scale\\(([^)]+)\\)/); return m ? parseFloat(m[1]) : 1; })()");

                        double mmToPx = 3.779527559;
                        double newX = 300 + (fizX * mmToPx) / scaleResult;
                        double newY = 300 - (fizY * mmToPx) / scaleResult;

                        Console.WriteLine(
                            $"[ZaladujDaneModalEdycji] Fallback: fiz=({fizX},{fizY}) → px=({newX:F2},{newY:F2})");

                        string jsSetTransform = $@"
                        (function() {{
                            const m2 = document.querySelector('#model2');
                            if (!m2) return false;
                            m2.setAttribute('transform', 'translate({newX.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {newY.ToString(System.Globalization.CultureInfo.InvariantCulture)})');
                            return true;
                        }})()";

                        await JSRuntime.InvokeAsync<bool>("eval", jsSetTransform);
                    }

                    var hasGuides = await JSRuntime.InvokeAsync<bool>("eval",
                        "(function() { return document.querySelectorAll('[data-name^=\"guide-line-\"]').length > 0; })()");
                    if (hasGuides)
                        await JSRuntime.InvokeVoidAsync("svgHelper.initGuideLines");
                }
            }
            else
            {
                double fizX, fizY;
                offsetX = 0;
                offsetY = 0;

                if (boolStyczny)
                {
                    fizX = old_edytowanePrzesuniecieXStycznej;
                    fizY = old_edytowanePrzesuniecieYStycznej;
                    offsetY = -106;
                }
                else
                {
                    fizX = old_edytowanePrzesuniecieX;
                    fizY = old_edytowanePrzesuniecieY;
                }

                await JSRuntime.InvokeVoidAsync("svgHelper.centerAndFit");
                await Task.Delay(100);
                await JSRuntime.InvokeVoidAsync("svgHelper.initGuideLines");
                await Task.Delay(50);

                Console.WriteLine(
                    $"[ZaladujDaneModalEdycji] Brak SVG. move: fiz=({fizX},{fizY})");

                await JSRuntime.InvokeVoidAsync("svgHelper.move", fizX, -fizY);
                await Task.Delay(50);
            }

            Console.WriteLine($"✅ Modal edycji załadowany");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Błąd w ZaladujDaneModalEdycji: {ex.Message}");
            BladKonfiguracji = $"Błąd ładowania danych: {ex.Message}";
        }
    }

    private async Task GenerujNowySvg()
