            edytowanePrzesuniecieY = polaczenie.PrzesuniecieY;
            edytowanePrzesuniecieXStycznej = polaczenie.PrzesuniecieXStycznej;
            edytowanePrzesuniecieYStycznej = polaczenie.PrzesuniecieYStycznej;

            old_edytowanePrzesuniecieX = polaczenie.PrzesuniecieX;
            old_edytowanePrzesuniecieY = polaczenie.PrzesuniecieY;
            old_edytowanePrzesuniecieXStycznej = polaczenie.PrzesuniecieXStycznej;
            old_edytowanePrzesuniecieYStycznej = polaczenie.PrzesuniecieYStycznej;

            edytowanyKat = polaczenie.ZapisanyKat;

            SelectedModelPierwszyId = polaczenie.RowIdModelu.ToString();
            SelectedModelDrugiId = polaczenie.RowIdModeluDrugi.ToString();

            Console.WriteLine($"📋 Podstawowe dane przypisane. Model1 ID: {SelectedModelPierwszyId}, Model2 ID: {SelectedModelDrugiId}");

            // Pobierz pierwszy model
            Console.WriteLine("🌐 Pobieram pierwszy model z API...");
            var response1 = await Http.GetAsync($"api/konfmodeleelementy/powiazaniajuzzaznaczone/{SelectedModelPierwszyId}");
            if (!response1.IsSuccessStatusCode)
            {
                BladKonfiguracji = $"Błąd odczytu powiązania: {response1.StatusCode} #1";
                Console.WriteLine($"❌ {BladKonfiguracji}");
                return;
            }

            var result1 = await response1.Content.ReadFromJsonAsync<MVCKonfModele>();
            if (result1?.KonfSystem == null || result1.KonfSystem.Count == 0)
            {
                BladKonfiguracji = "Brak danych powiązanych #1";
                Console.WriteLine($"❌ {BladKonfiguracji}");
                return;
            }
            var pasujaceSystemy1 = result1.KonfSystem.ToList();
            var pasujacy1 = pasujaceSystemy1.First();
            pierwszyModel = pasujacy1;
            Console.WriteLine($"✅ Pobrano pierwszy model: {pierwszyModel.Nazwa}");

            // Pobierz drugi model
            Console.WriteLine("🌐 Pobieram drugi model z API...");
            var response2 = await Http.GetAsync($"api/konfmodeleelementy/powiazaniajuzzaznaczone/{SelectedModelDrugiId}");
            if (!response2.IsSuccessStatusCode)
            {
                BladKonfiguracji = $"Błąd odczytu powiązania: {response2.StatusCode} #2";
                Console.WriteLine($"❌ {BladKonfiguracji}");
                return;
            }

            var result2 = await response2.Content.ReadFromJsonAsync<MVCKonfModele>();
            if (result2?.KonfSystem == null || result2.KonfSystem.Count == 0)
            {
                BladKonfiguracji = "Brak danych powiązanych #2";
                Console.WriteLine($"❌ {BladKonfiguracji}");
                return;
            }
            var pasujaceSystemy2 = result2.KonfSystem.ToList();
            var pasujacy2 = pasujaceSystemy2.First();
            drugiModel = pasujacy2;
            Console.WriteLine($"✅ Pobrano drugi model: {drugiModel.Nazwa}");

            // 📌 WAŻNE: Najpierw pokaż modal
            czyModalEdycjiWidoczny = true;

            // Wygeneruj SVG jeśli nie istnieje
            if (string.IsNullOrEmpty(combinedSvg) && string.IsNullOrEmpty(combinedSvgStyczne))
            {
                AktualizujSvg();
            }

            await InvokeAsync(StateHasChanged);
            await Task.Delay(500); // Poczekaj na pełny render

            // 📌 SPRAWDŹ CZY MAMY ZAPISANY SVG W BAZIE
            if (!string.IsNullOrEmpty(polaczenie.KonfiguracjaSVG))
            {
                Console.WriteLine("📦 Wczytano SVG z bazy danych");
                Console.WriteLine($"📏 Długość SVG: {polaczenie.KonfiguracjaSVG.Length} znaków");

                // Załaduj SVG z zachowaniem transformacji
                var loadResult = await JSRuntime.InvokeAsync<bool>("svgHelper.loadSvgPreserveTransform",
                    polaczenie.KonfiguracjaSVG);

                if (loadResult)
                {
                    Console.WriteLine("✅ SVG załadowane z zachowaniem transformacji");

                    // Poczekaj na pełne załadowanie
                    await Task.Delay(300);

                    // Sprawdź transformację model2
                    var model2Transform = await JSRuntime.InvokeAsync<string>("eval",
                        "(function() { const m2 = document.querySelector('#model2'); return m2 ? (m2.getAttribute('transform') || 'BRAK') : 'NIE ISTNIEJE'; })()");

                    Console.WriteLine($"📐 Transformacja model2: {model2Transform}");

                    // Jeśli model2 ma zapisaną transformację, zachowaj ją
                    if (model2Transform != "BRAK" && model2Transform != "NIE ISTNIEJE" &&
                        !string.IsNullOrEmpty(model2Transform) && model2Transform != "null")
                    {
                        Console.WriteLine("✅ Model2 ma zapisaną transformację - zachowuję ją bez zmian");
                    }
                    else
                    {
                        // Model2 nie ma transformacji - zastosuj zapisane przesunięcie
                        Console.WriteLine("⚠️ Model2 nie ma transformacji, stosuję zapisane przesunięcie");

                        // Pobierz zapisane przesunięcie
                        double savedX = boolStyczny ? polaczenie.PrzesuniecieXStycznej : polaczenie.PrzesuniecieX;
                        double savedY = boolStyczny ? polaczenie.PrzesuniecieYStycznej : polaczenie.PrzesuniecieY;

                        Console.WriteLine($"📐 Zapisane przesunięcie: X={savedX}, Y={savedY}");

                        // Pobierz aktualną skalę zoom-group
                        var scaleResult = await JSRuntime.InvokeAsync<double>("eval",
                            "(function() { const zg = document.querySelector('#zoom-group'); if (!zg) return 1; const transform = zg.getAttribute('transform') || ''; const match = transform.match(/scale\\(([^)]+)\\)/); return match ? parseFloat(match[1]) : 1; })()");

                        Console.WriteLine($"📐 Skala zoom-group: {scaleResult}");

                        // Konwersja mm na piksele
                        double mmToPx = 3.779527559;
                        double deltaX = (savedX * mmToPx) / scaleResult;
                        double deltaY = (savedY * mmToPx) / scaleResult;

                        // Model1 jest na translate(300, 300)
                        double newX = 300 + deltaX;
                        double newY = 300 + deltaY;

                        Console.WriteLine($"📐 Nowa pozycja model2: X={newX:F2}, Y={newY:F2}");

                        // Ustaw transformację model2
                        var setResult = await JSRuntime.InvokeAsync<bool>("eval", $@"
                        (function() {{
                            const model2 = document.querySelector('#model2');
                            if (!model2) {{
                                console.error('Brak model2');
                                return false;
                            }}

                            model2.setAttribute('transform', 'translate({newX.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {newY.ToString(System.Globalization.CultureInfo.InvariantCulture)})');

                            console.log('Model2 ustawiony na: translate({newX:F2}, {newY:F2})');
                            return true;
                        }})()
                    ");

                        if (setResult)
                        {
                            Console.WriteLine($"✅ Model2 ustawiony na pozycji: X={newX:F2}, Y={newY:F2}");
                        }
                    }

                    // Sprawdź czy są prowadnice
                    var hasGuides = await JSRuntime.InvokeAsync<bool>("eval",
                        "(function() { return document.querySelectorAll('[data-name^=\"guide-line-\"]').length > 0; })()");

                    if (hasGuides)
                    {
                        await JSRuntime.InvokeVoidAsync("svgHelper.initGuideLines");
                        Console.WriteLine("✅ Prowadnice zainicjalizowane");
                    }

                    // NIE wywołuj centerAndFit - to zepsuje pozycje!

                    Console.WriteLine("✅ SVG przywrócony z bazy - pozycje zachowane");
                }
                else
                {
                    Console.WriteLine("❌ Nie udało się załadować SVG z bazy");
                }
            }
            else
            {
                Console.WriteLine("⚠️ Brak zapisanego SVG - generowanie nowego z offsetami");

                double toffsetX;
                double toffsetY;

                offsetX = 0;
                offsetY = 0;

                if (boolStyczny)
                {
                    toffsetX = old_edytowanePrzesuniecieXStycznej;
                    toffsetY = old_edytowanePrzesuniecieYStycznej;
                    offsetY = -106;
                }
                else
                {
                    toffsetX = old_edytowanePrzesuniecieX;
                    toffsetY = old_edytowanePrzesuniecieY;
                }

                Console.WriteLine($"Załadowano pierwszy model: {pierwszyModel.Nazwa} (ID: {pierwszyModel.RowId}) toffsetX: {toffsetX} toffsetY: {toffsetY}");

                await JSRuntime.InvokeVoidAsync("svgHelper.centerAndFit");
                await Task.Delay(100);
                await JSRuntime.InvokeVoidAsync("svgHelper.initGuideLines");
                await Task.Delay(50);
                await JSRuntime.InvokeVoidAsync("svgHelper.move", toffsetX, toffsetY);
                await Task.Delay(50);
            }

            Console.WriteLine($"✅ Modal edycji załadowany - Model1: {pierwszyModel.Nazwa}, Model2: {drugiModel.Nazwa}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Błąd w ZaladujDaneModalEdycji: {ex.Message}");
            Console.WriteLine($"❌ Stack trace: {ex.StackTrace}");
            BladKonfiguracji = $"Błąd ładowania danych: {ex.Message}";
        }
    }

