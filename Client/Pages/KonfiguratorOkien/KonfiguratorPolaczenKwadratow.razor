                    $"X = {result.przesuniecieX} mm, Y = {result.przesuniecieY} mm",
                Placement = NotificationPlacement.Top,
                Duration = 6.0
            });
        }
        finally
        {
            // Najpierw odtwarzamy przesunięcie/obrót wrappera,
            // następnie niezależne odbicie geometrii #model2.
            await JSRuntime.InvokeVoidAsync(
                "svgHelper.setModelsGroupTransform",
                transformacjaAktualna ?? "");

            await JSRuntime.InvokeVoidAsync(
                "svgHelper.setModel2Transform",
                odbicieModelu2 ?? "");

            await Task.Delay(100);
        }
    }

