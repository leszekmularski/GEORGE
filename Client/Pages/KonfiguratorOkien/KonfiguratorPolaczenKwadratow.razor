    // 📌 Przesuń model2 o BEZWZGLĘDNĄ wartość względem model1
       window.svgHelper.moveAbsolute = function(targetX_mm, targetY_mm) {
        try {
            console.log("🔄 moveAbsolute - start");

            // Znajdź SVG na różne sposoby
            let svg = document.querySelector(".scaled-svg svg");
            if (!svg) {
                svg = document.querySelector(".scaled-svg-container svg");
            }
            if (!svg) {
                svg = document.querySelector("svg");
            }

            console.log("🔍 SVG znaleziony:", !!svg);

            // Znajdź modele
            let model1 = svg?.querySelector("#model1");
            let model2 = svg?.querySelector("#model2");

            if (!model1 || !model2) {
                // Spróbuj znaleźć modele w całym dokumencie
                model1 = document.querySelector("#model1");
                model2 = document.querySelector("#model2");
            }

            console.log("🔍 Model1:", !!model1, "Model2:", !!model2);

            if (!model1 || !model2) {
                console.warn("❌ moveAbsolute: Nie znaleziono model1 lub model2");
                return false;
            }

            // Pobierz pozycję model1
            const getCenter = (el) => {
                try {
                    const bbox = el.getBBox();
                    const pt = svg.createSVGPoint();
                    pt.x = bbox.x + bbox.width / 2;
                    pt.y = bbox.y + bbox.height / 2;
                    const ctm = el.getCTM();
                    return pt.matrixTransform(ctm);
                } catch (e) {
                    console.warn("Błąd getCenter:", e);
                    return { x: 0, y: 0 };
                }
            };

            const center1 = getCenter(model1);
            console.log("📐 Środek model1:", center1.x, center1.y);

            // Konwersja mm na piksele
            const MM_TO_PX = 3.779527559;

            // Oblicz nową pozycję model2 w pikselach
            const deltaX_px = targetX_mm * MM_TO_PX;
            const deltaY_px = targetY_mm * MM_TO_PX;

            // Nowa pozycja model2 = pozycja model1 + przesunięcie
            // Ale uwaga: model1 jest na translate(300, 300), więc używamy tej pozycji
            const newX = 300 + deltaX_px;
            const newY = 300 + deltaY_px;

            console.log(`📐 Nowa pozycja model2: (${newX.toFixed(2)}, ${newY.toFixed(2)})`);

            // Ustaw transformację model2
            model2.setAttribute("transform", `translate(${newX}, ${newY})`);

            console.log(`✅ moveAbsolute: Model2 przesunięty do (${newX.toFixed(2)}, ${newY.toFixed(2)})`);

            return true;
        } catch (e) {
            console.error("❌ moveAbsolute error:", e);
            return false;
