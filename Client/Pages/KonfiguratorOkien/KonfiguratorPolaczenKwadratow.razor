    bool czekajNaZapisAll = false;

    private async Task SaveAllPosition()
    {
        if (string.IsNullOrEmpty(SelectedSystemId) ||
            pierwszyModel == null ||
            drugiModel == null)
        {
            await _message.Error(
                "❌ Brak wybranego systemu lub modeli do zapisania");
            return;
        }

        if (string.IsNullOrWhiteSpace(wybranyKierunekBudowy))
        {
            await _message.Error("❌ Wybierz kierunek budowy");
            return;
        }

        if (czekajNaZapisAll)
            return;

        await ZoomAllObj();
        await Task.Delay(100);

        // Docelowe widoki:
        // OdbicieGoraDol   - odbicie góra/dół (mirror w JS)
        // OdbicieLewoPrawo - odbicie lewo/prawo (mirrorVertical w JS)
        var stronyDoZapisu =
            new List<(string Strona,
                      int Kat,
                      bool OdbicieGoraDol,
                      bool OdbicieLewoPrawo,
                      int KatZapis)>();

        if (boolStyczny)
        {
            if (selGoraStyczne)
                stronyDoZapisu.Add(("góra", 0, false, false, 0));

            if (selDolStyczne)
                stronyDoZapisu.Add(("dół", 180, false, false, 180));

            if (selPrawaStyczne)
                stronyDoZapisu.Add(("prawa", 270, false, false, 270));

            if (selLewaStyczne)
                stronyDoZapisu.Add(("lewa", 270, false, true, 270));
        }
        else
        {
            if (selGora)
                stronyDoZapisu.Add(("góra", 0, false, false, 0));

            if (selDol)
                stronyDoZapisu.Add(("dół", 180, false, false, 180));

            if (selPrawa)
                stronyDoZapisu.Add(("prawa", 270, false, false, 270));

            if (selLewa)
                stronyDoZapisu.Add(("lewa", 270, false, true, 270));
        }

        if (stronyDoZapisu.Count == 0)
        {
            await _message.Warning(
                "❗ Zaznacz przynajmniej jeden widok do zapisania");
            return;
        }

        czekajNaZapisAll = true;

        string statusZapisu = "";

        // Zapamiętujemy aktualny stan CANVAS.
        int katBazowy = katUstawienia;

        try
        {
            // Orientacja aktualnego widoku CANVAS.
            var orientacjaBazowa =
                PobierzOrientacjeWidoku(wybranyKierunekBudowy);

            int katWidokuBazowego = orientacjaBazowa.Kat;

            bool odbicieBazoweGoraDol =
                orientacjaBazowa.OdbicieGoraDol;

            bool odbicieBazoweLewoPrawo =
                orientacjaBazowa.OdbicieLewoPrawo;

            // Zapamiętujemy dokładną transformację całej grupy modeli.
            string? transformacjaBazowa =
                await JSRuntime.InvokeAsync<string?>(
                    "svgHelper.getModelsGroupTransform");

            if (transformacjaBazowa == null)
            {
                await _message.Error(
                    "❌ Nie udało się odczytać transformacji modeli SVG.");
                return;
            }

            Console.WriteLine(
                $"[SaveAllPosition] Kierunek bazowy: {wybranyKierunekBudowy}");
            Console.WriteLine(
                $"[SaveAllPosition] Kąt bazowy: {katWidokuBazowego}°");
            Console.WriteLine(
                $"[SaveAllPosition] Odbicie góra/dół: {odbicieBazoweGoraDol}");
            Console.WriteLine(
                $"[SaveAllPosition] Odbicie lewo/prawo: {odbicieBazoweLewoPrawo}");
            Console.WriteLine(
                $"[SaveAllPosition] Transformacja bazowa: {transformacjaBazowa}");

            var wynikiZapisu = new List<string>();

            try
            {
                // ============================================================
                // POMIAR BAZOWY W WIDOKU IDENTITY (0°)
                // ============================================================
                //
                // 1) Reset models-group do 0° — measureGuideDisplacement NIE
                //    jest niezmienniczy względem rotacji models-group
                //    (bbox-based), więc mierzymy w neutralnym widoku.
                //
                // 2) Używamy PobierzWynikPrzesuniecia (C#), a NIE svgHelper
                //    bezpośrednio — funkcja zwraca surowy pomiar bazowy
                //    bez korekty strony — korekta osi jest wykonywana
                //    później w SavePosition dla każdej strony osobno.
                //
                await JSRuntime.InvokeVoidAsync(
                    "svgHelper.setModelsGroupTransform", "");
                await Task.Delay(150);

                var pomiarBazowy = await PobierzWynikPrzesuniecia();

                // Przywracamy widok bazowy — pętla i tak ustawia go
                // w każdej iteracji przez setModelsGroupTransform.
                await JSRuntime.InvokeVoidAsync(
                    "svgHelper.setModelsGroupTransform", transformacjaBazowa);
                await Task.Delay(100);

                if (pomiarBazowy == null)
                {
                    // PobierzWynikPrzesuniecia już pokazało komunikat błędu.
                    await _message.Error(
                        "❌ Nie udało się pobrać pomiaru bazowego.");
                    return;
                }

                double pomiarBazowyX = pomiarBazowy.przesuniecieX;
                double pomiarBazowyY = pomiarBazowy.przesuniecieY;

                Console.WriteLine(
                    $"[SaveAllPosition] Surowy pomiar bazowy (bez korekty strony): " +
                    $"X={pomiarBazowyX}, Y={pomiarBazowyY}");

                foreach (var strona in stronyDoZapisu)
                {
                    // Każdy widok rozpoczynamy od identycznego stanu CANVAS.
                    bool przywrocono =
                        await JSRuntime.InvokeAsync<bool>(
                            "svgHelper.setModelsGroupTransform",
                            transformacjaBazowa);

                    if (!przywrocono)
                    {
                        wynikiZapisu.Add(
                            $"❌ {strona.Strona}: nie udało się przywrócić transformacji bazowej.");
                        continue;
                    }

                    // Różnica kąta między aktualnym widokiem
                    // a widokiem, który chcemy zapisać.
                    int katObrotu = NormalizujKat(
                        strona.Kat - katWidokuBazowego);

                    int katObrotuZapisz = NormalizujKat(
                        strona.KatZapis - katWidokuBazowego);

                    // Odbicie wykonujemy tylko wtedy, gdy
                    // orientacja bazowa różni się od docelowej.
                    bool odbicieGoraDol =
                        strona.OdbicieGoraDol != odbicieBazoweGoraDol;

                    bool odbicieLewoPrawo =
                        strona.OdbicieLewoPrawo != odbicieBazoweLewoPrawo;

                    Console.WriteLine(
                        $"[SaveAllPosition] Strona: {strona.Strona}");
                    Console.WriteLine(
                        $"[SaveAllPosition] Obrót: {katObrotu}°");
                    Console.WriteLine(
                        $"[SaveAllPosition] Odbicie góra/dół: {odbicieGoraDol}");
                    Console.WriteLine(
                        $"[SaveAllPosition] Odbicie lewo/prawo: {odbicieLewoPrawo}");

                    // Ustawiamy widok docelowy.
                    // Argumenty odpowiadają kolejno parametrom JS:
                    // baseTransform, rotationDelta, mirror, mirrorVertical.
                    bool zastosowano =
                        await JSRuntime.InvokeAsync<bool>(
                            "svgHelper.applyModelsViewTransform",
                            transformacjaBazowa,
                            katObrotu,
                            odbicieGoraDol,
                            odbicieLewoPrawo);

                    if (!zastosowano)
                    {
                        wynikiZapisu.Add(
                            $"❌ {strona.Strona}: nie udało się ustawić widoku.");
                        continue;
                    }

                    // Aktualizujemy kąt ustawienia na czas zapisu.
                    katUstawienia = NormalizujKat(
                        katBazowy + katObrotuZapisz);

                    await InvokeAsync(StateHasChanged);

                    // Czekamy na zakończenie transformacji SVG.
                    await Task.Delay(150);
                    await Task.Yield();

                    // Zapisujemy konkretny widok, przekazując surowy pomiar
                    // bazowy w widoku 0°. SavePosition wykonuje korektę
                    // względem osi symetrii dla aktualnej strony.
                    string wynik = await SavePosition(
                        strona.Strona,
                        strona.KatZapis,
                        pomiarBazowyX,
                        pomiarBazowyY);

                    wynikiZapisu.Add(wynik);

                    Console.WriteLine(
                        $"[SaveAllPosition] Zakończono zapis: {strona.Strona}");
                }
            }
            finally
            {
                // Przywracamy pierwotny widok CANVAS.
                await JSRuntime.InvokeVoidAsync(
                    "svgHelper.setModelsGroupTransform",
                    transformacjaBazowa);

                katUstawienia = katBazowy;

                await InvokeAsync(StateHasChanged);
            }

            statusZapisu = string.Join("<br>", wynikiZapisu);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"[SaveAllPosition] Błąd: {ex}");

            await _message.Error(
                $"❌ Wystąpił błąd podczas zapisywania widoków: {ex.Message}");
        }
        finally
        {
            katUstawienia = katBazowy;

            czekajNaZapisAll = false;

            selGora = false;
            selDol = false;
            selLewa = false;
            selPrawa = false;

            selSlStaly = false;
            selSlRuchomy = false;

            precyzjaPrzesuwania = 10;

            wybranyKierunekBudowy = "";

            activeKey = "0";

            await InvokeAsync(StateHasChanged);
        }

        if (!string.IsNullOrWhiteSpace(statusZapisu))
        {
            _ = _notice.Info(new()
            {
                Message = statusZapisu,
                Description = "Informacja o zapisie",
                Placement = NotificationPlacement.TopRight
            });
        }
    }

    private async Task<string> SavePosition(
    string strona,
    int? katZapisywany = null,
    double? pomiarX = null,
    double? pomiarY = null)
    {
        int katDoZapisu = katZapisywany ?? katUstawienia;

        double przesuniecieX, przesuniecieY;

        if (pomiarX.HasValue && pomiarY.HasValue)
        {
            // Pomiar przekazany z zewnątrz (widok bazowy) — używamy go dla WSZYSTKICH stron
            przesuniecieX = pomiarX.Value;
            przesuniecieY = pomiarY.Value;
            Console.WriteLine(
                $"[SavePosition] {strona}: pomiar bazowy X={przesuniecieX}, Y={przesuniecieY}");
        }
        else
        {
            // Zapisz jednostronny — mierzymy na świeżo w aktualnym widoku
            var result = await PobierzWynikPrzesuniecia();
            if (result == null)
                return "Brak danych o przesunięciu. Nie zapisano.";
            przesuniecieX = result.przesuniecieX;
            przesuniecieY = result.przesuniecieY;
        }

        // ============================================================
        // KOREKTA PROSTOKĄTA ZASTĘPCZEGO (STYCZNE, tylko strona DÓŁ)
        // ============================================================
        //
        // Dla boolStyczny drugi model jest rysowany jako rect od (0,0)
        // w dół (dół bboxa w +StyczneRectHeight), podczas gdy rzeczywiste
        // modele są wyśrodkowane wokół (0,0). Dla strony "dół" powoduje to
        // zawyżenie Y o StyczneRectHeight — korygujemy przy zapisie.
        //
        // Odwrotność (przywrócenie) jest w ZaladujDaneModalEdycji.
        //
        if (boolStyczny &&
            (NormalizujStrone(strona) == "dół" ||
             NormalizujStrone(strona) == "dol"))
        {
            Console.WriteLine(
                $"[SavePosition] STYCZNE/DÓŁ: Y przed={przesuniecieY}, " +
                $"rectHeight={StyczneRectHeight}");
            przesuniecieY += StyczneRectHeight;
            Console.WriteLine($"[SavePosition] STYCZNE/DÓŁ: Y po={przesuniecieY}");
        }

        // Korekta słupka stałego jest wykonywana dopiero teraz, ponieważ
        // SavePosition zna konkretną stronę zapisywanego połączenia.
        // Pomiar bazowy pozostaje niezmieniony dla wszystkich czterech stron.
        bool slupRuchomy = pierwszyModel?.Typ?.Contains(
            "Słupek ruchomy",
            StringComparison.OrdinalIgnoreCase) == true;

        // Słupek stały i ruchomy korzystają z przeliczenia względem osi
        // profilu. Słupek ruchomy występuje wyłącznie po stronie LEWEJ/PRAWEJ.
        var wspolrzedneDoZapisu = slupRuchomy
            ? PrzeliczSlupkaRuchomegoDoZapisu(
                przesuniecieX,
                przesuniecieY,
                strona)
            : PrzeliczSlupkaStalegoDoZapisu(
                przesuniecieX,
                przesuniecieY,
                strona);

        double zapisX = wspolrzedneDoZapisu.X;
        double zapisY = wspolrzedneDoZapisu.Y;

        Console.WriteLine(
            $"[SavePosition] typ1={pierwszyModel?.Typ}, slupRuchomy={slupRuchomy}, " +
            $"strona={strona}, fiz=({przesuniecieX:F3},{przesuniecieY:F3}), " +
            $"kan=({zapisX:F3},{zapisY:F3})");

        Console.WriteLine("========== POMIAR → ZAPIS ==========");
        Console.WriteLine($"Strona: {strona}");
        Console.WriteLine($"Kąt: {katDoZapisu}");
        Console.WriteLine($"Pomiar fizyczny X: {przesuniecieX}");
        Console.WriteLine($"Pomiar fizyczny Y: {przesuniecieY}");
        Console.WriteLine($"Wartość zapisywana X: {zapisX}");
        Console.WriteLine($"Wartość zapisywana Y: {zapisY}");
        Console.WriteLine("====================================");

        Console.WriteLine("========== DANE MODELI ==========");
        Console.WriteLine($"Typ pierwszego modelu: {pierwszyModel?.Typ}");
        Console.WriteLine($"PoziomGora: {pierwszyModel?.PoziomGora}");
        Console.WriteLine($"PoziomDol: {pierwszyModel?.PoziomDol}");
        Console.WriteLine($"PoziomOsSymetrii: {pierwszyModel?.PoziomOsSymetrii}");
        Console.WriteLine($"PionLewa: {pierwszyModel?.PionLewa}");
        Console.WriteLine($"PionPrawa: {pierwszyModel?.PionPrawa}");
        Console.WriteLine($"Typ drugiego modelu: {drugiModel?.Typ}");
        Console.WriteLine("================================");

        // 🔹 Rysunek aktualnej zakładki
        var png = await GenerujPngBezProwadnic();
        var svg = await GenerujSvgBezProwadnic();
        var aktualnySvg = await JSRuntime.InvokeAsync<string>("svgHelper.getCurrentSvgState");

        Console.WriteLine(
            $"Rozpoczynam zapis. Strona: {strona}, svg: {svg.Length}, png: {png.Length}");

        string statusZapisu = "";

        var polaczenie = new KonfPolaczenie
        {
            ElementZewnetrznyId = pierwszyModel.RowId,
            ElementWewnetrznyId = drugiModel.RowId,
            StronaPolaczenia = strona,
            RowIdSystem = Guid.Parse(SelectedSystemId),
            RowIdModelu = Guid.Parse(SelectedModelPierwszyId),
            RowIdModeluDrugi = Guid.Parse(SelectedModelDrugiId),
            ZapisanyKat = katDoZapisu,
            OpisPolaczenia = $"Połączono: {pierwszyModel.Nazwa ?? "Model 1 ?"} z {drugiModel.Nazwa ?? "Model 2 ?"}",
            Uwagi = $"Ostatnia zmiana: {DateTime.Now} - [{user}]",
            DodatkowyWarunek = boolStyczny ? "STYCZNE" : "PRZEKROJE",
            ElementZewnetrznyToSlupek = pierwszyModel.Typ.Contains("Słupek stały"),
            ElementWewnetrznyToSlupek = drugiModel.Typ.Contains("Słupek stały"),
            KierunekBudowy = wybranyKierunekBudowy,
        };

        polaczenie.RysunekPrzekrojuStyczny = Array.Empty<byte>();
        polaczenie.RysunekPrzekroju = Array.Empty<byte>();

        // 🔍 Sprawdź, czy istnieje już połączenie
        KonfPolaczenie? existing = null;
        try
        {
            var responseS = await Http.GetAsync(
                $"api/KonfPolaczenie/find-by-elements/{polaczenie.ElementZewnetrznyId}/{polaczenie.ElementWewnetrznyId}/{strona}");

            if (responseS.IsSuccessStatusCode)
            {
                existing = await responseS.Content.ReadFromJsonAsync<KonfPolaczenie>();
            }
            else if (responseS.StatusCode != HttpStatusCode.NotFound)
            {
                await _message.Error($"❌ Błąd sprawdzania strony: {strona}");
                return string.Empty;
            }
        }
        catch (Exception ex)
        {
            await _message.Error($"❌ Błąd komunikacji z API dla strony {strona}: {ex.Message}");
            return string.Empty;
        }

        if (boolStyczny)
        {
            // --- ZAKŁADKA "STYCZNE" ---
            polaczenie.PrzesuniecieXStycznej = zapisX;
            polaczenie.PrzesuniecieYStycznej = zapisY;
            polaczenie.RysunekPrzekrojuStyczny = png;

            if (existing != null)
            {
                polaczenie.Id = existing.Id;
                polaczenie.RowId = existing.RowId;
                polaczenie.PrzesuniecieX = Math.Round(existing.PrzesuniecieX, precyzjaZapisu);
                polaczenie.PrzesuniecieY = Math.Round(existing.PrzesuniecieY, precyzjaZapisu);
            }
        }
        else
        {
            // --- ZAKŁADKA "PRZEKROJE" ---
            polaczenie.PrzesuniecieX = Math.Round(zapisX, precyzjaZapisu);
            polaczenie.PrzesuniecieY = Math.Round(zapisY, precyzjaZapisu);
            polaczenie.RysunekPrzekroju = png;

            if (existing != null)
            {
                polaczenie.Id = existing.Id;
                polaczenie.RowId = existing.RowId;
                polaczenie.PrzesuniecieXStycznej = Math.Round(existing.PrzesuniecieXStycznej, precyzjaZapisu);
                polaczenie.PrzesuniecieYStycznej = Math.Round(existing.PrzesuniecieYStycznej, precyzjaZapisu);
            }
        }

        polaczenie.PrzesuniecieXStycznej = Math.Round(polaczenie.PrzesuniecieXStycznej, precyzjaZapisu);
        polaczenie.PrzesuniecieYStycznej = Math.Round(polaczenie.PrzesuniecieYStycznej, precyzjaZapisu);

        polaczenie.SVG = svg;
        polaczenie.KonfiguracjaSVG = aktualnySvg;

        Console.WriteLine(
            $"Zapis: boolStyczny={boolStyczny}, " +
            $"{polaczenie.ElementZewnetrznyId}+{polaczenie.ElementWewnetrznyId}, " +
            $"Strona={strona}, X={przesuniecieX}, Y={przesuniecieY}, Kat={katDoZapisu}");


        HttpResponseMessage response;
        if (existing != null)
        {
            response = await Http.PutAsJsonAsync("api/KonfPolaczenie", polaczenie);
            Console.WriteLine($"Aktualizacja: {response.StatusCode}");
        }
        else
        {
            response = await Http.PostAsJsonAsync("api/KonfPolaczenie", polaczenie);
            Console.WriteLine($"Nowe: {response.StatusCode}");
        }

        if (response.IsSuccessStatusCode)
        {
            var zakladka = boolStyczny ? "styczna" : "przekrój";
            statusZapisu +=
                $"✅ Zapisano stronę {strona} ({zakladka}), kąt: {katDoZapisu}° <br/>";
        }
        else
        {
            _message.Error($"❌ Błąd zapisu strona: {strona}");
        }

        Console.WriteLine("========== ZAPIS PRZESUNIĘCIA ==========");
        Console.WriteLine($"Strona: {strona}");
        Console.WriteLine($"Kąt: {katDoZapisu}");
        Console.WriteLine($"X: {przesuniecieX}");
        Console.WriteLine($"Y: {przesuniecieY}");
        Console.WriteLine($"Styczne X: {polaczenie.PrzesuniecieXStycznej}");
        Console.WriteLine($"Styczne Y: {polaczenie.PrzesuniecieYStycznej}");
        Console.WriteLine($"Słupek stały: {pierwszyModel?.Typ}");
        Console.WriteLine("========================================");

        // Odśwież listę
        KonfiguracjeSystemu = null;
        listaPolaczen = null;
        await Task.Delay(10);

        KonfiguracjeSystemu = await Http.GetFromJsonAsync<List<KonfSystem>>(
            $"api/konfsystem/FIND_ROWID_SYS/{SelectedSystemId}") ?? new();

        try
        {
            var responselp = await Http.GetAsync(
                $"api/KonfPolaczenie/row-id-system/{SelectedSystemId}");

            if (responselp.IsSuccessStatusCode)
                listaPolaczen = await responselp.Content
                    .ReadFromJsonAsync<List<KonfPolaczenie>>() ?? new();
            else if (responselp.StatusCode == HttpStatusCode.NotFound)
                listaPolaczen = new();
            else
                listaPolaczen = new();
        }
        catch
        {
            listaPolaczen = new();
        }

        return statusZapisu;
    }


    private static (
        int Kat,
        bool OdbicieGoraDol,
        bool OdbicieLewoPrawo
    ) PobierzOrientacjeWidoku(string kierunek)
    {
        string k = (kierunek ?? "")
            .Trim()
            .ToLowerInvariant();

        // Normalizacja polskich znaków.
        k = k
            .Replace('ą', 'a')
            .Replace('ć', 'c')
            .Replace('ę', 'e')
            .Replace('ł', 'l')
            .Replace('ń', 'n')
            .Replace('ó', 'o')
            .Replace('ś', 's')
            .Replace('ź', 'z')
            .Replace('ż', 'z');

        // Góra – widok podstawowy.
        if (k.StartsWith("gor"))
            return (0, false, false);

        // Dół – obrót o 180 stopni.
        if (k.StartsWith("dol"))
            return (180, false, false);

        // Prawa – obrót o 270 stopni.
        if (k.StartsWith("praw"))
            return (270, false, false);

        // Lewa – obrót o 270 stopni i odbicie lewo/prawo.
        if (k.StartsWith("lew"))
            return (270, false, true);

        throw new ArgumentException(
            $"Nieznany kierunek budowy: '{kierunek}' " +
            $"(po normalizacji: '{k}'). " +
            "Dozwolone: lewa/prawa/góra/dół.");
    }



    private static int NormalizujKat(int kat)
    {
        return ((kat % 360) + 360) % 360;
    }



    private async Task<GuideDisplacementResult> PobierzWynikPrzesuniecia()
    {
        if (pierwszyModel == null ||
            drugiModel == null ||
            string.IsNullOrEmpty(SelectedModelPierwszyId) ||
            string.IsNullOrEmpty(SelectedModelDrugiId))
        {
            await _message.Warning(
                "❗ Nie wybrano obu modeli do połączenia. Błąd konfiguracji modelu :(");

            return null;
        }

        await Task.Yield();

        await JSRuntime.InvokeVoidAsync("svgHelper.stopMeasurement");
        Console.WriteLine("📏 Pomiar wyłączony");

        await Task.Delay(50);

        await JSRuntime.InvokeVoidAsync("svgHelper.centerAndFit");
        await Task.Delay(150);

        GuideDisplacementResult result;

        // =========================================================
        // POMIAR SUROWY
        // Ta funkcja NIE wykonuje korekty słupka stałego.
        // Pomiar jest wspólną bazą dla stron góra/dół/lewa/prawa.
        // Korekta osi jest wykonywana dopiero w SavePosition,
        // gdzie znamy konkretną zapisywaną stronę.
        // =========================================================

        if (boolStyczny)
        {
            var offset =
                await JSRuntime.InvokeAsync<GuideDisplacementResult>(
                    "svgHelper.getModel2Displacement");

            if (offset == null || !offset.success)
            {
                await _message.Warning(
                    "❗ Nie udało się odczytać przesunięcia modelu 2 (tryb styczny). Nie zapisano przesunięcia.",
                    5);

                return null;
            }

            result = new GuideDisplacementResult
            {
                success = offset.success,
                elementsFound = offset.elementsFound,
                przesuniecieX = offset.przesuniecieX,
                przesuniecieY = offset.przesuniecieY,
                osSymetriiDlaSlupkow =
                    pierwszyModel.PoziomOsSymetrii ?? 0,
                katObrotu = offset.katObrotu,
                odbicieLustrzane = offset.odbicieLustrzane,
                scale = 1
            };
        }
        else
        {
            result =
                await JSRuntime.InvokeAsync<GuideDisplacementResult>(
                    "svgHelper.measureGuideDisplacement");

            if (result?.success != true || !result.elementsFound)
            {
                await _message.Warning(
                    result?.error ??
                    "❗ Nie można znaleźć prowadnic w rysunku SVG");

                return null;
            }

            result.osSymetriiDlaSlupkow =
                pierwszyModel.PoziomOsSymetrii ?? 0;
        }

        // =========================================================
        // DIAGNOSTYKA MODELU 1
        // =========================================================

        Console.WriteLine(
            "[DIAG-MODEL1]\n" +
            $"Typ                 = {pierwszyModel.Typ}\n" +
            $"PionLewa            = {pierwszyModel.PionLewa:F3}\n" +
            $"PionPrawa           = {pierwszyModel.PionPrawa:F3}\n" +
            $"PionOsSymetrii      = {pierwszyModel.PionOsSymetrii:F3}\n" +
            $"PionOdSzybaOdZew    = {pierwszyModel.PionOdSzybaOdZew:F3}\n" +
            $"PoziomDol           = {pierwszyModel.PoziomDol:F3}\n" +
            $"PoziomGora          = {pierwszyModel.PoziomGora:F3}\n" +
            $"PoziomKorpus        = {pierwszyModel.PoziomKorpus:F3}\n" +
            $"PoziomOsSymetrii    = {pierwszyModel.PoziomOsSymetrii:F3}\n" +
            $"PoziomLiniaSzkla    = {pierwszyModel.PoziomLiniaSzkla:F3}\n" +
            $"PoziomLiniaOkucia   = {pierwszyModel.PoziomLiniaOkucia:F3}\n" +
            $"PoziomOsDormas      = {pierwszyModel.PoziomOsDormas:F3}"
        );

        Console.WriteLine(
            $"[DIAG-MEAS-RAW] " +
            $"Success={result.success}, " +
            $"ElementsFound={result.elementsFound}, " +
            $"RawX={result.przesuniecieX:F3}, " +
            $"RawY={result.przesuniecieY:F3}, " +
            $"KatObrotu={result.katObrotu:F1}, " +
            $"Odbicie={result.odbicieLustrzane}, " +
            $"Scale={result.scale:F4}, " +
            $"Error={result.error ?? "brak"}"
        );

        result.przesuniecieX =
            Math.Round(result.przesuniecieX, precyzjaZapisu);

        result.przesuniecieY =
            Math.Round(result.przesuniecieY, precyzjaZapisu);

        Console.WriteLine(
            $"========== POMIAR BAZOWY (BEZ KOREKTY) " +
            $"X={result.przesuniecieX:F3}, " +
            $"Y={result.przesuniecieY:F3} ==========\n");

        return result;
    }




    private async Task<string> GenerujSvgBezProwadnic()
    {
        try
        {
            // 1. Wymuś aktualizację UI
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);

            // 2. Sprawdź, czy SVG jest gotowy
            var isReady = await JSRuntime.InvokeAsync<bool>(
                "svgHelper.isSvgReady");

            if (!isReady)
            {
                Console.WriteLine("SVG not ready, waiting...");
                await Task.Delay(500);

                await JSRuntime.InvokeVoidAsync(
                    "svgHelper.centerAndFit");

                await Task.Delay(300);
            }

            // 3. Pobierz SVG przygotowane specjalnie do zapisu
            //    - bez prowadnic
            //    - bez elementów pomiarowych
            //    - transformacja model2 zostaje wypalona
            var svgForSave =
                await JSRuntime.InvokeAsync<string>(
                    "svgHelper.prepareSvgForSave");

            // 4. Walidacja
            if (string.IsNullOrEmpty(svgForSave) ||
                svgForSave.Length < 100)
