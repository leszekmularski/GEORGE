    private async Task OnPrzesuniecieChanged()
    {
        Console.WriteLine(
            $"OnPrzesuniecieChanged: X={edytowanePrzesuniecieX}, Y={edytowanePrzesuniecieY}, " +
            $"Xs={edytowanePrzesuniecieXStycznej}, Ys={edytowanePrzesuniecieYStycznej}");

        if (boolStyczny)
        {
            if (edytowanePrzesuniecieXStycznej != old_edytowanePrzesuniecieXStycznej ||
                edytowanePrzesuniecieYStycznej != old_edytowanePrzesuniecieYStycznej)
            {
                double dx = edytowanePrzesuniecieXStycznej - old_edytowanePrzesuniecieXStycznej;
                double dy = edytowanePrzesuniecieYStycznej - old_edytowanePrzesuniecieYStycznej;

                // Połączenia styczne pozostają bez zmian.
                Console.WriteLine($"📐 moveonlyedit(dx={dx}, dy={-dy})  [Y kartezjański → SVG]");
                await JSRuntime.InvokeVoidAsync("svgHelper.moveonlyedit", dx, -dy);
                await Task.Delay(10);

                old_edytowanePrzesuniecieXStycznej = edytowanePrzesuniecieXStycznej;
                old_edytowanePrzesuniecieYStycznej = edytowanePrzesuniecieYStycznej;
            }
        }
        else
        {
            if (edytowanePrzesuniecieX != old_edytowanePrzesuniecieX ||
                edytowanePrzesuniecieY != old_edytowanePrzesuniecieY)
            {
                double dx = edytowanePrzesuniecieX - old_edytowanePrzesuniecieX;
                double dy = edytowanePrzesuniecieY - old_edytowanePrzesuniecieY;

                // Wyjątek: Słupek stały -> Skrzydło, GÓRA, kąt 0°.
                // Skrzydło znajduje się pod słupkiem, dlatego wzrost
                // dodatniego przesunięcia Y ma odsunąć je w dół.
                // W SVG dół ma dodatni kierunek Y.
                string stronaNorm = NormalizujStrone(edytowanaStrona);

                bool odwrocKierunekY =
                    pierwszyModel?.Typ?.Contains(
                        "Słupek stały",
                        StringComparison.OrdinalIgnoreCase) == true
                    &&
                    drugiModel?.Typ?.Contains(
                        "Skrzydło",
                        StringComparison.OrdinalIgnoreCase) == true
                    &&
                    (stronaNorm == "góra" || stronaNorm == "gora")
                    &&
                    Math.Abs(edytowanyKat) < 0.001;

                bool slupRuchomyLewyPrawy =
                    pierwszyModel?.Typ?.Contains(
                        "Słupek ruchomy",
                        StringComparison.OrdinalIgnoreCase) == true
                    && (stronaNorm == "lewa" || stronaNorm == "prawa");

                // Dla słupka ruchomego po LEWEJ i PRAWEJ stronie
                // wzrost wartości Y ma ten sam kierunek: w SVG przesuwamy
                // model przeciwnie do osi kartezjańskiej.
                double svgDy = odwrocKierunekY ? dy : -dy;

                Console.WriteLine(
                    $"📐 moveonlyedit(dx={dx}, dy={svgDy}) | " +
                    $"delta formularza Y={dy}, wyjątek kierunku Y={odwrocKierunekY}, " +
                    $"słupek ruchomy L/P={slupRuchomyLewyPrawy}, " +
                    $"typ1={pierwszyModel?.Typ}, typ2={drugiModel?.Typ}, " +
                    $"strona={stronaNorm}, kąt={edytowanyKat}");

                await JSRuntime.InvokeVoidAsync(
                    "svgHelper.moveonlyedit",
                    dx,
                    svgDy);

                await Task.Delay(10);

                old_edytowanePrzesuniecieX = edytowanePrzesuniecieX;
                old_edytowanePrzesuniecieY = edytowanePrzesuniecieY;
            }
        }
    }

    bool czekajNaZapis = false;

    private async Task ZapiszEdycje()
    {
        if (!boolAdmin && !boolZmian)
        {
            _ = _notice.Warning(new()
            {
                Message = "Uwaga!!!!",
                Description = "Nie posiadasz uprawnień do zmiany danych!!",
                Placement = NotificationPlacement.BottomLeft
            });
            return;
        }

        if (czekajNaZapis) return;
        czekajNaZapis = true;

        try
        {
            bladEdycji = "";

            if (string.IsNullOrWhiteSpace(edytowanaStrona))
            {
                bladEdycji = "Wybierz stronę połączenia";
                return;
            }

            var png = await GenerujPngBezProwadnic();
            var svg = await GenerujSvgBezProwadnic();
            var aktualnySvg = await JSRuntime.InvokeAsync<string>("svgHelper.getCurrentSvgState");

            var safePng = png ?? Array.Empty<byte>();

            // Formularz przechowuje współrzędne fizyczne. Do bazy zapisujemy
            // współrzędne kanoniczne właściwe dla strony.
            bool slupStaly =
                pierwszyModel?.Typ?.Contains(
                    "Słupek stały",
                    StringComparison.OrdinalIgnoreCase) == true;

            bool swapXY = (edytowanaStrona is "prawa" or "lewa");

            double zapisX;
            double zapisY;
            double zapisXStycznej;
            double zapisYStycznej;

            bool slupRuchomy = pierwszyModel?.Typ?.Contains(
                "Słupek ruchomy",
                StringComparison.OrdinalIgnoreCase) == true;

            if (slupStaly)
            {
                if (boolStyczny)
                {
                    zapisX = edytowanePrzesuniecieX;
                    zapisY = edytowanePrzesuniecieY;

                    var styczne = PrzeliczSlupkaStalegoDoZapisu(
                        edytowanePrzesuniecieXStycznej,
                        edytowanePrzesuniecieYStycznej,
                        edytowanaStrona);

                    zapisXStycznej = styczne.X;
                    zapisYStycznej = styczne.Y;
                }
                else
                {
                    var zwykle = PrzeliczSlupkaStalegoDoZapisu(
                        edytowanePrzesuniecieX,
                        edytowanePrzesuniecieY,
                        edytowanaStrona);

                    zapisX = zwykle.X;
                    zapisY = zwykle.Y;
                    zapisXStycznej = edytowanePrzesuniecieXStycznej;
                    zapisYStycznej = edytowanePrzesuniecieYStycznej;
                }
            }
            else if (slupRuchomy)
            {
                if (boolStyczny)
                {
                    zapisX = edytowanePrzesuniecieX;
                    zapisY = edytowanePrzesuniecieY;

                    var styczne = PrzeliczSlupkaRuchomegoDoZapisu(
                        edytowanePrzesuniecieXStycznej,
                        edytowanePrzesuniecieYStycznej,
                        edytowanaStrona);

                    zapisXStycznej = styczne.X;
                    zapisYStycznej = styczne.Y;
                }
                else
                {
                    var zwykle = PrzeliczSlupkaRuchomegoDoZapisu(
                        edytowanePrzesuniecieX,
                        edytowanePrzesuniecieY,
                        edytowanaStrona);

                    zapisX = zwykle.X;
                    zapisY = zwykle.Y;
                    zapisXStycznej = edytowanePrzesuniecieXStycznej;
                    zapisYStycznej = edytowanePrzesuniecieYStycznej;
                }
            }
            else
            {
                // Zachowanie dotychczasowej konwersji dla pozostałych modeli.
                zapisX = swapXY ? edytowanePrzesuniecieY : edytowanePrzesuniecieX;
                zapisY = swapXY ? edytowanePrzesuniecieX : edytowanePrzesuniecieY;
                zapisXStycznej = swapXY ? edytowanePrzesuniecieYStycznej : edytowanePrzesuniecieXStycznej;
                zapisYStycznej = swapXY ? edytowanePrzesuniecieXStycznej : edytowanePrzesuniecieYStycznej;
            }

            Console.WriteLine(
                $"[ZapiszEdycje] strona={edytowanaStrona}, slupStaly={slupStaly}, " +
                $"slupRuchomy={slupRuchomy}, X={zapisX}, Y={zapisY}, " +
                $"Xs={zapisXStycznej}, Ys={zapisYStycznej}");

            var updateDto = new
            {
                RowId = edytowanyRowId,
                RowIdModelu = SelectedModelPierwszyId,
                RowIdModeluDrugi = SelectedModelDrugiId,
                OpisPolaczenia = edytowanyOpis,
                StronaPolaczenia = edytowanaStrona,

                PrzesuniecieX = zapisX,
                PrzesuniecieY = zapisY,
                PrzesuniecieXStycznej = zapisXStycznej,
                PrzesuniecieYStycznej = zapisYStycznej,

                ZapisanyKat = edytowanyKat,
                RysunekPrzekroju = !boolStyczny ? safePng : Array.Empty<byte>(),
                RysunekPrzekrojuStyczny = boolStyczny ? safePng : Array.Empty<byte>(),
                Svg = svg,
                KonfiguracjaSVG = aktualnySvg,
                KierunekBudowy = edytowanePolaczenie?.KierunekBudowy,
                Uwagi = $"Ostatnia zmiana: {DateTime.Now} - [{user}] - Zmiana po edycji",
                DodatkowyWarunek = boolStyczny ? "STYCZNE" : "PRZEKROJE",
                ElementZewnetrznyToSlupek = old_ElementZewnetrznyToSlupek,
                ElementWewnetrznyToSlupek = old_ElementWewnetrznyToSlupek
            };

            Console.WriteLine($"🔧 Zapisywanie zmian dla RowId: {edytowanyRowId}");

            var response = await Http.PutAsJsonAsync($"api/KonfPolaczenie/{edytowanyRowId}", updateDto);

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("✅ Zmiany zapisane pomyślnie");
                await OdswiezDane();
                ZamknijModalEdycji();
                activeKey = "0";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                bladEdycji = $"Błąd zapisu: {error}";
                Console.WriteLine($"❌ Błąd zapisu: {response.StatusCode} - {error}");
            }
        }
        catch (Exception ex)
        {
            bladEdycji = $"Wystąpił błąd: {ex.Message}";
            Console.WriteLine($"❌ Wyjątek: {ex.Message}");
        }
        finally
        {
            czekajNaZapis = false;
        }
    }

    private IEnumerable<dynamic> FiltrowanePolaczenia
    {
        get
        {
            if (listaPolaczen == null)
                return Enumerable.Empty<dynamic>();

            return filtrPolaczen switch
            {
                "STYCZNE" => listaPolaczen
                    .Where(x => x.DodatkowyWarunek == "STYCZNE"),

                "PRZEKROJE" => listaPolaczen
                    .Where(x => x.DodatkowyWarunek == "PRZEKROJE"),

                _ => listaPolaczen
            };
        }
    }

    // Uprawnienia
    private bool boolOdczyt = false;
    private bool boolZmian = false;
    private bool boolZapis = false;
    private bool boolUsuniecia = false;
    private bool boolAdmin = false;
    private string RowIdPracownika = "---";
    private string RowIdDzal = "";
    private string user = "";
    private List<UprawnieniaPracownikaViewModel>? uprawnienia;

    private async Task Laduj_Uprawnienia()
    {

        user = await LocalStorage.GetStringAsync("user");

        string nazwaTabeli = "KonfPolaczenie";

        if (user == null)
        {
            return;
        }

        try
        {
            uprawnienia = await Http.GetFromJsonAsync<List<UprawnieniaPracownikaViewModel>>($"api/ZwrocSatus/{user}/{nazwaTabeli}");
        }
        catch (System.Net.Http.HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            Console.WriteLine("Brak danych!!!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Błąd!!! Info:{ex.Message}");
        }

        if (uprawnienia != null)
        {
            if (uprawnienia.Count > 0)
            {

                var znalezioneElementy = uprawnienia.Where(uprawnienie => uprawnienie.TableName == nazwaTabeli);

                if (znalezioneElementy.Count() > 0)
                {
                    var szuk = znalezioneElementy.FirstOrDefault(x => x.TableName == nazwaTabeli);

                    if (szuk != null)
                    {
                        boolOdczyt = szuk.Odczyt;
                        boolZmian = szuk.Zmiana;
                        boolUsuniecia = szuk.Usuniecie;
                        boolAdmin = szuk.Administrator;
                        boolZapis = szuk.Zapis;
                        RowIdPracownika = szuk.RowId;
                        RowIdDzal = szuk.RowIdDzialu;

                    }
                }
            }
        }
    }

