            window.svgHelper.exportSvgStringAsPng = function(svgString) {
            return new Promise((resolve, reject) => {
                try {
                    const canvas = document.createElement('canvas');
                    canvas.width = 600;
                    canvas.height = 600;
                    const ctx = canvas.getContext('2d');

                    const img = new Image();
                    const svgBlob = new Blob([svgString], { type: 'image/svg+xml;charset=utf-8' });
                    const url = URL.createObjectURL(svgBlob);

                    img.onload = () => {
                        ctx.drawImage(img, 0, 0);
                        URL.revokeObjectURL(url);
                        const pngDataUrl = canvas.toDataURL('image/png');
                        resolve(pngDataUrl);
                    };

                    img.onerror = (err) => {
                        URL.revokeObjectURL(url);
                        reject(new Error('Nie udało się załadować SVG do PNG'));
                    };

                    img.src = url;
                } catch (e) {
                    reject(e);
                }
            });
        };

            function bakeModel2TransformInClone(model2) {
        try {
            if (!model2) {
                console.warn("[bakeModel2TransformInClone] Brak model2");
                return false;
            }

            const transform = model2.getAttribute("transform") || "";

            console.log(
                "[bakeModel2TransformInClone] Aktualny transform:",
                transform
            );

            if (!transform.trim()) {
                console.log(
                    "[bakeModel2TransformInClone] Brak transformacji."
                );
                return true;
            }

            /*
             * UWAGA:
             * model2 znajduje się już w KLONIE.
             *
             * getCTM() zwraca transformację względem
             * dokumentu SVG.
             */
            const ctm = model2.getCTM();

            if (!ctm) {
                console.warn(
                    "[bakeModel2TransformInClone] Nie udało się pobrać CTM."
                );
                return false;
            }

            /*
             * Pobieramy wszystkie elementy geometryczne
             * znajdujące się wewnątrz model2.
             */
            const elements = model2.querySelectorAll(
                "line, path, circle, rect, ellipse, polygon, polyline"
            );

            const matrixValues =
                `matrix(${ctm.a} ${ctm.b} ${ctm.c} ${ctm.d} ${ctm.e} ${ctm.f})`;

            elements.forEach(el => {

                const existingTransform =
                    el.getAttribute("transform");

                if (existingTransform) {

                    el.setAttribute(
                        "transform",
                        `${matrixValues} ${existingTransform}`
                    );

                } else {

                    el.setAttribute(
                        "transform",
                        matrixValues
                    );
                }
            });

            /*
             * Usuwamy transformację z model2.
             */
            model2.removeAttribute("transform");

            console.log(
                "[bakeModel2TransformInClone] ✅ Transformacja została wypalona w klonie."
            );

            return true;

        } catch (e) {

            console.error(
                "[bakeModel2TransformInClone] ❌ Błąd:",
                e
            );

            return false;
        }
    }

