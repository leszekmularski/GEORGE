                    // 1. Pobierz elementy SVG
                    const svgElement = document.querySelector(".scaled-svg");
                    const svgContent = svgElement?.querySelector("#zoom-group");

                    if (!svgElement || !svgContent) {
                        console.error("SVG elements not found");
                        return "";
                    }

                    // 2. Utwórz głęboką kopię SVG
                    const clone = svgElement.cloneNode(true);
                    const cloneContent = clone.querySelector("#zoom-group");

                    if (!cloneContent) {
                        console.error("zoom-group not found in clone");
                        return "";
                    }

                    // 3. Usuń niepotrzebne elementy (prowadnice, pomiary)
                    const elementsToRemove = cloneContent.querySelectorAll(
                        '[data-name^="guide-line-"], ' +
                        '[id^="guide-line-"], ' +
                        '.measurement-line, ' +
                        '.measurement-text'
                    );

                    elementsToRemove.forEach(el => el.remove());
                    console.log(`Removed ${elementsToRemove.length} guide/measurement elements`);

                    // 4. Pobierz aktualną transformację
                    const currentTransform = svgContent.getAttribute("transform") || "";
                    console.log("Current transform:", currentTransform);

                    // 5. Przygotuj nowy SVG
                    const newSvg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                    newSvg.setAttribute("xmlns", "http://www.w3.org/2000/svg");
                    newSvg.setAttribute("width", "600");
                    newSvg.setAttribute("height", "600");
                    newSvg.setAttribute("viewBox", "0 0 600 600");
                    newSvg.setAttribute("preserveAspectRatio", "xMidYMid meet");

                    // 6. Dodaj grupę contentu z zachowaniem transformacji
                    const contentGroup = document.createElementNS("http://www.w3.org/2000/svg", "g");
                    contentGroup.setAttribute("id", "zoom-group");
                    contentGroup.setAttribute("transform", currentTransform);

                    // Przenieś wszystkie dzieci
                    while (cloneContent.firstChild) {
                        contentGroup.appendChild(cloneContent.firstChild);
                    }

                    newSvg.appendChild(contentGroup);

                    // 7. Serializacja do stringa
                    const serializer = new XMLSerializer();
                    let svgString = serializer.serializeToString(newSvg);

                    // 8. Oczyszczanie - usuń niepotrzebne atrybuty
                    svgString = svgString.replace(/\s*data-name="[^"]*"/g, '');
                    svgString = svgString.replace(/\s*data-original-x="[^"]*"/g, '');
                    svgString = svgString.replace(/\s*data-original-y="[^"]*"/g, '');

                    // 9. Sformatuj ładnie (opcjonalnie)
                    svgString = svgString
                        .replace(/><\//g, '>\n</')  // Dodaj nowe linie między tagami
                        .replace(/></g, '>\n<');     // Dodaj nowe linie między sąsiednimi tagami

                    console.log("SVG export successful, length:", svgString.length);
                    return svgString;

                } catch (e) {
                    console.error("SVG export error:", e);
                    return "";
                }
            };

