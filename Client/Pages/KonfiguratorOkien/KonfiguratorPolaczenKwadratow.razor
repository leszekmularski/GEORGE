            // 🔁 Lustrzane odbicie TYLKO drugiego modelu w poziomie (z wypalaniem)
        window.svgHelper.flipSecondModelHorizontally = function() {
            const model2 = document.querySelector("#model2");
            if (!model2) {
                console.warn("[flipSecondModelHorizontally] Nie znaleziono #model2");
                return false;
            }

            const currentTransform = model2.getAttribute("transform") || "";

            // Sprawdź czy już jest odbicie
            const hasFlip = currentTransform.includes("scale(-1, 1)") ||
                            currentTransform.includes("scale(1, -1)");

            if (hasFlip) {
                // Wypal odbicie do współrzędnych
                window.svgHelper.bakeHorizontalFlipModel2();
                console.log("[flipSecondModelHorizontally] Wypalono odbicie lustrzane");
                return false;
            } else {
                // Dodaj odbicie poziome (względem osi Y przechodzącej przez środek modelu)
                const bbox = model2.getBBox();
                const cx = bbox.x + bbox.width / 2;

                // Zachowaj istniejącą transformację i dodaj odbicie
                const newTransform = currentTransform +
                    ` translate(${2 * cx}, 0) scale(-1, 1)`;

                model2.setAttribute("transform", newTransform);
                console.log("[flipSecondModelHorizontally] Dodano odbicie lustrzane");
                return true;
            }
        };

        // ============================================================
        // WYPALENIE ODBICIA POZIOMEGO DO WSPÓŁRZĘDNYCH SVG
        // ============================================================

        window.svgHelper.bakeHorizontalFlipModel2 = function() {

            console.log("🔥 Wypalam odbicie poziome model2 do współrzędnych SVG...");

            const model2 = document.querySelector("#model2");

            if (!model2) {
                console.error("❌ Nie znaleziono #model2");
                return false;
            }

            const transform = model2.getAttribute("transform") || "";

            // Szukamy odbicia poziomego:
            // translate(2*cx, 0) scale(-1, 1)
            const flipRegex =
                /translate\s*\(\s*(-?[\d.]+)\s*,\s*0\s*\)\s*scale\s*\(\s*-1\s*,\s*1\s*\)/;

            const match = transform.match(flipRegex);

            if (!match) {
                console.log("ℹ️ Nie znaleziono odbicia poziomego do wypalenia.");
                return false;
            }

            const translateX = parseFloat(match[1]);

            // Dla:
            // translate(2*cx, 0) scale(-1, 1)
            //
            // wynik:
            // x' = 2*cx - x
            // y' = y
            //
            const offsetX = translateX;

            console.log(`🪞 Parametr odbicia: offsetX=${offsetX}`);

            // ----------------------------------------------------------
            // 1. Pobierz wszystkie elementy geometryczne
            // ----------------------------------------------------------

            const elements = model2.querySelectorAll(
                "line, circle, rect, ellipse, polygon, polyline, path"
            );

            elements.forEach(element => {

                try {

                    const tag = element.tagName.toLowerCase();

                    switch (tag) {

                        // ------------------------------------------------
                        // LINE
                        // ------------------------------------------------
                        case "line": {

                            let x1 = parseFloat(element.getAttribute("x1"));
                            let x2 = parseFloat(element.getAttribute("x2"));

                            if (Number.isFinite(x1)) {
                                element.setAttribute(
                                    "x1",
                                    formatSvgNumber(offsetX - x1)
                                );
                            }

                            if (Number.isFinite(x2)) {
                                element.setAttribute(
                                    "x2",
                                    formatSvgNumber(offsetX - x2)
                                );
                            }

                            break;
                        }

                        // ------------------------------------------------
                        // CIRCLE
                        // ------------------------------------------------
                        case "circle": {

                            let cx = parseFloat(element.getAttribute("cx"));

                            if (Number.isFinite(cx)) {
                                element.setAttribute(
                                    "cx",
                                    formatSvgNumber(offsetX - cx)
                                );
                            }

                            break;
                        }

                        // ------------------------------------------------
                        // RECT
                        // ------------------------------------------------
                        case "rect": {

                            let x = parseFloat(element.getAttribute("x"));
                            let width = parseFloat(element.getAttribute("width"));

                            if (
                                Number.isFinite(x) &&
                                Number.isFinite(width)
                            ) {

                                const newX =
                                    offsetX - x - width;

                                element.setAttribute(
                                    "x",
                                    formatSvgNumber(newX)
                                );
                            }

                            break;
                        }

                        // ------------------------------------------------
                        // ELLIPSE
                        // ------------------------------------------------
                        case "ellipse": {

                            let cx = parseFloat(element.getAttribute("cx"));

                            if (Number.isFinite(cx)) {

                                element.setAttribute(
                                    "cx",
                                    formatSvgNumber(offsetX - cx)
                                );
                            }

                            break;
                        }

                        // ------------------------------------------------
                        // POLYGON / POLYLINE
                        // ------------------------------------------------
                        case "polygon":
                        case "polyline": {

                            const points =
                                element.getAttribute("points");

                            if (!points)
                                break;

                            const tokens =
                                points.trim().split(/[\s,]+/);

                            const result = [];

                            for (let i = 0; i < tokens.length; i += 2) {

                                const x = parseFloat(tokens[i]);
                                const y = parseFloat(tokens[i + 1]);

                                if (
                                    !Number.isFinite(x) ||
                                    !Number.isFinite(y)
                                ) {
                                    continue;
                                }

                                result.push(
                                    formatSvgNumber(offsetX - x),
                                    formatSvgNumber(y)
                                );
                            }

                            element.setAttribute(
                                "points",
                                result.join(" ")
                            );

                            break;
                        }

                        // ------------------------------------------------
                        // PATH
                        // ------------------------------------------------
                        case "path": {

                            const d = element.getAttribute("d");

                            if (!d)
                                break;

                            const newD =
                                flipSvgPathHorizontal(d, offsetX);

                            element.setAttribute("d", newD);

                            break;
                        }
                    }

                }
                catch (err) {

                    console.error(
                        `❌ Błąd podczas wypalania ${element.tagName}:`,
                        err
                    );
                }

            });

            // ----------------------------------------------------------
            // 2. Usuń TYLKO transformację odbicia
            // ----------------------------------------------------------

            const newTransform =
                transform.replace(flipRegex, "").trim();

            if (newTransform) {
                model2.setAttribute(
                    "transform",
                    normalizeSvgTransform(newTransform)
                );
            }
            else {
                model2.removeAttribute("transform");
            }

            console.log(
                `✅ Odbicie zostało wypalone. Pozostała transformacja: ${
                    model2.getAttribute("transform") || "(brak)"
                }`
            );

            return true;
        };


        // ============================================================
        // Pomocnicze formatowanie liczb
        // ============================================================

        function formatSvgNumber(value) {

            if (!Number.isFinite(value))
                return "0";

            return Number(value.toFixed(6)).toString();
        }


        // ============================================================
        // Normalizacja transform
        // ============================================================

        function normalizeSvgTransform(transform) {

            return transform
                .replace(/,/g, " ")
                .replace(/\s+/g, " ")
                .trim();
        }


        // ============================================================
        // ODBICIE PATH W POZIOMIE
        // ============================================================

        function flipSvgPathHorizontal(d, offsetX) {

            const tokens =
                d.match(/[a-zA-Z]|[-+]?(?:\d*\.\d+|\d+\.?)(?:[eE][-+]?\d+)?/g);

            if (!tokens)
                return d;

            const commandParams = {

                M: 2,
                L: 2,
                H: 1,
                V: 1,
                C: 6,
                S: 4,
                Q: 4,
                T: 2,
                A: 7,
                Z: 0
            };

            let result = [];

            let i = 0;
            let command = null;

            let currentX = 0;
            let currentY = 0;

            let startX = 0;
            let startY = 0;

            while (i < tokens.length) {

                if (/[a-zA-Z]/.test(tokens[i])) {

                    command = tokens[i];
                    i++;

                    if (command.toUpperCase() === "Z") {

                        result.push("Z");

                        currentX = startX;
                        currentY = startY;

                        continue;
                    }
                }

                if (!command)
                    break;

                const upper = command.toUpperCase();
                const relative = command === command.toLowerCase();

                const count = commandParams[upper];

                if (count === undefined)
                    break;

                if (i + count > tokens.length)
                    break;

                const values = [];

                for (let j = 0; j < count; j++) {
                    values.push(parseFloat(tokens[i + j]));
                }

                i += count;

                switch (upper) {

                    // --------------------------------------------------
                    // M
                    // --------------------------------------------------

                    case "M": {

                        let x = values[0];
                        let y = values[1];

                        if (relative) {
                            x += currentX;
                            y += currentY;
                        }

                        const newX = offsetX - x;

                        result.push(
                            "M",
                            formatSvgNumber(newX),
                            formatSvgNumber(y)
                        );

                        currentX = x;
                        currentY = y;

                        startX = x;
                        startY = y;

                        break;
                    }

                    // --------------------------------------------------
                    // L
                    // --------------------------------------------------

                    case "L": {

                        let x = values[0];
                        let y = values[1];

                        if (relative) {
                            x += currentX;
                            y += currentY;
                        }

                        const newX = offsetX - x;

                        result.push(
                            "L",
                            formatSvgNumber(newX),
                            formatSvgNumber(y)
                        );

                        currentX = x;
                        currentY = y;

                        break;
                    }

                    // --------------------------------------------------
                    // H -> L
                    // --------------------------------------------------

                    case "H": {

                        let x = values[0];

                        if (relative)
                            x += currentX;

                        const newX = offsetX - x;

                        result.push(
                            "L",
                            formatSvgNumber(newX),
                            formatSvgNumber(currentY)
                        );

                        currentX = x;

                        break;
                    }

                    // --------------------------------------------------
                    // V -> L
                    // --------------------------------------------------

                    case "V": {

                        let y = values[0];

                        if (relative)
                            y += currentY;

                        result.push(
                            "L",
                            formatSvgNumber(offsetX - currentX),
                            formatSvgNumber(y)
                        );

                        currentY = y;

                        break;
                    }

                    // --------------------------------------------------
                    // C
                    // --------------------------------------------------

                    case "C": {

                        let x1 = values[0];
                        let y1 = values[1];

                        let x2 = values[2];
                        let y2 = values[3];

                        let x = values[4];
                        let y = values[5];

                        if (relative) {

                            x1 += currentX;
                            y1 += currentY;

                            x2 += currentX;
                            y2 += currentY;

                            x += currentX;
                            y += currentY;
                        }

                        result.push(
                            "C",

                            formatSvgNumber(offsetX - x1),
                            formatSvgNumber(y1),

                            formatSvgNumber(offsetX - x2),
                            formatSvgNumber(y2),

                            formatSvgNumber(offsetX - x),
                            formatSvgNumber(y)
                        );

                        currentX = x;
                        currentY = y;

                        break;
                    }

                    // --------------------------------------------------
                    // S
                    // --------------------------------------------------

                    case "S": {

                        let x2 = values[0];
                        let y2 = values[1];

                        let x = values[2];
                        let y = values[3];

                        if (relative) {

                            x2 += currentX;
                            y2 += currentY;

                            x += currentX;
                            y += currentY;
                        }

                        result.push(
                            "S",

                            formatSvgNumber(offsetX - x2),
                            formatSvgNumber(y2),

                            formatSvgNumber(offsetX - x),
                            formatSvgNumber(y)
                        );

                        currentX = x;
                        currentY = y;

                        break;
                    }

                    // --------------------------------------------------
                    // Q
                    // --------------------------------------------------

                    case "Q": {

                        let x1 = values[0];
                        let y1 = values[1];

                        let x = values[2];
                        let y = values[3];

                        if (relative) {

                            x1 += currentX;
                            y1 += currentY;

                            x += currentX;
                            y += currentY;
                        }

                        result.push(
                            "Q",

                            formatSvgNumber(offsetX - x1),
                            formatSvgNumber(y1),

                            formatSvgNumber(offsetX - x),
                            formatSvgNumber(y)
                        );

                        currentX = x;
                        currentY = y;

                        break;
                    }

                    // --------------------------------------------------
                    // T
                    // --------------------------------------------------

                    case "T": {

                        let x = values[0];
                        let y = values[1];

                        if (relative) {

                            x += currentX;
                            y += currentY;
                        }

                        result.push(
                            "T",
                            formatSvgNumber(offsetX - x),
                            formatSvgNumber(y)
                        );

                        currentX = x;
                        currentY = y;

                        break;
                    }

                    // --------------------------------------------------
                    // A - łuk
                    // --------------------------------------------------

                    case "A": {

                        let rx = values[0];
                        let ry = values[1];
                        let rotation = values[2];
                        let largeArc = values[3];
                        let sweep = values[4];

                        let x = values[5];
                        let y = values[6];

                        if (relative) {

                            x += currentX;
                            y += currentY;
                        }

                        // Odbicie względem osi pionowej:
                        //
                        // rx - bez zmian
                        // ry - bez zmian
                        // rotation -> -rotation
                        // sweep -> odwrotność

                        const newRotation =
                            -rotation;

                        const newSweep =
                            sweep ? 0 : 1;

                        result.push(
                            "A",

                            formatSvgNumber(rx),
                            formatSvgNumber(ry),
                            formatSvgNumber(newRotation),

                            formatSvgNumber(largeArc),
                            formatSvgNumber(newSweep),

                            formatSvgNumber(offsetX - x),
                            formatSvgNumber(y)
                        );

                        currentX = x;
                        currentY = y;

                        break;
                    }

                    default:
                        console.warn(
                            "⚠️ Nieobsługiwana komenda PATH:",
                            upper
                        );

                        break;
                }
            }

            return result.join(" ");
        }

        // 📌 Przesuń przy edycji
           window.svgHelper.moveonlyedit = function(dx, dy) {
        const model2 = document.querySelector("#model2");
        if (!model2) return;

        const currentTransform = model2.getAttribute("transform") || "";
        console.log("🔄 moveonlyedit - aktualna transformacja:", currentTransform);
        console.log("📐 Przesunięcie o:", dx, dy);

        // Parsowanie aktualnej transformacji
        let translateX = 0, translateY = 0;
        let rotation = 0, rotCenter = null;
        let hasFlipX = false, hasFlipY = false;
        let flipXOffset = 0, flipYOffset = 0;

        // Wyciągnij translację
        const translateMatch = currentTransform.match(/translate\(([-\d.]+)[,\s]+([-\d.]+)\)/);
        if (translateMatch) {
            translateX = parseFloat(translateMatch[1]);
            translateY = parseFloat(translateMatch[2]);
        }

        // Wyciągnij rotację
        const rotateMatch = currentTransform.match(/rotate\(([-\d.]+)(?:[,\s]+([-\d.]+)[,\s]+([-\d.]+))?\)/);
        if (rotateMatch) {
            rotation = parseFloat(rotateMatch[1]);
            if (rotateMatch[2] && rotateMatch[3]) {
                rotCenter = { x: parseFloat(rotateMatch[2]), y: parseFloat(rotateMatch[3]) };
            }
        }

        // Sprawdź i zachowaj odbicie poziome (scale(-1, 1))
        const flipXMatch = currentTransform.match(/translate\(([-\d.]+)[,\s]+0\)\s*scale\(-1[,\s]+1\)/);
        if (flipXMatch) {
            hasFlipX = true;
            flipXOffset = parseFloat(flipXMatch[1]);
            console.log("🔍 Znaleziono odbicie poziome, offset:", flipXOffset);
        }

        // Sprawdź i zachowaj odbicie pionowe (scale(1, -1))
        const flipYMatch = currentTransform.match(/translate\(0[,\s]+([-\d.]+)\)\s*scale\(1[,\s]+-1\)/);
        if (flipYMatch) {
            hasFlipY = true;
            flipYOffset = parseFloat(flipYMatch[1]);
            console.log("🔍 Znaleziono odbicie pionowe, offset:", flipYOffset);
        }

        // Aktualizuj pozycję z uwzględnieniem skali
        const scale = window.svgHelper.zoomLevel || 1;

        // WAŻNE: Jeśli mamy odbicie poziome, odwróć kierunek przesunięcia X
        let adjustedDx = dx;
        let adjustedDy = dy;

        if (hasFlipX) {
            adjustedDx = -dx; // Odwróć kierunek X przy odbiciu poziomym
            console.log("🔄 Odwracam kierunek X z powodu odbicia poziomego");
        }

        if (hasFlipY) {
            adjustedDy = -dy; // Odwróć kierunek Y przy odbiciu pionowym
            console.log("🔄 Odwracam kierunek Y z powodu odbicia pionowego");
        }

        translateX += adjustedDx / scale;
        translateY += adjustedDy / scale;

        console.log("📐 Nowa translacja:", translateX, translateY);

        // Zbuduj nową transformację
        let newTransform = `translate(${translateX}, ${translateY})`;

        // Dodaj obrót jeśli istnieje
        if (rotation) {
            if (rotCenter) {
                newTransform += ` rotate(${rotation}, ${rotCenter.x}, ${rotCenter.y})`;
            } else {
                newTransform += ` rotate(${rotation})`;
            }
        }

        // Dodaj odbicie poziome jeśli istnieje
        if (hasFlipX) {
            newTransform += ` translate(${flipXOffset}, 0) scale(-1, 1)`;
        }

        // Dodaj odbicie pionowe jeśli istnieje
        if (hasFlipY) {
            newTransform += ` translate(0, ${flipYOffset}) scale(1, -1)`;
        }

        console.log("✅ Nowa transformacja:", newTransform);

        model2.setAttribute("transform", newTransform);

        // Zwróć aktualną pozycję
        return { x: translateX * scale, y: translateY * scale };
    };

        // Pobierz aktualną pozycję model2
    window.svgHelper.getModel2Position = function() {
        const model2 = document.querySelector("#model2");
        if (!model2) return null;

        const transform = model2.getAttribute("transform") || "";
        const translateMatch = transform.match(/translate\(([-\d.]+)[,\s]+([-\d.]+)\)/);

        if (translateMatch) {
            return {
                x: parseFloat(translateMatch[1]),
                y: parseFloat(translateMatch[2]),
                transform: transform
            };
        }

        return {
            x: 0,
            y: 0,
            transform: transform
        };
    };

    // Funkcja do ładowania SVG z zachowaniem transformacji
        window.svgHelper.loadSvgPreserveTransform = function(svgString) {
        try {
            console.log("🔄 loadSvgPreserveTransform - start");

            // Znajdź kontener
            let container = document.querySelector('.scaled-svg');
            if (!container) {
                container = document.querySelector('.scaled-svg-container');
            }

            if (!container) {
                console.error("❌ Nie znaleziono kontenera");
                return false;
            }

            console.log("✅ Znaleziono kontener:", container.className);

            // Parsuj string SVG
            const parser = new DOMParser();
            const svgDoc = parser.parseFromString(svgString, "image/svg+xml");

            // Sprawdź błędy parsowania
            const parserError = svgDoc.querySelector("parsererror");
            if (parserError) {
                console.error("❌ Błąd parsowania SVG");
                return false;
            }

            // Znajdź nowy SVG
            let newSvg = svgDoc.querySelector("svg");
            if (!newSvg) {
                const divWithSvg = svgDoc.querySelector("div");
                if (divWithSvg) {
                    newSvg = divWithSvg.querySelector("svg");
                }
            }

            if (!newSvg) {
                console.error("❌ Nie znaleziono <svg> w stringu");
                return false;
            }

            // Zapisz transformacje z nowego SVG
            const newZoomGroup = newSvg.querySelector("#zoom-group");
            const newModel1 = newSvg.querySelector("#model1");
            const newModel2 = newSvg.querySelector("#model2");

            const zoomTransform = newZoomGroup?.getAttribute("transform") || "";
            const model1Transform = newModel1?.getAttribute("transform") || "";
            const model2Transform = newModel2?.getAttribute("transform") || "";

            console.log("📐 Transformacje z zapisu:", {
                zoomGroup: zoomTransform,
                model1: model1Transform,
                model2: model2Transform
            });

            // Wyczyść kontener i wstaw nowy SVG
            container.innerHTML = '';
            container.appendChild(newSvg);

            // Upewnij się, że transformacje są zachowane
            const finalZoomGroup = container.querySelector("#zoom-group");
            const finalModel1 = container.querySelector("#model1");
            const finalModel2 = container.querySelector("#model2");

            if (finalZoomGroup && zoomTransform) {
                finalZoomGroup.setAttribute("transform", zoomTransform);
            }

            if (finalModel1 && model1Transform) {
                finalModel1.setAttribute("transform", model1Transform);
            }

            if (finalModel2 && model2Transform) {
                finalModel2.setAttribute("transform", model2Transform);
            } else if (finalModel2) {
                // Jeśli model2 nie ma transformacji, ustaw domyślną
                finalModel2.setAttribute("transform", "translate(0, 0)");
            }

            console.log("✅ SVG załadowane z zachowaniem transformacji");
            return true;
        } catch (e) {
            console.error("❌ Błąd w loadSvgPreserveTransform:", e);
            return false;
        }
    };

    window.svgHelper.getCurrentSvgStateWithTransform = function() {
        try {
            const container = document.querySelector(".scaled-svg") ||
                             document.querySelector(".scaled-svg-container");
            if (!container) return "";

            const clone = container.cloneNode(true);

            // Usuń prowadnice
            clone.querySelectorAll(
                '[data-name^="guide-line-"], ' +
                '[id^="guide-line-"], ' +
                '.measurement-line, ' +
                '.measurement-text'
            ).forEach(el => el.remove());

            // ZACHOWAJ transformację model2 bez zmian
            const model2Clone = clone.querySelector("#model2");
            const model2Original = document.querySelector("#model2");

            if (model2Clone && model2Original) {
                const transform = model2Original.getAttribute("transform") || "";
                if (transform) {
                    model2Clone.setAttribute("transform", transform);
                }
            }

            // Oczyść atrybuty pomocnicze
            clone.querySelectorAll("*").forEach(el => {
                el.removeAttribute("data-name");
                el.removeAttribute("data-original-x");
                el.removeAttribute("data-original-y");
            });

            return new XMLSerializer().serializeToString(clone);
        } catch (e) {
            console.error("getCurrentSvgStateWithTransform error:", e);
            return "";
        }
    };

    // Funkcja do debugowania struktury DOM
    window.svgHelper.debugDomStructure = function() {
        const result = {
            bodyChildren: [],
            svgElements: [],
            modalElements: []
        };

        // Sprawdź wszystkie dzieci body
        Array.from(document.body.children).forEach(child => {
            result.bodyChildren.push({
                tag: child.tagName,
                id: child.id,
                className: child.className
            });
        });

        // Znajdź wszystkie elementy SVG
        document.querySelectorAll('svg').forEach(svg => {
            result.svgElements.push({
                id: svg.id,
                className: svg.className,
                parent: svg.parentElement?.className
            });
        });

        // Znajdź elementy modal
        document.querySelectorAll('[class*="modal"]').forEach(modal => {
            result.modalElements.push({
                className: modal.className,
                children: modal.children.length
            });
        });

        console.log('🔍 Debug DOM Structure:', result);
        return result;
    };

        // Funkcja do debugowania model2
    window.svgHelper.debugModel2 = function() {
        const model2 = document.querySelector('#model2');
        if (!model2) {
            console.error('❌ Model2 nie istnieje');
            return null;
        }

        console.log('📊 Model2 debug:');
        console.log('  - Tag:', model2.tagName);
        console.log('  - Transform:', model2.getAttribute('transform'));
        console.log('  - Dzieci:', model2.children.length);
        console.log('  - BBox:', model2.getBBox());
        console.log('  - HTML:', model2.innerHTML.substring(0, 200));

        return {
            exists: true,
            transform: model2.getAttribute('transform'),
            childrenCount: model2.children.length,
            bbox: model2.getBBox(),
            html: model2.innerHTML.substring(0, 200)
        };
    };
</script>

