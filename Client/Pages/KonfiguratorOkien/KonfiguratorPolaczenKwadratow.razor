                toffsetX = old_edytowanePrzesuniecieX;
                toffsetY = old_edytowanePrzesuniecieY;
            }

            Console.WriteLine($"Generuję nowy SVG. Model1: {pierwszyModel.Nazwa}, offsetX: {toffsetX}, offsetY: {toffsetY}");

            AktualizujSvg();

            await InvokeAsync(StateHasChanged);
