    private async Task PrzelaczIOtworz(KonfPolaczenie polaczenie)
    {
        if (polaczenie == null)
        {
            Console.WriteLine("PrzelaczIOtworz: polaczenie jest null");
            return;
        }


        if (polaczenie.DodatkowyWarunek == "PRZEKROJE")
        {
            activeKey = "1";
            await Task.Yield(); // Upewnij się, że UI zareaguje przed dalszymi operacjami
            selLewa = polaczenie.StronaPolaczenia?.ToLower() == "lewa";
            selPrawa = polaczenie.StronaPolaczenia?.ToLower() == "prawa";
            selGora = polaczenie.StronaPolaczenia?.ToLower() == "góra";
            selDol = polaczenie.StronaPolaczenia?.ToLower() == "dół";
        }
        else if (polaczenie.DodatkowyWarunek == "STYCZNE")
