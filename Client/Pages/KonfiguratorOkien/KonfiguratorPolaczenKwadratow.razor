    // ============================================================
    // KONWERSJE MIĘDZY KONWENCJĄ KANONICZNĄ STRONY A UKŁADEM FIZYCZNYM
    // ============================================================
    //
    // Konwencja kanoniczna (taka jak w bazie – kolumny PrzesuniecieX/Y):
    //   góra  : (0, +H)   skrzydło nad ramą
    //   dół   : (0, -H)   skrzydło pod ramą
    //   prawa : (+W, 0)   skrzydło po prawej
    //   lewa  : (-W, 0)   skrzydło po lewej
    //
    // Układ fizyczny modelu1 (taki jak zwraca measureGuideDisplacement):
    //   X+ = prawo, Y+ = góra (kartezjański)
    //
    // Wszystkie transformacje są LINIOWE, więc te same wzory stosujemy
    // zarówno do wartości bezwzględnych, jak i do delt.

    private static string NormalizujStrone(string? strona) =>
        (strona ?? "").Trim().ToLowerInvariant();

    /// <summary>Konwencja kanoniczna → układ fizyczny modelu1.</summary>
    private static (double X, double Y) KanoniczneDoFizyczne(
        double kanX, double kanY, string? strona)
    {
        switch (NormalizujStrone(strona))
        {
            case "góra":
            case "gora":
                return (kanX, kanY);

            case "dół":
            case "dol":
                return (kanX, -kanY);

            case "prawa":
                return (kanY, kanX);       // swap — odwrotność (kanX=fizY, kanY=fizX)

            case "lewa":
                return (kanY, -kanX);      // swap + negacja — odwrotność (kanX=-fizY, kanY=fizX)

            default:
                return (kanX, kanY);
        }
    }

    /// <summary>Układ fizyczny modelu1 → konwencja kanoniczna strony.</summary>
    private static (double X, double Y) FizyczneDoKanoniczne(
        double fizX, double fizY, string? strona)
    {
        switch (NormalizujStrone(strona))
        {
            case "góra":
            case "gora":
                return (fizX, fizY);

            case "dół":
            case "dol":
                return (fizX, -fizY);

            case "prawa":
                return (fizY, fizX);

            case "lewa":
                return (-fizY, fizX);

            default:
                return (fizX, fizY);
        }
    }

    /// <summary>
    /// Przelicza surowy pomiar fizyczny do zapisu dla konkretnej strony.
    /// Dla słupka stałego Y zawsze oznacza przesunięcie pionowe względem
    /// PoziomOsSymetrii; tylko dół odwraca znak. X dla prawa/lewa jest
    /// liczony względem PionOsSymetrii.
    /// </summary>


    private (double X, double Y) PrzeliczSlupkaStalegoDoZapisu(
        double fizX,
        double fizY,
        string strona)
    {
        if (pierwszyModel?.Typ?.Contains(
                "Słupek stały",
                StringComparison.OrdinalIgnoreCase) != true)
        {
            return (fizX, fizY);
        }

        string stronaNorm = NormalizujStrone(strona);

        double osPozioma = pierwszyModel.PoziomOsSymetrii ?? 0;
        double osPionowa = pierwszyModel.PionOsSymetrii ?? 0;
        double poziomDol = pierwszyModel.PoziomDol ?? 0;

        double zapisY;

        switch (stronaNorm)
        {
            case "góra":
            case "gora":

                // SZCZEGÓLNY PRZYPADEK:
                // Góra skrzydła łączy się z dołem słupka.
                if (fizY < 0)
                {
                    zapisY = poziomDol + fizY - osPozioma;

                    Console.WriteLine(
                        "[SŁUPEK STAŁY - GÓRA / UJEMNY POMIAR]\n" +
                        $"Obliczenie: {poziomDol:F3} + ({fizY:F3}) - {osPozioma:F3}");
                }
                else
                {
                    zapisY = fizY - osPozioma;
                }

                break;

            case "dół":
            case "dol":

                // SZCZEGÓLNY PRZYPADEK:
                // Dół jest liczony względem dolnej krawędzi
                // słupka pomniejszonej o oś symetrii.
                double osOdniesieniaDol = poziomDol - osPozioma;

                zapisY = fizY - osOdniesieniaDol;

                Console.WriteLine(
                    "[SŁUPEK STAŁY - DÓŁ]\n" +
                    $"PoziomDol: {poziomDol:F3}\n" +
                    $"PoziomOsSymetrii: {osPozioma:F3}\n" +
                    $"Oś odniesienia: {osOdniesieniaDol:F3}\n" +
                    $"Obliczenie: {fizY:F3} - {osOdniesieniaDol:F3}");

                break;

            case "prawa":
            case "lewa":

                // Dotychczasowa logika dla PRAWA / LEWA.
                zapisY = fizY - osPozioma;

                break;

            default:
                throw new ArgumentException(
                    $"Nieznana strona połączenia: '{strona}'.");
        }

        double zapisX = stronaNorm switch
        {
            "góra" or "gora" or "dół" or "dol" => fizX,

            "prawa" => fizX - osPionowa,

            "lewa" => -(fizX - osPionowa),

            _ => throw new ArgumentException(
                $"Nieznana strona połączenia: '{strona}'.")
        };

        Console.WriteLine(
            "[SŁUPEK STAŁY → ZAPIS]\n" +
            $"Strona: {stronaNorm}\n" +
            $"Surowy fizyczny X/Y: {fizX:F3} / {fizY:F3}\n" +
            $"PoziomOsSymetrii: {osPozioma:F3}\n" +
            $"PionOsSymetrii: {osPionowa:F3}\n" +
            $"PoziomDol: {poziomDol:F3}\n" +
            $"Zapis X/Y: {zapisX:F3} / {zapisY:F3}");

        return (zapisX, zapisY);
    }


    /// <summary>
    /// Przelicza pomiar słupka ruchomego do zapisu w bazie.
    /// Słupek ruchomy może występować tylko po LEWEJ albo PRAWEJ stronie.
    /// Tak samo jak dla słupka stałego, Y jest odległością od
    /// PoziomOsSymetrii, a X od PionOsSymetrii (z odwróceniem znaku po LEWEJ).
    /// </summary>
    private (double X, double Y) PrzeliczSlupkaRuchomegoDoZapisu(
    double fizX,
    double fizY,
    string strona)
    {
        if (pierwszyModel?.Typ?.Contains(
                "Słupek ruchomy",
                StringComparison.OrdinalIgnoreCase) != true)
            return (fizX, fizY);

        string stronaNorm = NormalizujStrone(strona);

        if (stronaNorm != "lewa" && stronaNorm != "prawa")
            throw new ArgumentException(
                $"Nieobsługiwana strona słupka ruchomego: {strona}");

        double osPozioma = pierwszyModel.PoziomOsSymetrii ?? 0;
        double osPionowa = pierwszyModel.PionOsSymetrii ?? 0;

        // Oś X – wartość zależna od strony.
        double zapisX = stronaNorm == "prawa"
            ? fizX - osPionowa
            : -(fizX - osPionowa);

        // Oś Y – dla LEWEJ i PRAWEJ strony zawsze ta sama wartość.
        double zapisY = -(fizY + osPozioma);

        Console.WriteLine(
            $"[RUCHOMY → ZAPIS] Strona={stronaNorm}, " +
            $"Fiz=({fizX:F3},{fizY:F3}), " +
            $"Zapis=({zapisX:F3},{zapisY:F3})");

        return (zapisX, zapisY);
    }

    /// <summary>
    /// Wartości słupka ruchomego w bazie są już zapisane jako odległości
    /// od osi profilu, dlatego formularz odczytuje je bez ponownego
    /// dodawania PoziomOsSymetrii/PionOsSymetrii.
    /// </summary>
    private (double X, double Y) PrzeliczSlupkaRuchomegoDoFormularza(
    double zapisX,
    double zapisY,
    string strona)
    {
        string stronaNorm = NormalizujStrone(strona);

        if (stronaNorm != "lewa" && stronaNorm != "prawa")
            throw new ArgumentException(
                $"Nieobsługiwana strona słupka ruchomego: {strona}");

        double osPozioma = pierwszyModel?.PoziomOsSymetrii ?? 0;
        double osPionowa = pierwszyModel?.PionOsSymetrii ?? 0;

        // Odwrócenie przeliczenia osi X.
        double fizX = stronaNorm == "prawa"
            ? zapisX + osPionowa
            : -zapisX + osPionowa;

        // Odwrócenie przeliczenia osi Y.
        double fizY = -zapisY - osPozioma;

        Console.WriteLine(
            $"[ZAPIS → RUCHOMY] Strona={stronaNorm}, " +
            $"Zapis=({zapisX:F3},{zapisY:F3}), " +
            $"Formularz=({fizX:F3},{fizY:F3})");

        return (fizX, fizY);
    }

    /// <summary>
    /// Odczytuje przesunięcia słupka stałego zapisane w bazie.
    /// W bazie X/Y są już przesunięciami względem odpowiednich osi.
    /// Nie dodajemy ponownie PoziomOsSymetrii ani PionOsSymetrii.
    /// </summary>
    private (double X, double Y) PrzeliczSlupkaStalegoDoFormularza(
        double kanX,
        double kanY,
        string strona)
    {
        if (pierwszyModel?.Typ?.Contains(
                "Słupek stały",
                StringComparison.OrdinalIgnoreCase) != true)
        {
            return (kanX, kanY);
        }

        string stronaNorm = NormalizujStrone(strona);

        Console.WriteLine(
            "[SŁUPEK STAŁY ← FORMULARZ]\n" +
            $"Strona: {stronaNorm}\n" +
            $"Wartości odczytane z bazy X/Y: {kanX:F3} / {kanY:F3}\n" +
            $"PoziomOsSymetrii: {pierwszyModel.PoziomOsSymetrii ?? 0:F3}\n" +
            $"PionOsSymetrii: {pierwszyModel.PionOsSymetrii ?? 0:F3}\n" +
            $"Wartości formularza X/Y: {kanX:F3} / {kanY:F3}");

        return (kanX, kanY);
    }

    /// <summary>
    /// Delta kanoniczna (z formularza edycji) → delta SVG gotowa
    /// do przekazania do <c>svgHelper.moveonlyedit(dx, dy)</c>.
    /// moveonlyedit oczekuje Y w konwencji SVG (Y+ = dół).
    /// </summary>
    private static (double Dx, double Dy) KanonicznaDeltaDoSvg(
        double dKanX, double dKanY, string? strona)
    {
        var (fizX, fizY) = KanoniczneDoFizyczne(dKanX, dKanY, strona);
        return (fizX, -fizY);   // negacja Y: kartezjański → SVG
    }

