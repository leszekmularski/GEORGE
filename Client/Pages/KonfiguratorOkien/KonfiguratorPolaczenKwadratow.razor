    private async Task OnPrzesuniecieChanged()
    {
        Console.WriteLine($"OnPrzesuniecieChanged: edytowanePrzesuniecieX={edytowanePrzesuniecieX}, edytowanePrzesuniecieY={edytowanePrzesuniecieY}, edytowanePrzesuniecieXStycznej={edytowanePrzesuniecieXStycznej}, edytowanePrzesuniecieYStycznej={edytowanePrzesuniecieYStycznej}");

        // Sprawdź aktualną transformację model2
        var currentTransform = await JSRuntime.InvokeAsync<string>("eval",
            "(function() { const m2 = document.querySelector('#model2'); return m2 ? (m2.getAttribute('transform') || '') : ''; })()");

        Console.WriteLine($"📐 Aktualna transformacja model2: {currentTransform}");

        // Sprawdź czy jesteśmy w trybie stycznym czy przekrojów
        bool isStyczne = boolStyczny;

        if (isStyczne)
        {
            // Tryb styczny
            if (edytowanePrzesuniecieXStycznej != old_edytowanePrzesuniecieXStycznej ||
                edytowanePrzesuniecieYStycznej != old_edytowanePrzesuniecieYStycznej)
            {
                // Oblicz różnicę
                double deltaX = edytowanePrzesuniecieXStycznej - old_edytowanePrzesuniecieXStycznej;
                double deltaY = edytowanePrzesuniecieYStycznej - old_edytowanePrzesuniecieYStycznej;

                Console.WriteLine($"📐 Przesuwam model2 o: deltaX={deltaX}, deltaY={deltaY}");

                // Sprawdź czy model2 ma odbicie lustrzane
                var hasFlip = await JSRuntime.InvokeAsync<bool>("eval",
                    "(function() { const m2 = document.querySelector('#model2'); if (!m2) return false; const t = m2.getAttribute('transform') || ''; return t.includes('scale(-1') || t.includes('scale(1, -1)'); })()");

                if (hasFlip)
                {
                    Console.WriteLine("🔄 Model2 ma odbicie lustrzane - odwracam kierunek");
                    // Nie odwracaj tutaj - funkcja JavaScript sama to obsłuży
                }

                // Użyj poprawionej funkcji moveonlyedit
                await JSRuntime.InvokeVoidAsync("svgHelper.moveonlyedit", deltaX, deltaY);

                await Task.Delay(10);

                // Aktualizuj stare wartości
                old_edytowanePrzesuniecieXStycznej = edytowanePrzesuniecieXStycznej;
                old_edytowanePrzesuniecieYStycznej = edytowanePrzesuniecieYStycznej;
            }
        }
        else
        {
            // Tryb przekrojów
            if (edytowanePrzesuniecieX != old_edytowanePrzesuniecieX ||
                edytowanePrzesuniecieY != old_edytowanePrzesuniecieY)
            {
                // Oblicz różnicę
                double deltaX = edytowanePrzesuniecieX - old_edytowanePrzesuniecieX;
                double deltaY = edytowanePrzesuniecieY - old_edytowanePrzesuniecieY;

                Console.WriteLine($"📐 Przesuwam model2 o: deltaX={deltaX}, deltaY={deltaY}");

                // Sprawdź czy model2 ma odbicie lustrzane
                var hasFlip = await JSRuntime.InvokeAsync<bool>("eval",
                    "(function() { const m2 = document.querySelector('#model2'); if (!m2) return false; const t = m2.getAttribute('transform') || ''; return t.includes('scale(-1') || t.includes('scale(1, -1)'); })()");

                Console.WriteLine($"🔄 Model2 ma odbicie lustrzane: {hasFlip}");

                // Użyj poprawionej funkcji moveonlyedit
                await JSRuntime.InvokeVoidAsync("svgHelper.moveonlyedit", deltaX, deltaY);

                await Task.Delay(10);

                // Aktualizuj stare wartości
                old_edytowanePrzesuniecieX = edytowanePrzesuniecieX;
                old_edytowanePrzesuniecieY = edytowanePrzesuniecieY;
            }
        }
    }
   
