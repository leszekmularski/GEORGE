                                <div class="side-checkbox">
                                    <input type="checkbox" @bind="selDol" id="str_dol" onclick="@DelSvg" />
                                    <label for="str_dol">Dół</label>
                                </div>
                                <div class="side-checkbox">
                                    <input type="checkbox" @bind="selGora" id="str_gora" onclick="@DelSvg" />
