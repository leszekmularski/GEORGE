    /// <summary>
    /// Czy dopuszczalne jest połączenie "pierwszyModel" z kandydatem "model"?
    /// Reguły:
    ///   Rama          → Skrzydło lub Słupek  (NIE Rama)
    ///   Skrzydło      → tylko Skrzydło       (NIE Słupek, NIE Rama)
    ///   Słupek (oba)  → tylko Skrzydło       (NIE Słupek, NIE Rama)
    ///   brak pierwszego → wszystko dozwolone
    /// </summary>
    private static bool CzyMozliwePolaczenie(KonfSystem? pierwszy, KonfModele? kandydat)
    {
        if (pierwszy == null) return true;      // pierwszy jeszcze nie wybrany → pokaż wszystko
        if (kandydat == null) return false;

        var t1 = pierwszy.Typ ?? "";
        var t2 = kandydat.Typ ?? "";

        bool p1Rama = t1.Contains("Rama");
        bool p1Skrzydlo = t1.Contains("Skrzydło");
        bool p1Slupek = t1.Contains("Słupek");   // obejmuje stały i ruchomy

        bool p2Rama = t2.Contains("Rama");
        bool p2Skrzydlo = t2.Contains("Skrzydło");
        bool p2Slupek = t2.Contains("Słupek");

        // Pierwszy = Rama → drugi: Skrzydło lub Słupek (nie Rama)
        if (p1Rama)
            return (p2Skrzydlo || p2Slupek) && !p2Rama;

        // Pierwszy = Skrzydło → drugi: tylko Skrzydło
        if (p1Skrzydlo)
            return p2Skrzydlo;

        // Pierwszy = Słupek (stały lub ruchomy) → drugi: tylko Skrzydło
        if (p1Slupek)
            return p2Skrzydlo;

        return false;
    }

