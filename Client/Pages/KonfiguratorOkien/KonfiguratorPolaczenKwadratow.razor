            window.svgHelper.measureGuideDisplacement = function () {
            try {
                const svg = document.querySelector(".scaled-svg > svg");
                if (!svg) {
                    console.error("[measureGuideDisplacement] Nie znaleziono SVG.");
                    return null;
                }

                const model1 = svg.querySelector("#model1");
                const model2 = svg.querySelector("#model2");
                if (!model1 || !model2) {
                    console.error("[measureGuideDisplacement] Brak modeli.", {
                        model1: !!model1, model2: !!model2
                    });
                    return null;
                }

                // ===== POMOCNICZE =====
                const getTransformedCenter = (el) => {
                    const bbox = el.getBBox();
                    const pt = svg.createSVGPoint();
                    pt.x = bbox.x + bbox.width / 2;
                    pt.y = bbox.y + bbox.height / 2;
                    return pt.matrixTransform(el.getCTM());
                };

                // ===== MACIERZ MODEL1 =====
                const model1Matrix = model1.getCTM();
                if (!model1Matrix) throw new Error("Brak CTM model1.");

                // Zwraca środek WIDOCZNEJ dolnej krawędzi elementu,
                // ale w lokalnym układzie modelu 1.
                // Nie wolno brać po prostu bbox.y + bbox.height: przy obrocie
                // modelu 2 o 180° ta krawędź staje się wizualnie górną.
                const getVisibleBottomCenterInModel1 = (el) => {
                    const bbox = el.getBBox();
                    const ctm = el.getCTM();
                    if (!ctm) throw new Error("Brak CTM badanego elementu.");

                    const det = model1Matrix.a * model1Matrix.d -
                                model1Matrix.b * model1Matrix.c;
                    if (Math.abs(det) < 1e-9)
                        throw new Error("Macierz model1 jest nieodwracalna.");

                    const corners = [
                        [bbox.x, bbox.y],
                        [bbox.x + bbox.width, bbox.y],
                        [bbox.x + bbox.width, bbox.y + bbox.height],
                        [bbox.x, bbox.y + bbox.height]
                    ];

                    const localCorners = corners.map(([x, y]) => {
                        const pt = svg.createSVGPoint();
                        pt.x = x;
                        pt.y = y;
                        const world = pt.matrixTransform(ctm);

                        // SVG/world -> lokalny układ modelu 1.
                        const dx = world.x - model1Matrix.e;
                        const dy = world.y - model1Matrix.f;
                        return {
                            x: (model1Matrix.d * dx - model1Matrix.c * dy) / det,
                            y: (-model1Matrix.b * dx + model1Matrix.a * dy) / det
                        };
                    });

                    const maxY = Math.max(...localCorners.map(p => p.y));
                    const tolerance = Math.max(
                        1e-6,
                        Math.max(bbox.width, bbox.height, 1) * 1e-8
                    );

                    // Dwa wierzchołki o największym Y tworzą dolną krawędź.
                    let edge = localCorners.filter(p => maxY - p.y <= tolerance);
                    if (edge.length < 2) {
                        edge = [...localCorners]
                            .sort((a, b) => b.y - a.y)
                            .slice(0, 2);
                    }

                    return {
                        x: edge.reduce((sum, p) => sum + p.x, 0) / edge.length,
                        y: edge.reduce((sum, p) => sum + p.y, 0) / edge.length
                    };
                };

                const det =
                    model1Matrix.a * model1Matrix.d -
                    model1Matrix.b * model1Matrix.c;
                if (Math.abs(det) < 1e-6) throw new Error("Macierz model1 nieodwracalna.");

                const transformVectorToLocal = (v) => ({
                    x: ( model1Matrix.d * v.dx - model1Matrix.c * v.dy) / det,
                    y: (-model1Matrix.b * v.dx + model1Matrix.a * v.dy) / det
                });

                // ===== X: z prowadnic pionowych (niezmienione) =====
                const findGuide = (m, name) =>
                    m.querySelector(`[data-name="${name}"]`) || m.querySelector(`[name="${name}"]`);

                const gV1 = findGuide(model1, "guide-line-vertical");
                const gV2 = findGuide(model2, "guide-line-vertical");

                let localX = 0;
                let guideDiag = { available: false };

                if (gV1 && gV2) {
                    const cV1 = getTransformedCenter(gV1);
                    const cV2 = getTransformedCenter(gV2);
                    const vv = { dx: cV2.x - cV1.x, dy: cV2.y - cV1.y };
                    const vLocal = transformVectorToLocal(vv);
                    localX = vLocal.x;
                    guideDiag = { available: true, cV1: { x: cV1.x, y: cV1.y }, cV2: { x: cV2.x, y: cV2.y } };
                } else {
                    // fallback: środek bbox
                    const c1 = getTransformedCenter(model1);
                    const c2 = getTransformedCenter(model2);
                    const vv = { dx: c2.x - c1.x, dy: c2.y - c1.y };
                    localX = transformVectorToLocal(vv).x;
                    guideDiag = { available: false, reason: "brak guide-line-vertical" };
                }

                // ===== Y: z RZECZYWISTEJ DOLNEJ PROWADNICY =====
                // Nie porównujemy już dolnych narożników bbox całej grupy.
                // Bbox może obejmować dodatkowe elementy/obramowania, które nie są
                // linią, którą użytkownik faktycznie ustawia współliniowo.
                // Szukamy poziomych prowadnic w każdym modelu, przeliczamy ich
                // środki do lokalnego układu model1 i wybieramy tę położoną
                // najniżej (największe Y SVG) już PO wszystkich obrotach/odbiciach.
                const toModel1Local = (world) => {
                    const dx = world.x - model1Matrix.e;
                    const dy = world.y - model1Matrix.f;
                    return {
                        x: (model1Matrix.d * dx - model1Matrix.c * dy) / det,
                        y: (-model1Matrix.b * dx + model1Matrix.a * dy) / det
                    };
                };

                const getVisibleBottomGuideInModel1 = (model) => {
                    const candidates = Array.from(
                        model.querySelectorAll('[data-name], [id]')
                    ).filter(el => {
                        const name = `${el.getAttribute('data-name') || ''} ${el.id || ''}`;
                        // Węzły SVG takie jak <title>, <desc> lub elementy
                        // pomocnicze mogą mieć id/data-name, ale nie obsługują
                        // getBBox()/getCTM(). Do pomiaru dopuszczamy wyłącznie
                        // rzeczywiste elementy graficzne SVG.
                        return name.toLowerCase().includes('guide-line-horizontal') &&
                               typeof el.getBBox === 'function' &&
                               typeof el.getCTM === 'function';
                    });

                    const points = candidates.map(el => {
                        try {
                            const bbox = el.getBBox();
                            const ctm = el.getCTM();
                            if (!ctm || !Number.isFinite(bbox.x) ||
                                !Number.isFinite(bbox.y) ||
                                !Number.isFinite(bbox.width) ||
                                !Number.isFinite(bbox.height)) return null;

                            const pt = svg.createSVGPoint();
                            pt.x = bbox.x + bbox.width / 2;
                            pt.y = bbox.y + bbox.height / 2;
                            const world = pt.matrixTransform(ctm);
                            const local = toModel1Local(world);
                            return {
                                name: el.getAttribute('data-name') || el.id || '(bez nazwy)',
                                tag: el.tagName,
                                x: local.x,
                                y: local.y
                            };
                        } catch (e) {
                            console.warn('[measureGuideDisplacement] Pominięto nieprawidłową prowadnicę:', el, e);
                            return null;
                        }
                    }).filter(Boolean);

                    if (points.length > 0) {
                        // Po transformacji wybieramy rzeczywiście najniższą
                        // z dostępnych prowadnic, niezależnie od obrotu modelu.
                        const bottom = points.reduce((best, p) => p.y > best.y ? p : best);
                        return { ...bottom, source: 'horizontal-guide', candidates: points };
                    }

                    // Awaryjnie: dolna krawędź bbox, jeśli SVG nie zawiera prowadnic.
                    const bbox = model.getBBox();
                    const ctm = model.getCTM();
                    if (!ctm) throw new Error('Brak CTM modelu przy pomiarze Y.');
                    const corners = [
                        [bbox.x, bbox.y],
                        [bbox.x + bbox.width, bbox.y],
                        [bbox.x + bbox.width, bbox.y + bbox.height],
                        [bbox.x, bbox.y + bbox.height]
                    ].map(([x, y]) => {
                        const pt = svg.createSVGPoint();
                        pt.x = x;
                        pt.y = y;
                        return toModel1Local(pt.matrixTransform(ctm));
                    });
                    const maxY = Math.max(...corners.map(p => p.y));
                    const edge = corners.filter(p => Math.abs(maxY - p.y) < 1e-6);
                    return {
                        x: edge.reduce((sum, p) => sum + p.x, 0) / edge.length,
                        y: edge.reduce((sum, p) => sum + p.y, 0) / edge.length,
                        source: 'bbox-fallback',
                        candidates: []
                    };
                };

                const btm1 = getVisibleBottomGuideInModel1(model1);
                const btm2 = getVisibleBottomGuideInModel1(model2);

                const bottomLocal = {
                    x: btm2.x - btm1.x,
                    y: btm2.y - btm1.y
                };
                const bottomVector = {
                    dx: bottomLocal.x,
                    dy: bottomLocal.y
                };

                // Y+ = góra (kartezjańskie). W lokalnym SVG Y+ = dół → negujemy.
                const localY_cart = -bottomLocal.y;

                // ===== OBRÓT / ODBICIE MODEL2 (diagnostyka) =====
                const m2 = model2.getCTM();
                const katObrotu = ((Math.atan2(m2.b, m2.a) * 180 / Math.PI) % 360 + 360) % 360;
                const detM2 = m2.a * m2.d - m2.b * m2.c;
                const odbicieLustrzane = detM2 < 0;

                // ===== LOGI =====
                console.log("========== DIAGNOSTYKA POMIARU ==========");
                console.table({
                    model1_bottom_local: { x: btm1.x.toFixed(2), y: btm1.y.toFixed(2), source: btm1.source },
                    model2_bottom_local: { x: btm2.x.toFixed(2), y: btm2.y.toFixed(2), source: btm2.source },
                    model1_horizontal_candidates: btm1.candidates,
                    model2_horizontal_candidates: btm2.candidates,
                    guide_info: guideDiag
                });
                console.log("Wektory (SVG):", {
                    bottom: bottomVector, guides: guideDiag.available ? "z prowadnic" : "z bbox"
                });
                console.log("Wynik lokalny:", { localX, localY_cart });
                console.log("========== KONIEC POMIARU ==========");

                return {
                    success: true,
                    elementsFound: true,

                    // --- WYNIK GŁÓWNY (kartezjański, Y+ = góra) ---
                    przesuniecieX: localX,
                    przesuniecieY: localY_cart,

                    katObrotu,
                    odbicieLustrzane,

                    scale: window.svgHelper.zoomLevel || 1,

                    // --- DIAGNOSTYKA ---
                    bottom1_svg: btm1,
                    bottom2_svg: btm2,
                    bottomVector,
                    bottomLocal,
                    determinantModel1: det,
                    determinantModel2: detM2
                };

            } catch (error) {
                console.error("[measureGuideDisplacement] Błąd:", error);
                return {
                    success: false, elementsFound: false,
                    przesuniecieX: 0, przesuniecieY: 0,
                    katObrotu: 0, odbicieLustrzane: false,
                    scale: window.svgHelper.zoomLevel || 1,
                    error: error.message
                };
            }
        };



        window.svgHelper.getDiagnosticTransforms = function () {

        const ids = ["model1", "model2"];
        const result = {};

        ids.forEach(id => {

            const element = document.getElementById(id);

            if (!element) {
                result[id] = { exists: false };
                return;
            }

            const matrix = element.getCTM();
            const parent = element.parentElement;
            const parentMatrix = parent?.getCTM();

            const toMatrix = m => m ? {
                a: m.a,
                b: m.b,
                c: m.c,
                d: m.d,
                e: m.e,
                f: m.f
            } : null;

            result[id] = {
                exists: true,
                transform: element.getAttribute("transform"),
                matrix: toMatrix(matrix),
                parent: parent ? {
                    id: parent.id,
                    tagName: parent.tagName,
                    transform: parent.getAttribute("transform"),
                    matrix: toMatrix(parentMatrix)
                } : null
            };
        });

        console.log("========== DIAGNOSTYKA TRANSFORMACJI SVG ==========");
        console.log(JSON.stringify(result, null, 2));

        return result;
    };

        function sanitizeSvg(svgElement) {
            const numericAttributes = [
                "x", "y", "x1", "y1", "x2", "y2", "cx", "cy", "r", "rx", "ry",
                "width", "height", "stroke-width"
            ];

            const walk = (node) => {
                if (node.nodeType !== 1) return;

                // Normalizacja atrybutów liczbowych
                numericAttributes.forEach(attr => {
                    if (node.hasAttribute(attr)) {
                        const val = node.getAttribute(attr);
                        const parsed = parseFloat(val);
                        if (!isNaN(parsed)) {
                            node.setAttribute(attr, parsed.toString());
                        }
                    }
                });

                // Usuń niepotrzebne atrybuty
                ['data-name', 'data-original-x', 'data-original-y'].forEach(attr => {
                    node.removeAttribute(attr);
                });

                // Rekurencyjnie przetwarzaj dzieci
                Array.from(node.children).forEach(walk);
            };

            walk(svgElement);
        }

        window.svgHelper.exportCleanedSvgAsPng = function() {
            return new Promise((resolve) => {
                try {
                    console.log("Starting PNG export...");

                    // 1. Pobierz elementy SVG
                    const svgElement = document.querySelector(".scaled-svg");
                    const svgContent = svgElement?.querySelector("#zoom-group");

                    if (!svgElement || !svgContent) {
                        console.error("SVG elements not found");
                        resolve("");
                        return;
                    }

                    // 2. Utwórz głęboką kopię SVG
                    const clone = svgElement.cloneNode(true);
                    const cloneContent = clone.querySelector("#zoom-group");

                    // 3. Usuń niepotrzebne elementy
                    const elementsToRemove = [
                        '[data-name^="guide-line-"]',
                        '[id^="guide-line-"]',
                        '.measurement-line',
                        '.measurement-text'
                    ].join(',');

                    clone.querySelectorAll(elementsToRemove).forEach(el => el.remove());
                    console.log("Removed guide elements");

                    // 4. Pobierz aktualną transformację
                    const currentTransform = svgContent.getAttribute("transform") || "";
                    console.log("Current transform:", currentTransform);

                    // 5. Przygotuj nowy SVG
                    const newSvg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                    newSvg.setAttribute("xmlns", "http://www.w3.org/2000/svg");
                    newSvg.setAttribute("width", "600");
                    newSvg.setAttribute("height", "600");
                    newSvg.setAttribute("viewBox", "0 0 600 600");

                    // 6. Przenieś zawartość ZACHOWUJĄC ORYGINALNĄ TRANSFORMACJĘ
                    const contentGroup = document.createElementNS("http://www.w3.org/2000/svg", "g");
                    contentGroup.setAttribute("transform", currentTransform);

                    // Przenieś wszystkie dzieci zachowując ich właściwości
                    while (cloneContent.firstChild) {
                        contentGroup.appendChild(cloneContent.firstChild);
                    }

                    newSvg.appendChild(contentGroup);
                    console.log("SVG content prepared:", newSvg);

                    // 7. Serializacja
                    const svgString = new XMLSerializer().serializeToString(newSvg);
                    console.log("SVG string length:", svgString.length);

                    // 8. Konwersja do obrazka
                    const img = new Image();
                    img.onload = function() {
                        try {
                            console.log("Image loaded, creating PNG...");
                            const canvas = document.createElement("canvas");
                            canvas.width = 600;
                            canvas.height = 600;
                            const ctx = canvas.getContext("2d");

                            // Białe tło
                            ctx.fillStyle = "#ffffff";
                            ctx.fillRect(0, 0, 1200, 1200);

                            // Renderuj SVG (1:1 bez dodatkowego skalowania)
                            ctx.drawImage(img, 0, 0);

                            const pngData = canvas.toDataURL("image/png");
                            console.log("PNG created successfully");
                            resolve(pngData);
                        } catch (e) {
                            console.error("Canvas error:", e);
                            resolve("");
                        }
                    };

                    img.onerror = function(e) {
                        console.error("Image load error:", e);
                        console.log("Problematic SVG:", svgString.substring(0, 500));
                        resolve("");
                    };

                    img.src = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svgString);
                } catch (e) {
                    console.error("Export error:", e);
                    resolve("");
                }
            });
        };

        window.svgHelper.resetModel2Position = function() {
        const svg = document.querySelector(".scaled-svg > svg");
        const model2 = svg?.querySelector("#model2");
        if (model2) model2.setAttribute("transform", "translate(0,0)");
        };

        window.svgHelper.getModel2Displacement = function () {
            try {
                const svg = document.querySelector(".scaled-svg > svg");
                if (!svg) return { success: false, przesuniecieX: 0, przesuniecieY: 0 };

                const model1 = svg.querySelector("#model1");
                const model2 = svg.querySelector("#model2");
                if (!model1 || !model2) {
                    return { success: false, przesuniecieX: 0, przesuniecieY: 0 };
                }

                const getBottomCenter = (el) => {
                    const bbox = el.getBBox();
                    const pt = svg.createSVGPoint();
                    pt.x = bbox.x + bbox.width / 2;
                    pt.y = bbox.y + bbox.height;          // dolna krawędź w SVG
                    return pt.matrixTransform(el.getCTM());
                };

                const b1 = getBottomCenter(model1);
                const b2 = getBottomCenter(model2);

                const scale = window.svgHelper.zoomLevel || 1;

                const dx =  (b2.x - b1.x) / scale;
                const dy = -(b2.y - b1.y) / scale;        // Y+ = góra (kartezjański)

