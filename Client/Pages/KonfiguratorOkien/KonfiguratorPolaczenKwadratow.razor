    private async Task SaveAllPosition()
    {

        //await JSRuntime.InvokeVoidAsync("svgHelper.bakeHorizontalFlipModel2");

        await Task.Yield(); // Daj czas na zakończenie operacji w JS

        await JSRuntime.InvokeVoidAsync("svgHelper.centerAndFit");
        await Task.Delay(200);

        GuideDisplacementResult result;

        // boolStyczny oznacza, że użytkownik wybrał tryb STYCZNY (bez prowadnic, prostokąt) np dosunięcie modelu 2 do modelu 1 czyli słupka do ramy

        if (boolStyczny)
        {
            // 🔹 Tryb STYCZNY (bez prowadnic, prostokąt)
            var offset = await JSRuntime.InvokeAsync<GuideDisplacementResult>("svgHelper.getModel2Displacement");

            if (offset == null || !offset.success)
            {
                await _message.Warning("❗ Nie udało się odczytać przesunięcia modelu 2 (tryb styczny). Nie zapisano przesunięcia.", 5);
                return;
            }


            result = new GuideDisplacementResult
            {
                success = offset.success,
                elementsFound = offset.elementsFound,

                przesuniecieX = Math.Round(offset.przesuniecieX, precyzjaZapisu),
                przesuniecieY = Math.Round(offset.przesuniecieY, precyzjaZapisu),

                verticalOsSymetriiX1 = Math.Round(offset.verticalOsSymetriiX1, precyzjaZapisu),

                verticalOsSymetriiY1 = Math.Round(offset.verticalOsSymetriiY1, precyzjaZapisu),

                horizontalOsSymetriiX1 = Math.Round(offset.horizontalOsSymetriiX1, precyzjaZapisu),

                horizontalOsSymetriiY1 = Math.Round(offset.horizontalOsSymetriiY1, precyzjaZapisu),
                verticalOsSymetriiX2 = Math.Round(offset.verticalOsSymetriiX2, precyzjaZapisu),

                verticalOsSymetriiY2 = Math.Round(offset.verticalOsSymetriiY2, precyzjaZapisu),
                horizontalOsSymetriiX2 = Math.Round(offset.horizontalOsSymetriiX2, precyzjaZapisu),

                horizontalOsSymetriiY2 = Math.Round(offset.horizontalOsSymetriiY2, precyzjaZapisu),

                scale = 1
            };

            if (!selSlRuchomy && !selSlStaly)
            {
                result.przesuniecieX = Math.Abs(offset.przesuniecieX);
                result.przesuniecieY = Math.Abs(offset.przesuniecieY);
            }

        }
        else
        {
            // 🔹 Tryb NORMALNY (z prowadnicami)
            result = await JSRuntime.InvokeAsync<GuideDisplacementResult>("svgHelper.measureGuideDisplacement");

            if (result?.success != true || !result.elementsFound)
            {
                await _message.Warning(result?.error ?? "❗ Nie można znaleźć prowadnic w rysunku SVG");
                return;
            }
        }

        double przesuniecieX = Math.Round(result.przesuniecieX, precyzjaZapisu);
        double przesuniecieY = Math.Round(result.przesuniecieY, precyzjaZapisu);


        double verticalOsSymetriiX1 = Math.Round(result.verticalOsSymetriiX1, precyzjaZapisu);
        double verticalOsSymetriiY1 = Math.Round(result.verticalOsSymetriiY1, precyzjaZapisu);

        double horizontalOsSymetriiX1 = Math.Round(result.horizontalOsSymetriiX1, precyzjaZapisu);
        double horizontalOsSymetriiY1 = Math.Round(result.horizontalOsSymetriiY1, precyzjaZapisu);

        double verticalOsSymetriiX2 = Math.Round(result.verticalOsSymetriiX2, precyzjaZapisu);
        double verticalOsSymetriiY2 = Math.Round(result.verticalOsSymetriiY2, precyzjaZapisu);

        double horizontalOsSymetriiX2 = Math.Round(result.horizontalOsSymetriiX2, precyzjaZapisu);
        double horizontalOsSymetriiY2 = Math.Round(result.horizontalOsSymetriiY2, precyzjaZapisu);

        Console.WriteLine($"svgHelper - Przesunięcie X: {przesuniecieX}, Przesunięcie Y: {przesuniecieY} verticalOsSymetriiX1: {verticalOsSymetriiX1} verticalOsSymetriiY1: {verticalOsSymetriiY1}");
        Console.WriteLine($"svgHelper - horizontalOsSymetriiX1: {horizontalOsSymetriiX1} horizontalOsSymetriiY1: {horizontalOsSymetriiY1} verticalOsSymetriiX2: {verticalOsSymetriiX2}");

        if (!selSlRuchomy && !selSlStaly)
        {
            przesuniecieX = Math.Abs(result.przesuniecieX);
            przesuniecieY = Math.Abs(result.przesuniecieY);
        }

        if (pierwszyModel == null || drugiModel == null || string.IsNullOrEmpty(SelectedModelPierwszyId) || string.IsNullOrEmpty(SelectedModelDrugiId))
        {
            await _message.Warning("❗ Nie wybrano obu modeli do połączenia. Błąd konfiguracji modelu :(");
            return;
        }

        if (pierwszyModel.Typ.Contains("Słupek stały"))
        {
            bool pionS;

            if (pierwszyModel.KatWystapieniaZakresOdMin == 0 &&
                pierwszyModel.KatWystapieniaZakresOdMax == 360)
            {
                // Dowolny kąt
                pionS = true;
            }
            else if (pierwszyModel.KatWystapieniaZakresOdMin == 0 &&
                     pierwszyModel.KatWystapieniaZakresOdMax == 0)
            {
                // Kierunek poziomy
                pionS = false;
            }
            else
            {
                // Pozostałe zakresy
                // tutaj zależy od tego, czy zakres wskazuje na kierunek poziomy
                pionS = true;
            }

            if (pionS)
            {
                przesuniecieY = verticalOsSymetriiX1 - przesuniecieY;
            }
            else
            {
                przesuniecieY = horizontalOsSymetriiY1 - przesuniecieY;
            }
        }

        // 🔹 Rysunek aktualnej zakładki
        var png = await GenerujPngBezProwadnic();

        var svg = await GenerujSvgBezProwadnic();

        var aktualnySvg = await JSRuntime.InvokeAsync<string>("svgHelper.getCurrentSvgState");

        // 🔹 Lista stron do zapisania (lewa/prawa/góra/dół)
        var strony = WyliczStronyPolaczenia();

        Console.WriteLine($"Rozpoczynam pętle foreach (var strona in strony) Strony: {strony.Count()} svg: {svg.Length} png: {png.Length}");

        string statusZapisu = "";

        foreach (var strona in strony)
        {

            var polaczenie = new KonfPolaczenie
            {
                ElementZewnetrznyId = pierwszyModel.RowId,
                ElementWewnetrznyId = drugiModel.RowId,
                StronaPolaczenia = strona,
                RowIdSystem = Guid.Parse(SelectedSystemId),
                RowIdModelu = Guid.Parse(SelectedModelPierwszyId),
                RowIdModeluDrugi = Guid.Parse(SelectedModelDrugiId),
                ZapisanyKat = katUstawienia,
                OpisPolaczenia = $"Połączono: {pierwszyModel.Nazwa ?? "Model 1 ?"} z {drugiModel.Nazwa ?? "Model 2 ?"}",
                Uwagi = $"Ostatnia zmiana: {DateTime.Now} - [{user}]",
                DodatkowyWarunek = boolStyczny ? "STYCZNE" : "PRZEKROJE"
            };

            polaczenie.RysunekPrzekrojuStyczny = Array.Empty<byte>();
            polaczenie.RysunekPrzekroju = Array.Empty<byte>();

            // 🔍 Sprawdź, czy istnieje już połączenie
            KonfPolaczenie? existing = null;

            try
            {
                var responseS = await Http.GetAsync(
                    $"api/KonfPolaczenie/find-by-elements/{polaczenie.ElementZewnetrznyId}/{polaczenie.ElementWewnetrznyId}/{strona}");

                if (responseS.IsSuccessStatusCode)
                {
                    existing = await responseS.Content.ReadFromJsonAsync<KonfPolaczenie>();
                }
                else if (responseS.StatusCode != HttpStatusCode.NotFound)
                {
                    await _message.Error($"❌ Błąd sprawdzania strony: {strona}");
                    continue;
                }
            }
            catch (Exception ex)
            {
                await _message.Error($"❌ Błąd komunikacji z API dla strony {strona}: {ex.Message}");
                continue;
            }

            // 🔸 Uzupełnij dane zależnie od zakładki
            if (boolStyczny)
            {
                // --- DANE DLA ZAKŁADKI "STYCZNE" ---
                polaczenie.PrzesuniecieXStycznej = przesuniecieX - 3.05;
                polaczenie.PrzesuniecieYStycznej = przesuniecieY - 8.99;// awatar modelu
                polaczenie.RysunekPrzekrojuStyczny = png;

                if (existing != null)
                {
                    // zachowaj dane przekrojów, nadpisz tylko styczne
                    polaczenie.Id = existing.Id;
                    polaczenie.RowId = existing.RowId;
                    polaczenie.PrzesuniecieX = Math.Round(existing.PrzesuniecieX, precyzjaZapisu);
                    polaczenie.PrzesuniecieY = Math.Round(existing.PrzesuniecieY, precyzjaZapisu);
                    //polaczenie.RysunekPrzekrojuStyczny = existing.RysunekPrzekrojuStyczny;
                }
            }
            else
            {
                // --- DANE DLA ZAKŁADKI "PRZEKROJE" ---
                polaczenie.PrzesuniecieX = Math.Round(przesuniecieX, precyzjaZapisu);
                polaczenie.PrzesuniecieY = Math.Round(przesuniecieY, precyzjaZapisu);
                polaczenie.RysunekPrzekroju = png;

                if (existing != null)
                {
                    // zachowaj dane styczne, nadpisz tylko przekroje
                    polaczenie.Id = existing.Id;
                    polaczenie.RowId = existing.RowId;
                    polaczenie.PrzesuniecieXStycznej = Math.Round(existing.PrzesuniecieXStycznej, precyzjaZapisu);
                    polaczenie.PrzesuniecieYStycznej = Math.Round(existing.PrzesuniecieYStycznej, precyzjaZapisu);
                    //polaczenie.RysunekPrzekroju = existing.RysunekPrzekroju;
                }
            }

            polaczenie.PrzesuniecieXStycznej = Math.Round(polaczenie.PrzesuniecieXStycznej, precyzjaZapisu);
            polaczenie.PrzesuniecieYStycznej = Math.Round(polaczenie.PrzesuniecieYStycznej, precyzjaZapisu);

            //Zapis rysunków do bazy

            polaczenie.SVG = svg;
            polaczenie.KonfiguracjaSVG = aktualnySvg;

            Console.WriteLine($"Zapis połączenia: boolStyczny:{boolStyczny} -> {polaczenie.ElementZewnetrznyId} + {polaczenie.ElementWewnetrznyId} Strona: {strona} X={przesuniecieX} Y={przesuniecieY} Kat={katUstawienia}");

            // 🔹 Zapisz lub aktualizuj w bazie
            HttpResponseMessage response;

            if (existing != null)
            {
                response = await Http.PutAsJsonAsync("api/KonfPolaczenie", polaczenie);
                Console.WriteLine($"Aktualizacja połączenia: {response.StatusCode}");
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/KonfPolaczenie", polaczenie);
                Console.WriteLine($"Nowe połączenie: {response.StatusCode}");
            }

            // 🔸 Feedback użytkownikowi
            if (response.IsSuccessStatusCode)
            {
                var zakladka = boolStyczny ? "styczna" : "przekrój";
                statusZapisu += $"✅ Zapisano stronę {strona} ({zakladka}), kąt: {katUstawienia}°\n";
            }
            else
            {
                _message.Error($"❌ Błąd zapisu strona: {strona}");
            }

            KonfiguracjeSystemu = null;
            listaPolaczen = null;

            await Task.Delay(10);

            KonfiguracjeSystemu = await Http.GetFromJsonAsync<List<KonfSystem>>($"api/konfsystem/FIND_ROWID_SYS/{SelectedSystemId}") ?? new();

            try
            {
                var responselp = await Http.GetAsync($"api/KonfPolaczenie/row-id-system/{SelectedSystemId}");

                if (responselp.IsSuccessStatusCode)
                {
                    listaPolaczen = await responselp.Content.ReadFromJsonAsync<List<KonfPolaczenie>>() ?? new();
                }
                else if (responselp.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    // 👇 Obsłuż błąd NotFound — nie ma rekordów, to nie błąd techniczny
                    listaPolaczen = new();
                    Console.WriteLine("Brak połączeń dla danego systemu.");
                }
                else
                {
                    // 👇 Inne błędy — np. 500
                    Console.Error.WriteLine($"Błąd HTTP {responselp.StatusCode}");
                    listaPolaczen = new();
                }
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Błąd ładowania połączeń: {ex.Message}");
                listaPolaczen = new();
            }

        }

        await _message.Success(statusZapisu, 2);

        activeKey = "0";

        await InvokeAsync(StateHasChanged);

    }

    private async Task<string> GenerujSvgBezProwadnic()
    {
        try
        {
            // 1. Wymuś aktualizację UI
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);

            // 2. Sprawdź, czy SVG jest gotowy
            var isReady = await JSRuntime.InvokeAsync<bool>(
                "svgHelper.isSvgReady");

            if (!isReady)
            {
                Console.WriteLine("SVG not ready, waiting...");
                await Task.Delay(500);

                await JSRuntime.InvokeVoidAsync(
                    "svgHelper.centerAndFit");

                await Task.Delay(300);
            }

            // 3. Pobierz SVG przygotowane specjalnie do zapisu
            //    - bez prowadnic
            //    - bez elementów pomiarowych
            //    - transformacja model2 zostaje wypalona
            var svgForSave =
                await JSRuntime.InvokeAsync<string>(
                    "svgHelper.prepareSvgForSave");

            // 4. Walidacja
            if (string.IsNullOrEmpty(svgForSave) ||
                svgForSave.Length < 100)
            {
                Console.WriteLine("Invalid SVG data received");
                return string.Empty;
            }

            Console.WriteLine(
                $"SVG generated successfully, length: {svgForSave.Length}");

            return svgForSave;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error generating SVG: {ex.Message}");

            return string.Empty;
        }
    }

    private async Task<byte[]> GenerujPngBezProwadnic()
    {
        try
        {
            // 1. Wymuś aktualizację UI
            StateHasChanged();
            await Task.Delay(100); // Czekaj na renderowanie

            // 2. Wygeneruj PNG
            var base64 = await JSRuntime.InvokeAsync<string>("svgHelper.exportCleanedSvgAsPng");

            if (string.IsNullOrEmpty(base64) || base64.Length < 100)
            {
                Console.WriteLine("Invalid PNG data received");
                return Array.Empty<byte>();
            }

            // 3. Konwersja do byte[]
            var pureBase64 = base64.StartsWith("data:image/png;base64,")
                ? base64["data:image/png;base64,".Length..]
                : base64;

            var imageData = Convert.FromBase64String(pureBase64);

            // 4. Walidacja rozmiaru
            if (imageData.Length < 1000) // Minimalny oczekiwany rozmiar
            {
                Console.WriteLine("PNG file too small");
                return Array.Empty<byte>();
            }

            return imageData;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating PNG: {ex.Message}");
            return Array.Empty<byte>();
        }
    }

    private async Task<byte[]> GenerujXMLPngBezProwadnic(string svgString)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(svgString))
            {
                Console.WriteLine("SVG string is empty");
                return Array.Empty<byte>();
            }

            // Wywołanie nowej funkcji JS z przekazaniem stringa SVG
            var base64 = await JSRuntime.InvokeAsync<string>("svgHelper.exportSvgStringAsPng", svgString);

            if (string.IsNullOrEmpty(base64) || base64.Length < 100)
            {
                Console.WriteLine("Invalid PNG data received");
                return Array.Empty<byte>();
            }

            // Oczyszczanie prefixu data:image/png;base64,
            var pureBase64 = base64.StartsWith("data:image/png;base64,")
                ? base64["data:image/png;base64,".Length..]
                : base64;

            var imageData = Convert.FromBase64String(pureBase64);

            if (imageData.Length < 1000) // minimalny oczekiwany rozmiar
            {
                Console.WriteLine("PNG file too small");
                return Array.Empty<byte>();
            }

            return imageData;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating PNG from XML SVG: {ex.Message}");
            return Array.Empty<byte>();
        }
    }

