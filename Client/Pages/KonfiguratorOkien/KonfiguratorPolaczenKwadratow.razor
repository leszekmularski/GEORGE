                                </span>

                                <RadioGroup @bind-Value="@wybranyKierunekBudowy" ButtonStyle="RadioButtonStyle.Solid">
                                    <Radio Value="@("lewej")">Lewej</Radio>
                                    <Radio Value="@("prawej")">Prawej</Radio>
                                    <Radio Value="@("góry")">Góry</Radio>
                                    <Radio Value="@("dołu")">Dołu</Radio>
                                </RadioGroup>
                            </div>

                        </div>
                    }

                    <!-- ========================================================= -->
                    <!-- OBSZAR SVG                                                 -->
                    <!-- ========================================================= -->
                    <div class="scaled-svg-container">

                        @if (!string.IsNullOrEmpty(combinedSvg))
                        {
