                } else {
                    // Drugie kliknięcie - punkt końcowy
                    updateMeasurement(startPoint.x, startPoint.y, coords.x, coords.y);
                    console.log("📍 Punkt końcowy - pomiar zakończony");

                    startPoint = null;

                    setTimeout(() => {
                        removeMeasurementElements();
                        console.log("🧹 Elementy pomiarowe usunięte");
