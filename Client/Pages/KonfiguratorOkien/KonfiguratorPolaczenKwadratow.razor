            await JSRuntime.InvokeAsync<string?>(
                "svgHelper.getModel2Transform");

        try
        {
            // Na czas pomiaru ustawiamy neutralny widok wrappera.
            // setModelsGroupTransform("") czyści odbicie #model2,
            // dlatego jego stan został wcześniej zapisany.
