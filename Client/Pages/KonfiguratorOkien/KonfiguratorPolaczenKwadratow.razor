                                                    Class="btn-sm btn-move" />
                                        </Tooltip>

                                        @*                            <Tooltip Title="Lustro elementów - odbicie wszystkich elementów w poziomie">
                                            <Button Icon="@IconType.Outline.Swap"
                                                    OnClick="MirrorObjAll"
                                                    Class="btn-sm btn-move" />
                                        </Tooltip>

                                        <Tooltip Title="Lustro elementów - odbicie wszystkich elementów w pionie">
                                            <Button Icon="@IconType.Outline.Swap"
                                                    OnClick="MirrorObjAllVertically"
                                                    Class="btn-sm btn-move" />
                                        </Tooltip> *@

                                    </div>

                                </div>


                                <!-- OBRÓT -->
                                <div class="tool-group">

                                    <span class="tool-group-title">
                                        <i class="bi bi-arrow-repeat me-1"></i>
                                        Obrót
                                    </span>

                                    <div class="tool-buttons">
                                        @* 
                                        <Tooltip Title="Obróć wszystko">
                                            <Button Icon="@IconType.Outline.Undo"
                                                    OnClick="RotateObjAll"
                                                    Class="btn-sm btn-move" />
                                        </Tooltip>
 *@
                                        <Tooltip Title="Obróć drugi model">
                                            <Button Icon="@IconType.Outline.Redo"
                                                    OnClick="RotateObj"
                                                    Class="btn-sm btn-move" />
                                        </Tooltip>

                                    </div>

                                </div>


                                <!-- PRZESUWANIE -->
                                <div class="tool-group">

                                    <span class="tool-group-title">
                                        <i class="bi bi-arrows-move me-1"></i>
                                        Przesuwanie
                                    </span>

                                    <div class="tool-buttons">

                                        <Tooltip Title="Przesuń w lewo">
                                            <Button Icon="@IconType.Outline.ArrowLeft"
                                                    OnClick="MoveLeftObj"
                                                    Class="btn-sm btn-move" />
                                        </Tooltip>

                                        <Tooltip Title="Przesuń w prawo">
                                            <Button Icon="@IconType.Outline.ArrowRight"
                                                    OnClick="MoveRightObj"
                                                    Class="btn-sm btn-move" />
                                        </Tooltip>

                                        <Tooltip Title="Przesuń w górę">
                                            <Button Icon="@IconType.Outline.ArrowUp"
                                                    OnClick="MoveUpObj"
                                                    Class="btn-sm btn-move" />
                                        </Tooltip>

                                        <Tooltip Title="Przesuń w dół">
                                            <Button Icon="@IconType.Outline.ArrowDown"
                                                    OnClick="MoveDownObj"
                                                    Class="btn-sm btn-move" />
                                        </Tooltip>

                                    </div>

                                </div>


                                <!-- WIDOK -->
                                <div class="tool-group">

                                    <span class="tool-group-title">
                                        <i class="bi bi-display me-1"></i>
                                        Widok
                                    </span>

                                    <div class="tool-buttons">

                                        <Tooltip Title="Dopasuj widok">
                                            <Button Icon="@IconType.Outline.Drag"
                                                    OnClick="ZoomAllObj"
                                                    Class="btn-sm btn-move" />
                                        </Tooltip>

                                        <Tooltip Title="Powiększ">
                                            <Button Icon="@IconType.Outline.ZoomIn"
                                                    OnClick="ZoomInObj"
                                                    Class="btn-sm btn-move" />
                                        </Tooltip>

                                        <Tooltip Title="Pomniejsz">
                                            <Button Icon="@IconType.Outline.ZoomOut"
                                                    OnClick="ZoomOutObj"
                                                    Class="btn-sm btn-move" />
                                        </Tooltip>

                                    </div>

                                </div>


                                <!-- PRECYZJA PRZESUWANIA -->
                                <div class="tool-group tool-setting-group">

                                    <span class="tool-group-title">
                                        <i class="bi bi-rulers me-1"></i>
                                        Dokładność
                                    </span>

                                    <div class="tool-setting">

                                        <label>
                                            Precyzja przesuwania:
                                        </label>

                                        <AntDesign.InputNumber @bind-Value="precyzjaPrzesuwania"
                                                               Min="0"
                                                               Max="50"
                                                               Style="width: 60px;" />

                                    </div>

                                </div>


                                <!-- POMIARY -->
                                <div class="tool-group">

                                    <span class="tool-group-title">
                                        <i class="bi bi-rulers me-1"></i>
                                        Pomiar
                                    </span>

                                    <div class="tool-buttons">

                                        <Tooltip Placement="@Placement.BottomCenter" Title="Pomiar odległości">
                                            <Button Icon="@IconType.Outline.Scan"
                                                    OnClick="StartMeasurement"
                                                    Class="btn-sm btn-move" />
                                        </Tooltip>
                                        <Tooltip Placement="@Placement.BottomCenter" Title="Pokaż wartości przesunięć w osi X i Y">
                                            <Button Icon="@IconType.Outline.Info" OnClick="PokazWartosciPrzesuniecia" Class="btn-sm btn-move" />
                                        </Tooltip>
                                        <Tooltip Placement="@Placement.BottomCenter" Title="Wyczyść pomiary">
                                            <Button Icon="@IconType.Outline.Close"
                                                    OnClick="ClearMeasurements"
                                                    Class="btn-sm btn-move" />
                                        </Tooltip>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ===================================================== -->
                        <!-- WIERSZ PODGLĄDU                                       -->
                        <!-- ===================================================== -->
                        <div class="connection-preview-toolbar">

                            <!-- TYTUŁ -->
                            <div class="preview-heading">

                                <i class="bi bi-eye"></i>

                                <span>
                                    Podgląd połączenia
                                </span>

                            </div>

                            <!-- OSTRZEŻENIE -->
                            <div class="preview-warning">

                                <i class="bi bi-exclamation-triangle-fill"></i>

                                <span>
                                    W przypadku konfiguracji słupka stałego wybierz go jako pierwszy model.
                                    Strona góra/dół określa skrzydło.
                                    <strong>Nadrzędną osią symetrii jest oś pozioma.</strong>
                                </span>

                            </div>

                            <!-- AKCJE -->
                            <div class="preview-actions">

                                <Tooltip Title="Odśwież podgląd">
                                    <Button Icon="@IconType.Outline.Fire"
                                            OnClick="@(() => RefreshSvg())"
                                            Class="btn-sm preview-refresh">
                                        Odśwież
                                    </Button>
                                </Tooltip>

                                <Tooltip Title="Wyczyść podgląd">
                                    <Button Icon="@IconType.Outline.Clear"
                                            OnClick="@(() => DelSvg())"
                                            Class="btn-sm btn-danger">
                                        Wyczyść
                                    </Button>
                                </Tooltip>

                            </div>

                        </div>

                    </div>

                    <!-- ========================================================= -->
                    <!-- STATUS MODELI                                             -->
                    <!-- ========================================================= -->
                    @if (pierwszyModel != null || drugiModel != null)
                    {
                        <div class="status-message flex-wrap gap-2">

                            <div>
                                @if (pierwszyModel != null && drugiModel == null)
                                {
                                    <span>
                                        <i class="bi bi-1-circle-fill me-1"></i>
                                        Pierwszy model wybrany:
                                        <strong>@pierwszyModel.Nazwa</strong>
                                    </span>
                                }
                                else if (pierwszyModel != null && drugiModel != null)
                                {
                                    <span>
                                        <i class="bi bi-link-45deg me-1"></i>
                                        Połączono:
                                        <strong>@pierwszyModel.Nazwa</strong>
                                        <span class="mx-1">→</span>
                                        <strong>@drugiModel.Nazwa</strong>
                                    </span>
                                }
                            </div>

                            <div class="ms-auto d-flex align-items-center gap-2">
                                <span class="fw-bold text-nowrap">
