                    return "";
                }

                // 3. Usuń niepotrzebne elementy (prowadnice, pomiary)
                const elementsToRemove = cloneContent.querySelectorAll(
                    '[data-name^="guide-line-"], ' +
                    '[id^="guide-line-"], ' +
                    '.measurement-line, ' +
                    '.measurement-text'
                );

