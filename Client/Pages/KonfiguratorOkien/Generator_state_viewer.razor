                                        <span class="badge" style="background:#0d6efd;">■ Zewnętrzny</span>
                                        @if (wybranyStan.KonturInner != null && wybranyStan.KonturInner.Count > 0)
                                        {
                                            <span class="badge ms-2" style="background:#28a745;">■ Wewnętrzny</span>
                                        }
