    {
        if (wybranyStan == null) return;

        object? Project(List<ContourSegment>? segs) =>
            segs?.Select(s => new
            {
                type = s.Type.ToString(),
                start = new { x = s.Start.X, y = s.Start.Y },
                end = new { x = s.End.X, y = s.End.Y },
                center = s.Center.HasValue
                    ? new { x = s.Center.Value.X, y = s.Center.Value.Y }
                    : (object?)null,
                radius = s.Radius,
                counterClockwise = s.CounterClockwise,
                informacja = s.Informacja
            }).ToList();

        var outer = Project(wybranyStan.Kontur);
        var inner = (tabIndex == 6) ? Project(wybranyStan.KonturInner) : null;

        // Daj Blazorowi chwilę na wstawienie elementu canvas do DOM
        await Task.Delay(50);

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "drawContourOnCanvas",
                $"contour-canvas-{tabIndex}",
                outer,
                inner,
               new
               {
                   bgColor = ciemnyMotyw ? "#1e1e1e" : "#ffffff",
                   outerColor = "#0d6efd",
                   innerColor = "#28a745",
                   showVertices = true,
                   showLabels = true,
                   showDimensions = true,
                   showPointLabels = pokazWartosciPunktow   // <-- NOWE
               });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Błąd rysowania canvas: {ex.Message}");
        }
    }

    // ========== LIFECYCLE ==========
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("initializeTabs");
                var isAvailable = await JSRuntime.InvokeAsync<bool>("eval", "!!window.hljs");
                uzyjHighlightJS = isAvailable;
            }
            catch { uzyjHighlightJS = false; }
        }

        // Jeśli jesteśmy na zakładce rysunku i widok szczegółowy jest aktywny,
        // zawsze przerysuj – RedrawCanvas jest idempotentny i szybki.
        if (szczegolyWidoczne && pokazWidokSzczegolowy &&
            (aktywnaZakladka == 5 || aktywnaZakladka == 6))
        {
            await RedrawCanvas(aktywnaZakladka);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("GeneratorStateViewer initialized.");
        szczegolyWidoczne = false;

        await Task.Yield();
    }
}