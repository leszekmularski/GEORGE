    protected override async Task OnInitializedAsync()
    {
        if (AppState != null)
        {
            AppState.SomeData = "";
        }

        var xversion = System.Reflection.Assembly
            .GetExecutingAssembly()
            .GetName()
            .Version;

        if (xversion != null)
        {
            version = xversion.ToString();
        }

        // Pierwsze pobranie natychmiast po uruchomieniu strony
        await PobierzPogode();

        await PobierzDowcip();

        // Automatyczne odświeżanie co 15 minut
        _weatherCancellation = new CancellationTokenSource();
        _ = AutomatyczneOdswiezaniePogody(_weatherCancellation.Token);
    }


    private async Task AutomatyczneOdswiezaniePogody(CancellationToken cancellationToken)
    {
        _weatherTimer = new PeriodicTimer(TimeSpan.FromMinutes(15));

        try
        {
            while (await _weatherTimer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await PobierzPogode();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Normalne zakończenie timera
        }
    }

    public void Dispose()
    {
        try
        {
            _weatherCancellation?.Cancel();
            _weatherTimer?.Dispose();
            _weatherCancellation?.Dispose();
        }
        catch
        {
            // Ignorujemy błąd podczas zamykania komponentu
        }
    }

    /* POBIERANIE POGODY */
    private async Task PobierzPogode()
    {
        try
        {
            pobieraniePogody = true;
            bladPogody = null;

            await InvokeAsync(StateHasChanged);

            using var http = new HttpClient();

            // 1. WYSZUKANIE LOKALIZACJI
            var encodedLocation = Uri.EscapeDataString(lokalizacja);

            var locationUrl =
                "https://geocoding-api.open-meteo.com/v1/search" +
                $"?name={encodedLocation}" +
                "&count=1" +
                "&language=pl" +
                "&format=json";

            var locationResponse =
                await http.GetFromJsonAsync<LokalizacjaDto>(locationUrl);

            var location = locationResponse?.Results?.FirstOrDefault();

            if (location == null)
            {
                bladPogody = $"Nie znaleziono lokalizacji: {lokalizacja}";
                return;
            }

            // 2. WSPÓŁRZĘDNE
            var latitude = location.Latitude.ToString(CultureInfo.InvariantCulture);
            var longitude = location.Longitude.ToString(CultureInfo.InvariantCulture);

            // 3. POBRANIE AKTUALNEJ POGODY
            var weatherUrl =
                "https://api.open-meteo.com/v1/forecast" +
                $"?latitude={latitude}" +
                $"&longitude={longitude}" +
                "&current=" +
                "temperature_2m," +
                "relative_humidity_2m," +
                "apparent_temperature," +
                "wind_speed_10m," +
                "weather_code," +
                "is_day" +
                "&temperature_unit=celsius" +
                "&wind_speed_unit=kmh" +
                "&timezone=Europe%2FWarsaw";

            Console.WriteLine($"Pobieranie pogody: {weatherUrl}");

            var weather = await http.GetFromJsonAsync<PogodaApiResponse>(weatherUrl);

            // 4. SPRAWDZENIE ODPOWIEDZI
            if (weather == null)
            {
                bladPogody = "Open-Meteo nie zwróciło odpowiedzi.";
                return;
            }

            if (weather.Current == null)
            {
                bladPogody = "Open-Meteo nie zwróciło danych aktualnej pogody.";
                return;
            }

            // 5. DEBUG
            Console.WriteLine($"Temperatura: {weather.Current.Temperature2m}");
            Console.WriteLine($"Odczuwalna: {weather.Current.ApparentTemperature}");
            Console.WriteLine($"Wilgotność: {weather.Current.RelativeHumidity2m}");
            Console.WriteLine($"Wiatr: {weather.Current.WindSpeed10m}");
            Console.WriteLine($"Kod pogody: {weather.Current.WeatherCode}");

            // 6. ZAPIS DO MODELU WIDOKU
            pogoda = new PogodaViewModel
            {
                LocationName = location.Name,
                Country = location.Country,
                Temperature = weather.Current.Temperature2m,
                ApparentTemperature = weather.Current.ApparentTemperature,
                RelativeHumidity = weather.Current.RelativeHumidity2m,
                WindSpeed = weather.Current.WindSpeed10m,
                WeatherCode = weather.Current.WeatherCode,
                IsDay = weather.Current.IsDay == 1
            };
        }
        catch (Exception ex)
        {
            bladPogody = $"Błąd pobierania pogody: {ex.Message}";
            Console.WriteLine($"BŁĄD POGODY: {ex}");
        }
        finally
        {
            pobieraniePogody = false;
            await InvokeAsync(StateHasChanged);
        }
    }

