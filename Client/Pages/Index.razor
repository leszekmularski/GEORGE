@using System.Text.Json.Serialization
@page "/"
@using System.Globalization
@using System.Net.Http.Json
@inject IJSRuntime JS
@inject IMessageService _message

<PageTitle>Program do wspomagania produkcji</PageTitle>

<div class="george-page">

    <!-- NAGŁÓWEK -->
    <div class="page-header">
        <h1>
            System produkcyjny w firmie
            <span class="company-name">PPHU "GEORGE"</span>
            <span class="version">[Wersja: @version]</span>
        </h1>
        <p class="date-information">
            Dziś mamy dzień:
            <strong>@DateTime.Now.DayOfYear</strong>
            roku
            <strong>@DateTime.Now.Year</strong>,
            tydzień
            <strong>@GetWeekNumber(DateTime.Now)</strong>
        </p>
    </div>


    <!-- HUMOR DNIA GEORGE -->
    <div class="day-message humor">
        <span class="day-icon">@dowcipDnia.Ikona</span>

        <div class="humor-content">
            <span class="humor-title">
                @dowcipDnia.Kategoria
            </span>

            <span class="humor-text">
                @dowcipDnia.Tekst
            </span>

            @if (ladowanieDowcipu)
            {
                <span class="humor-loading">Pobieram dowcip...</span>
            }
        </div>

        <button type="button"
                class="humor-button"
                @onclick="(() => NastepnyDowcip())"
                disabled="@ladowanieDowcipu"
                title="Pokaż kolejny dowcip">
            🔄 Następny dowcip
        </button>
    </div>


    <!-- POGODA -->
    @if (pobieraniePogody)
    {
        <div class="weather-card loading">
            <div class="weather-loading">
                <div class="loading-cloud">☁️</div>
                <div>
                    <div class="loading-title">Pobieranie informacji o pogodzie...</div>
                    <div class="loading-location">📍 @lokalizacja</div>
                </div>
            </div>
        </div>
    }
    else if (pogoda != null)
    {
        <div class="weather-card">
            <!-- LEWA STRONA - GRAFIKA -->
            <div class="weather-illustration">
                @if (pogoda.IsDay)
                {
                    <div class="sun"></div>
                    <div class="cloud cloud-main">
                        <div class="cloud-part cloud-part-1"></div>
                        <div class="cloud-part cloud-part-2"></div>
                        <div class="cloud-part cloud-part-3"></div>
                    </div>
                }
                else
                {
                    <div class="moon"></div>
                    <div class="star star-1">✦</div>
                    <div class="star star-2">✦</div>
                    <div class="star star-3">✦</div>
                    <div class="cloud cloud-night">
                        <div class="cloud-part cloud-part-1"></div>
                        <div class="cloud-part cloud-part-2"></div>
                        <div class="cloud-part cloud-part-3"></div>
                    </div>
                }
                <div class="small-cloud small-cloud-1"></div>
                <div class="small-cloud small-cloud-2"></div>
            </div>

            <!-- PRAWA STRONA - INFORMACJE -->
            <div class="weather-information">
                <div class="weather-location">
                    <div class="location-icon">📍</div>
                    <div>
                        <div class="location-title">@pogoda.LocationName</div>
                        <div class="location-country">@pogoda.Country</div>
                    </div>
                </div>

                <div class="weather-temperature">
                    <span class="temperature">@pogoda.Temperature.ToString("0.0")</span>
                    <span class="temperature-unit">°C</span>
                </div>

                <div class="weather-description">
                    <span class="weather-icon">@GetWeatherEmoji(pogoda.WeatherCode)</span>
                    <span>@GetWeatherDescription(pogoda.WeatherCode)</span>
                </div>

                <div class="weather-details">
                    <div class="weather-detail">
                        <div class="detail-icon">🌡️</div>
                        <div>
                            <div class="detail-label">Odczuwalna</div>
                            <div class="detail-value">@pogoda.ApparentTemperature.ToString("0.0") °C</div>
                        </div>
                    </div>
                    <div class="weather-detail">
                        <div class="detail-icon">💧</div>
                        <div>
                            <div class="detail-label">Wilgotność</div>
                            <div class="detail-value">@pogoda.RelativeHumidity.ToString("0") %</div>
                        </div>
                    </div>
                    <div class="weather-detail">
                        <div class="detail-icon">💨</div>
                        <div>
                            <div class="detail-label">Wiatr</div>
                            <div class="detail-value">@pogoda.WindSpeed.ToString("0") km/h</div>
                        </div>
                    </div>
                </div>

                <div class="weather-update">
                    <span>Aktualna pogoda</span>
                    <button class="weather-refresh"
                            @onclick="PobierzPogode"
                            disabled="@pobieraniePogody">
                        ↻ Odśwież
                    </button>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(bladPogody))
    {
        <div class="weather-error">
            <span>⚠️</span>
            <span>@bladPogody</span>
            <button @onclick="PobierzPogode">Spróbuj ponownie</button>
        </div>
    }

    <!-- ZDJĘCIE FIRMY -->
    @if (DateTime.Now.DayOfWeek == DayOfWeek.Monday)
    {
        <div class="company-image-container">
            <img class="company-image" src="/Images/george_st.jpg"
                 asp-append-version="true" alt="PPHU GEORGE" />
        </div>
    }
    else if (DateTime.Now.DayOfWeek == DayOfWeek.Friday)
    {
        <div class="company-image-container">
            <img class="company-image" src="/Images/george_nt.jpg"
                 asp-append-version="true" alt="PPHU GEORGE" />
        </div>
    }
    else
    {
        <div class="company-image-container">
            <img class="company-image" src="/Images/george_ct.jpg"
                 asp-append-version="true" alt="PPHU GEORGE" />
        </div>
    }

    <!-- ADRES FIRMY -->
    <Tooltip Placement="@Placement.Top"
             Title="Kliknij w poniższy napis aby go skopiować">
        <div class="address-container" @onclick="CopyToClipboard">
            <div class="address-icon">📋</div>
            <div class="address-text">@textAdres</div>
        </div>
    </Tooltip>
</div>


<style>
