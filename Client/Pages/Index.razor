    }

    .humor-title {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #9b6b13;
    }

    .humor-text {
        font-size: 14px;
        font-weight: 600;
        line-height: 1.5;
    }

    .humor-button {
        padding: 7px 12px;
        border: 1px solid #e4c36d;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.75);
        color: #75500b;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

        .humor-button:hover {
            background: #fff;
            transform: translateY(-1px);
        }

    @@media (max-width: 600px) {
        .day-message.humor

    {
        flex-direction: column;
        text-align: center;
    }

    }
</style>


@code {

    /* PODSTAWOWE DANE */
    private string? version = "1.0";

    [Inject]
    private AppState AppState { get; set; } = default!;

    /* LOKALIZACJA */
    private string lokalizacja = "Nowy Sącz, Poland";

    /* POGODA */
    private PogodaViewModel? pogoda;
    private bool pobieraniePogody = false;
    private string? bladPogody;

    /* ADRES */
    private static string textAdres =
        $"PPHU \"GEORGE\" Marcinkowice 351, 33-393 Marcinkowice " +
        $"tel:(+48 18) 44-33-111 NIP:7341136804 " +
        $"Dziś mamy: " +
        $"{DateTime.Now.ToString("dddd", new CultureInfo("pl-PL"))} " +
        $"{DateTime.Now.ToShortDateString()}";

    /* START */
    private PeriodicTimer? _weatherTimer;
    private CancellationTokenSource? _weatherCancellation;


    /* HUMOR DNIA GEORGE */


    [Inject]
    private HttpClient Http { get; set; } = default!;

    private bool ladowanieDowcipu = false;

    private (string Ikona, string Kategoria, string Tekst) dowcipDnia =
        ("😂", "Humor dnia", "Kliknij „Następny dowcip”!");


    private async Task PobierzDowcip()
    {
        ladowanieDowcipu = true;

        try
        {
            // Zbiór polskich dowcipów na Hugging Face.
            // Pobieramy losowy fragment zawierający maksymalnie 100 wpisów.
            int offset = Random.Shared.Next(0, 8901);

            string adres =
                "https://datasets-server.huggingface.co/rows" +
                "?dataset=JonaszPotoniec%2Fdowcipy-polish-jokes-dataset" +
                "&config=default" +
                "&split=train" +
                $"&offset={offset}&length=100";

            var odpowiedz =
                await Http.GetFromJsonAsync<HuggingFaceJokesResponse>(adres);

            // Jeśli losowy fragment jest pusty, spróbuj pobrać początek zbioru.
            if (odpowiedz?.Rows == null || odpowiedz.Rows.Count == 0)
            {
                adres =
                    "https://datasets-server.huggingface.co/rows" +
                    "?dataset=JonaszPotoniec%2Fdowcipy-polish-jokes-dataset" +
                    "&config=default&split=train&offset=0&length=100";

                odpowiedz =
                    await Http.GetFromJsonAsync<HuggingFaceJokesResponse>(adres);
            }

            var dowcipy = odpowiedz?.Rows?
                .Select(x => x.Row?.Joke?.Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct()
                .ToList();

            if (dowcipy == null || dowcipy.Count == 0)
            {
                PokazDowcipZapasowy();
                return;
            }

            // Wybieramy dowcip z pobranego fragmentu.
            string tekst = dowcipy[Random.Shared.Next(dowcipy.Count)]!;

            dowcipDnia = (
                "😂",
                "Humor dnia",
                tekst
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Błąd pobierania dowcipu z Hugging Face: {ex.Message}");
            PokazDowcipZapasowy();
        }
        finally
        {
            ladowanieDowcipu = false;
        }
    }

    private async Task NastepnyDowcip()
    {
        await PobierzDowcip();
    }

    // Modele odpowiedzi JSON z Hugging Face
    public class HuggingFaceJokesResponse
    {
        [JsonPropertyName("rows")]
        public List<HuggingFaceJokeItem>? Rows { get; set; }
    }

    public class HuggingFaceJokeItem
