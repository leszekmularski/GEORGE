    private bool bCzekajNaZapis = false;

    private async Task ZapiszEdycje()
    {

        if (bCzekajNaZapis)
        {
            return; // Jeśli już trwa zapis, nie rób nic
        }

        bCzekajNaZapis = true;

        try
        {
            bladEdycji = "";

            if (string.IsNullOrWhiteSpace(edytowaneDrzwi.Typ))
            {
                bladEdycji = "Wybierz typ schodów.";
                bCzekajNaZapis = false;
                return;
            }

            HttpResponseMessage response;

            // Nowy rekord
            if (edytowaneDrzwi.Id == 0)
            {
                edytowaneDrzwi.DataZapisu = DateTime.Now;

                response = await Http.PostAsJsonAsync(
                    "api/Drzwi",
                    edytowaneDrzwi);
            }
            // Edycja istniejącego
            else
            {
                edytowaneDrzwi.DataZapisu = DateTime.Now;

                response = await Http.PutAsJsonAsync(
                    "api/Drzwi",
                    edytowaneDrzwi);
            }

            if (response.IsSuccessStatusCode)
            {
                czyModalEdycjiWidoczny = false;

                // odśwież listę
                listaDrzwi = await Http.GetFromJsonAsync<List<Drzwi>>("api/Drzwi")
                               ?? new List<Drzwi>();

                StateHasChanged();
            }
            else
            {
                bladEdycji = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            bladEdycji = ex.Message;
        }

        bCzekajNaZapis = false;
    }


