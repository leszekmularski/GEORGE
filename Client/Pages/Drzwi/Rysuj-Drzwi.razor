@page "/Rysuj-Drzwi"

@using Blazor.Extensions
@using Blazor.Extensions.Canvas
@using Blazor.Extensions.Canvas.Canvas2D
@using AntDesign
@using GEORGE.Shared.Models

@using System.Net
@using Newtonsoft.Json
@using netDxf;
@using netDxf.Entities;
@using System.IO;

@inject IconService iconService
@inject HttpClient Http
@inject INotificationService _notice
@inject NavigationManager NavigationManager
@inject Utilities.ILocalStorage LocalStorage

@inject IJSRuntime JS;

<script>
        window.clipboardImage = {

        readImage: async function () {

            try {

                const items = await navigator.clipboard.read();

                for (const item of items) {

                    for (const type of item.types) {

                        if (type.startsWith("image/")) {

                            const blob = await item.getType(type);

                            return await new Promise(resolve => {

                                const reader = new FileReader();

                                reader.onload = () => resolve(reader.result);

                                reader.readAsDataURL(blob);

                            });
                        }
                    }
                }

                alert("Brak obrazu w schowku.");

                return null;

            } catch (e) {

                alert("Nie udało się odczytać schowka.");

                return null;
            }
        }
    };
</script>

<style>
    .skeleton-wrapper {
        padding: 20px 0;
    }

    .skeleton-card {
        border: 1px solid #e8e8e8;
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .skeleton-image {
        width: 100%;
        height: 200px;
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
    }

    .skeleton-line {
        height: 16px;
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
        border-radius: 4px;
        margin-bottom: 12px;
    }

    .skeleton-line-title {
        height: 24px;
        width: 80%;
    }

    .skeleton-line-short {
        width: 40%;
    }

    .skeleton-line-medium {
        width: 60%;
    }

    @@keyframes shimmer {
        0% {
            background-position: -200% 0;
        }

        100% {
            background-position: 200% 0;
        }
    }

    .empty-state {
        background: #f8f9fa;
        border: 2px dashed #dee2e6;
        border-radius: 12px;
        padding: 4rem 2rem;
        transition: all 0.3s ease;
    }

        .empty-state:hover {
            border-color: #0d6efd;
            background: #f0f7ff;
        }

    .empty-state-icon {
        opacity: 0.7;
    }
</style>

<Divider></Divider>

<Tabs DefaultActiveKey="101" TabPosition="@TabPosition.Left" Type="@TabType.Card" @bind-ActiveKey="activeKey" OnTabClick="OnTabClick">

    <TabPane Key="100" Tab="Generator rysunków drzwi">
        <div style="display: flex; align-items: flex-start;">
            <div style="width: 256px;">
                <Menu Style="width: 256px;"
                      DefaultSelectedKeys=@(new[] { "1" })
                      DefaultOpenKeys=@(new[] { "sub1" })
                      Mode=@MenuMode.Inline>
                    <SubMenu Key="sub1" TitleTemplate="@sub1Title">
                        <MenuItemGroup Key="g1" Title="Wymiary">
                            <MenuItem Key="001">
                                <label for="szerDzwi">Szerokość Drzwi:</label>
                                <input id="szerDzwi" type="number" @bind="szerDzwi" min="400" max="2000" />
                            </MenuItem>
                            <MenuItem Key="002">
                                <label for="wysDzwi">Wysokość Drzwi:</label>
                                <input id="wysDzwi" type="number" @bind="wysDzwi" min="1500" max="2800" />
                            </MenuItem>
                            <MenuItem Key="003">
                                <div>
                                    <label for="width">Ościężnica:</label>
                                    <select name="typOscieznicy" id="typOscieznicy" @bind="typOscieznicy">
                                        <option value="Pioro">Z piórem</option>
                                    </select>
                                </div>
                            </MenuItem>
                        </MenuItemGroup>
                    </SubMenu>
                    <SubMenu Key="sub2" TitleTemplate=@subOscTitle>
                        <MenuItemGroup Key="g3" Title="Ościeżnica">
                            <MenuItem Key="3">
                                <label for="wysProgu">Wysokość Progu:</label>
                                <input id="wysProgu" type="number" @bind="wysProgu" min="0" max="100" />
                            </MenuItem>
                            <MenuItem Key="4">
                                <label for="wysPiora">Wysokość Pióra:</label>
                                <input id="wysPiora" type="number" @bind="wysPiora" min="20" max="200" />
                            </MenuItem>
                            <MenuItem Key="4.0.0">
                                <label for="wysPiora">Grubość Pióra:</label>
                                <input id="gruboscPiora" type="number" @bind="gruboscPiora" min="2" max="100" />
                            </MenuItem>
                            <MenuItem Key="4.0">
                                <label for="szerOsc">Szerokość:</label>
                                <input id="szerOsc" type="number" @bind="szerOsc" min="20" max="200" />
                            </MenuItem>
                            <MenuItem Key="4.1">
                                <label for="glebOsc">Głębokość:</label>
                                <input id="glebOsc" type="number" @bind="glebOsc" min="20" max="1000" />
                            </MenuItem>
                            <MenuItem Key="4.2">
                                <div style="width: 206px;">
                                    <label for="laczOsc">Sposób łączenia:</label>
                                    <select name="laczOsc" id="laczOsc" @bind="laczOsc">
                                        <option value="90">Proste</option>
                                        <option value="45">Kąt 45</option>
                                    </select>
                                </div>
                            </MenuItem>
                        </MenuItemGroup>
                    </SubMenu>
                    <SubMenu Key="sub21" TitleTemplate=@subSkrzTitle>
                        <MenuItemGroup Key="g3" Title="Skrzydło">
                            <MenuItem Key="4.20">
                                <label for="width">Typ:</label>
                                <select name="laczOsc" id="typSkrzydla" @bind="typSkrzydla">
                                    <option value="Typ1">Typ 1</option>
                                    <option value="Typ2">Typ 2</option>
                                </select>
                            </MenuItem>
                            <MenuItem Key="4.21">
                                <label for="width">Szerokość:</label>
                                <input id="width" type="number" @bind="szerRamSkrz" min="20" max="300" />
                            </MenuItem>
                            <MenuItem Key="4.22">
                                <label for="height">Grubość:</label>
                                <input id="height" type="number" @bind="gruboscSkrz" min="10" max="100" />
                            </MenuItem>
                        </MenuItemGroup>
                        <MenuItemGroup Key="g3" Title="Przeszklenia">
                            <MenuItem Key="4.23">
                                <label for="height">Ilość:</label>
                                <input id="height" type="number" @bind="iloscPrzeszkelen" min="0" max="20" />
                            </MenuItem>
                            <MenuItem Key="4.24">
                                <label for="height">Wielkość:</label>
                                <input id="height" type="number" @bind="wielkoscPrzeszklenia" min="50" max="1000" />
                            </MenuItem>
                        </MenuItemGroup>
                    </SubMenu>

                    <SubMenu Key="sub222" TitleTemplate=@subKierOtwTitle>
                        <MenuItem Key="551">
                            <div>
                                < br/>
                                <RadioGroup @onChange="@UpdateShapes()" Style="display: block;height:30px;line-height:30px" @bind-Value="ratioKierOtw" ButtonStyle="@RadioButtonStyle.Solid">
                                    <Radio RadioButton Value="@("N")">X</Radio>
                                    <Radio RadioButton Value="@("L")">LEWE</Radio>
                                    <Radio RadioButton Value="@("R")">PRAWE</Radio>
                                </RadioGroup>
                                < br/>
                            </div>
                        </MenuItem>
                        <MenuItem Key="552">
                            <label for="scale">Ilość zawiasów:</label>
                            <input id="scale" type="number" @bind="iloscZawiasow" step="1" min="2" max="5" />
                        </MenuItem>
                    </SubMenu>

                    <SubMenu Key="sub22" TitleTemplate=@sub3Title>
                        <MenuItem Key="5">
                            <label for="scale">Skala:</label>
                            <input id="scale" type="number" @bind="scale" step="0.1" min="0.1" max="10" />
                        </MenuItem>
                        <SubMenu Key="sub51" Title="Marginesy">
                            <MenuItem Key="52">
                                <label for="scale">Margines lewy:</label>
                                <input id="scale" type="number" @bind="startX" step="10" min="0" max="500" />
                            </MenuItem>
                            <MenuItem Key="53">
                                <label for="scale">Margines górny:</label>
                                <input id="scale" type="number" @bind="startY" step="10" min="0" max="500" />
                            </MenuItem>
                        </SubMenu>
                    </SubMenu>

                    <SubMenu Key="sub6" TitleTemplate=@sub4Title>
                        <MenuItem Key="61">
                            <button @onclick="ExtractShapesFromCanvasAsync">Generuj DXF</button>
                        </MenuItem>
                    </SubMenu>
                </Menu>
                <div>
                    <button @onclick="UpdateShapes">Zaktualizuj Rysunek</button>
                </div>
            </div>
            <div style="flex-grow: 1; margin-left: 16px;">
                <Tabs @bind-ActiveKey="@activeKey" Animated>
                    <TabPane Tab="Rama dzwi" Key="1">
                        <h7>Szkic ościeżnicy z piórem</h7>
                        <div style="overflow: auto; width: 1000px; height: 580px">
                            <BECanvas Width="2000" Height="2500" @ref="canvasReference"></BECanvas>
                        </div>
                    </TabPane>
                    <TabPane Tab="Skrzydło" Key="2">
                        <h7>Szkic skrzydła</h7>
                        <div style="overflow: auto; width: 1000px; height: 580px">
                            <BECanvas Width="2000" Height="2500" @ref="canvasReferenceSkrzy"></BECanvas>
                        </div>
                    </TabPane>
                    <TabPane Tab="Rama ze skrzydłem" Key="3">
                        <h7>Kompletne drzwi [widok od wewnątrz]</h7>
                        <div style="overflow: auto; width: 1000px; height: 580px">
                            <BECanvas Width="2000" Height="2500" @ref="canvasReferenceKPL"></BECanvas>
                        </div>
                    </TabPane>
                </Tabs>
            </div>
        </div>
    </TabPane>
    <TabPane Key="101" Tab="Wyszukiwarka rysunków drzwi">
        @if (listaDrzwi == null)
        {
            <div class="skeleton-wrapper">
                <div class="row">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card skeleton-card">
                                <div class="skeleton-image"></div>
                                <div class="card-body">
                                    <div class="skeleton-line skeleton-line-title"></div>
                                    <div class="skeleton-line skeleton-line-short"></div>
                                    <div class="skeleton-line skeleton-line-medium"></div>
                                    <div class="skeleton-line skeleton-line-short"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (!listaDrzwi.Any())
        {
            <div class="text-center py-5 my-4">
                <div class="empty-state">
                    <div class="empty-state-icon mb-4">
                        <i class="bi bi-door-open" style="font-size: 5rem; color: #6c757d;"></i>
                    </div>
                    <h4 class="text-muted mb-3">Brak drzwi w bazie</h4>
                    <p class="text-secondary mb-4">Nie masz jeszcze żadnych drzwi. Dodaj pierwsze drzwi, aby rozpocząć pracę.</p>
                    <button class="btn btn-primary btn-lg" @onclick="() => OtworzModalEdycji(new Drzwi())">
                        <i class="bi bi-plus-circle me-2"></i>Dodaj pierwsze drzwi
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm mb-4">
                <!-- Nagłówek karty z przyciskiem dodawania -->
                <div class="card-header d-flex justify-content-between align-items-center bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-door-open me-2"></i>Lista drzwi
                    </h5>
                    @if (boolZapis || boolAdmin)
                    {
                        <Button Type="@ButtonType.Primary"
                                Icon="@IconType.Outline.Plus"
                                OnClick="() => OtworzModalEdycji(new Drzwi())">
                            Dodaj nowe drzwi
                        </Button>
                    }
                </div>

                <!-- Ciało karty z filtrami -->
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <!-- Typ -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Typ drzwi</label>
                            <Input @bind-Value="filtrTyp"
                                   Placeholder="np. Drzwi jednoskrzydłowe"
                                   AllowClear
                                   Class="w-100" />
                        </div>

                        <!-- Wysokość -->
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Wysokość ±20 mm</label>
                            <AntDesign.InputNumber @bind-Value="filtrWysokosc"
                                                   class="form-control w-100" />
                        </div>

                        <!-- Szerokość -->
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Szerokość ±20 mm</label>
                            <AntDesign.InputNumber @bind-Value="filtrSzerokosc"
                                                   class="form-control w-100" />
                        </div>

                        <!-- Grubość (dostosowane do drzwi) -->
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Grubość ±20 mm</label>
                            <AntDesign.InputNumber @bind-Value="filtrGrubosc"
                                                   class="form-control w-100" />
                        </div>

                        <!-- Przycisk Wyczyść -->
                        <div class="col-md-2">
                            <Button Type="@ButtonType.Default"
                                    Block
                                    Icon="@IconType.Outline.Clear"
                                    OnClick="WyczyscFiltry"
                                    Style="height: 38px;">
                                Wyczyść
                            </Button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabela z danymi -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Rysunek</th>
                            <th>Typ</th>
                            <th>Wysokość [mm]</th>
                            <th>Szerokość [mm]</th>
                            <th>Grubość [mm]</th>
                            <th style="width: 120px;">Akcja</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = (currnet_page - 1) * ilosc_na_stronie; i < currnet_page * ilosc_na_stronie; i++)
                        {
                            if (i >= listaDrzwiFiltrowana.Count())
                            {
                                break;
                            }

                            var drzwi = listaDrzwiFiltrowana.ElementAt(i);

                            <tr>
                                <td class="text-center">
                                    @if (drzwi.RysunekPogladowy?.Length > 20)
                                    {
                                        <a target="_blank" href="data:image/png;base64,@Convert.ToBase64String(drzwi.RysunekPogladowy)">
                                            <img title="grubość:@drzwi.Grubosc Próg:@drzwi.WysokoscProgu"
                                                 src="data:image/png;base64,@Convert.ToBase64String(drzwi.RysunekPogladowy)"
                                                 style="width: 120px; height: auto; object-fit: contain; border: 1px solid #ddd;" />
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Brak</span>
                                    }
                                </td>
                                <td>@(drzwi.Typ ?? "")</td>
                                <td>@drzwi.Wysokosc</td>
                                <td>@drzwi.Szerokosc</td>
                                <td>@drzwi.Grubosc</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <Button Type="@ButtonType.Primary"
                                                Block
                                                Icon="@IconType.Outline.Download"
                                                Disabled="@(drzwi.RowIdPliku == Guid.Empty)"
                                                OnClick="() => OnFileChange(drzwi.RowIdPliku.ToString())">
                                            Pobierz
                                        </Button>

                                        @if (boolZmiana || boolAdmin)
                                        {
                                            <Tooltip Title="Edytuj">
                                                <Button Type="primary"
                                                        Size="small"
                                                        Icon="@IconType.Outline.Edit"
                                                        OnClick="() => OtworzModalEdycji(drzwi)" />
                                            </Tooltip>
                                        }

                                        @if (boolUsuniecia || boolAdmin)
                                        {
                                            <Popconfirm Title="Czy chcesz usunąć dane?"
                                                        OnConfirm="()=> deleteRow(drzwi.RowId.ToString())"
                                                        OkText="Tak"
                                                        CancelText="Nie">
                                                <Tooltip Title="Usuń połączenie">
                                                    <Button Type="danger"
                                                            Size="small"
                                                            Icon="@IconType.Outline.Delete"
                                                            Danger />
                                                </Tooltip>
                                            </Popconfirm>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginacja i informacje -->
            <div class="d-flex justify-content-between align-items-center mt-3">
                <label class="text-muted">Liczba załadowanych rekordów: <strong>@listaDrzwiFiltrowana.Count()</strong> / Strona <strong>@currnet_page</strong></label>
                <Pagination DefaultCurrent="@currnet_pageReplace"
                            Total="@listaDrzwiFiltrowana.Count()"
                            OnShowSizeChange="ZmienIloscNaStronie"
                            PageSize="@ilosc_na_stronie"
                            OnChange="UpdateCurrentPage" />
            </div>
        }

    </TabPane>

</Tabs>

<!-- Modal edycji -->
<Modal Title="Dodaj / Edytuj drzwi do wyszukiwarki"
       Visible="czyModalEdycjiWidoczny"
       OnCancel="ZamknijModalEdycji"
       OnOk="ZapiszEdycje"
       OkText=@("Zapisz")
       CancelText=@("Anuluj")
       Width="950"
       ConfirmLoading="bCzekajNaZapis"
       MaskClosable="false">

    <div class="container-fluid">
        <Tabs DefaultActiveKey="1">

            <!-- Zakładka 1: Dane podstawowe -->
            <TabPane Key="1" Tab="Dane podstawowe">
                <Card Class="mb-3">
                    <div class="row">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Typ drzwi</label>
                            <select class="form-control flex-grow-1"
                                    @bind="@edytowaneDrzwi.Typ"
                                    @onclick:stopPropagation="true">
                                <option value="">-- Wybierz typ drzwi --</option>
                                <optgroup label="Drzwi jednoskrzydłowe">
                                    <option value="Drzwi jednoskrzydłowe otwierane do wewnątrz">Drzwi jednoskrzydłowe otwierane do wewnątrz</option>
                                    <option value="Drzwi jednoskrzydłowe otwierane na zewnątrz">Drzwi jednoskrzydłowe otwierane na zewnątrz</option>
                                    <option value="Drzwi jednoskrzydłowe lewe">Drzwi jednoskrzydłowe lewe</option>
                                    <option value="Drzwi jednoskrzydłowe prawe">Drzwi jednoskrzydłowe prawe</option>
                                </optgroup>
                                <optgroup label="Drzwi dwuskrzydłowe">
                                    <option value="Drzwi dwuskrzydłowe symetryczne">Drzwi dwuskrzydłowe symetryczne</option>
                                    <option value="Drzwi dwuskrzydłowe asymetryczne">Drzwi dwuskrzydłowe asymetryczne</option>
                                    <option value="Drzwi dwuskrzydłowe z jednym skrzydłem aktywnym">Drzwi dwuskrzydłowe z jednym skrzydłem aktywnym</option>
                                    <option value="Drzwi dwuskrzydłowe oba skrzydła aktywne">Drzwi dwuskrzydłowe oba skrzydła aktywne</option>
                                </optgroup>
                                <optgroup label="Drzwi przesuwne">
                                    <option value="Drzwi przesuwne jednoskrzydłowe">Drzwi przesuwne jednoskrzydłowe</option>
                                    <option value="Drzwi przesuwne dwuskrzydłowe">Drzwi przesuwne dwuskrzydłowe</option>
                                    <option value="Drzwi przesuwne chowane w ścianę">Drzwi przesuwne chowane w ścianę</option>
                                </optgroup>
                                <optgroup label="Drzwi harmonijkowe">
                                    <option value="Drzwi harmonijkowe jednoskrzydłowe">Drzwi harmonijkowe jednoskrzydłowe</option>
                                    <option value="Drzwi harmonijkowe dwuskrzydłowe">Drzwi harmonijkowe dwuskrzydłowe</option>
                                </optgroup>
                                <optgroup label="Drzwi specjalne">
                                    <option value="Drzwi przeciwpożarowe EI30">Drzwi przeciwpożarowe EI30</option>
                                    <option value="Drzwi przeciwpożarowe EI60">Drzwi przeciwpożarowe EI60</option>
                                    <option value="Drzwi dźwiękoszczelne">Drzwi dźwiękoszczelne</option>
                                    <option value="Drzwi antywłamaniowe">Drzwi antywłamaniowe</option>
                                    <option value="Drzwi szklane">Drzwi szklane</option>
                                    <option value="Drzwi z przeszkleniem">Drzwi z przeszkleniem</option>
                                </optgroup>
                                <optgroup label="Drzwi zewnętrzne">
                                    <option value="Drzwi zewnętrzne jednoskrzydłowe">Drzwi zewnętrzne jednoskrzydłowe</option>
                                    <option value="Drzwi zewnętrzne dwuskrzydłowe">Drzwi zewnętrzne dwuskrzydłowe</option>
                                    <option value="Drzwi balkonowe">Drzwi balkonowe</option>
                                    <option value="Drzwi tarasowe">Drzwi tarasowe</option>
                                </optgroup>
                                <optgroup label="Drzwi wewnętrzne">
                                    <option value="Drzwi wewnętrzne jednoskrzydłowe">Drzwi wewnętrzne jednoskrzydłowe</option>
                                    <option value="Drzwi wewnętrzne dwuskrzydłowe">Drzwi wewnętrzne dwuskrzydłowe</option>
                                    <option value="Drzwi łazienkowe">Drzwi łazienkowe</option>
                                    <option value="Drzwi kuchenne">Drzwi kuchenne</option>
                                </optgroup>
                            </select>
                        </div>

                        <div class="col-md-8 mt-3">
                            <label class="form-label fw-bold">Rodzaj wypełnienia</label>
                            <select class="form-control flex-grow-1"
                                    @bind="@edytowaneDrzwi.RodzajWypelnienia"
                                    @onclick:stopPropagation="true">
                                <option value="">-- Wybierz rodzaj wypełnienia --</option>
                                <optgroup label="Wypełnienia szklane">
                                    <option value="Szkło float przezroczyste">Szkło float przezroczyste</option>
                                    <option value="Szkło float matowe">Szkło float matowe</option>
                                    <option value="Szkło hartowane przezroczyste">Szkło hartowane przezroczyste</option>
                                    <option value="Szkło hartowane matowe">Szkło hartowane matowe</option>
                                    <option value="Szkło klejone (laminowane)">Szkło klejone (laminowane)</option>
                                    <option value="Szkło ornamentowe (ryflowane)">Szkło ornamentowe (ryflowane)</option>
                                    <option value="Szkło mleczne (opalowe)">Szkło mleczne (opalowe)</option>
                                    <option value="Szkło kolorowe">Szkło kolorowe</option>
                                    <option value="Szkło antywłamaniowe">Szkło antywłamaniowe</option>
                                    <option value="Szkło dźwiękoszczelne">Szkło dźwiękoszczelne</option>
                                    <option value="Szkło energooszczędne">Szkło energooszczędne</option>
                                    <option value="Szkło z filtrem UV">Szkło z filtrem UV</option>
                                    <option value="Szkło z filtrem UV">Szkło lustro Weneckie</option>
                                </optgroup>
