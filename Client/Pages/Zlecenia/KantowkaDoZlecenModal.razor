    private async Task ZapiszExcelKantowkiPoStronieKlienta(bool czyNaProdukcje)
    {
        if (kantowkaDoZlecen == null || !kantowkaDoZlecen.Any())
        {
            await _message.Warning("Brak danych do zapisania.");
            return;
        }

        int iloscKolumn = czyNaProdukcje ? 6 : 5;
        var danePosortowane = kantowkaDoZlecen
            .OrderBy(k => k.GatunekKantowki)
            .ThenBy(k => k.Przekroj)
            .ThenBy(k => k.DlugoscZamawiana)
            .ToList();

        using var workbook = new ClosedXML.Excel.XLWorkbook();
        var ws = workbook.Worksheets.Add("Zamówienie");

        ws.Cell(1, 1).Value = "Gatunek kantówki";
        ws.Cell(1, 2).Value = "Przekrój";
        ws.Cell(1, 3).Value = "Nazwa produktu";
        ws.Cell(1, 4).Value = "Długość zamówiona";
        ws.Cell(1, 5).Value = "Ilość sztuk";
        if (czyNaProdukcje) ws.Cell(1, 6).Value = "Długość na gotowo (grupa)";

        if (czyNaProdukcje)
        {
            ws.Range(2, 1, 2, 6).Merge();
            ws.Cell(2, 1).Value = dotyczyKlienta;
        }
        else
        {
            ws.Range(2, 1, 2, 5).Merge();
            ws.Cell(2, 1).Value = dotyczyKlienta;
        }

        for (int r = 1; r <= 2; r++)
            for (int c = 1; c <= iloscKolumn; c++)
            {
                var cell = ws.Cell(r, c);
                cell.Style.Font.Bold = true;
                cell.Style.Font.FontSize = 14;
                cell.Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.LightGray;
                cell.Style.Border.OutsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin;
                cell.Style.Border.InsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin;
                cell.Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Center;
                cell.Style.Alignment.Vertical = ClosedXML.Excel.XLAlignmentVerticalValues.Center;
            }

        int row = 3;
        foreach (var k in danePosortowane)
        {
            ws.Cell(row, 1).Value = k.GatunekKantowki;
            ws.Cell(row, 2).Value = k.Przekroj;
            ws.Cell(row, 3).Value = k.NazwaProduktu;
            ws.Cell(row, 4).Value = k.DlugoscZamawiana;
            ws.Cell(row, 5).Value = k.IloscSztuk;
            if (czyNaProdukcje) ws.Cell(row, 6).Value = k.DlugoscNaGotowoGrupa;

            for (int c = 1; c <= iloscKolumn; c++)
            {
                var cell = ws.Cell(row, c);
                cell.Style.Font.FontSize = 14;
                cell.Style.Border.OutsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin;
                cell.Style.Border.InsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin;
                cell.Style.Alignment.Vertical = ClosedXML.Excel.XLAlignmentVerticalValues.Center;
            }
            row++;
        }

        var grupy = danePosortowane.GroupBy(k => k.Przekroj);
        foreach (var g in grupy)
        {
            var sumaMm = g.Sum(k => k.IloscSztuk * k.DlugoscZamawiana);
            var suma = MathF.Round(sumaMm / 1000f, 2);
            ws.Range(row, 1, row, 4).Merge();
            ws.Cell(row, 1).Value = $"Suma {g.Key}";
            if (czyNaProdukcje)
            {
                ws.Range(row, 5, row, 6).Merge();
                ws.Cell(row, 5).Value = suma + " mb";
            }
            else
            {
                ws.Cell(row, 5).Value = suma + " mb";
            }
            for (int c = 1; c <= iloscKolumn; c++)
            {
                var cell = ws.Cell(row, c);
                cell.Style.Font.Bold = true;
                cell.Style.Font.FontSize = 14;
                cell.Style.Border.OutsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin;
                cell.Style.Border.InsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin;
                cell.Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Center;
            }
            row++;
        }

        ws.Columns().AdjustToContents();

        await using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        stream.Position = 0;
        var base64 = Convert.ToBase64String(stream.ToArray());
        string nazwa = Regex.Replace(dotyczyKlienta ?? "klient",
            $"[{Regex.Escape(new string(Path.GetInvalidFileNameChars()))}]", "_");

        await JSRuntime.InvokeVoidAsync("saveAsExcelKantowki", base64, $"Zamowienie_{nazwa}.xlsx");
        await _message.Success("Plik Excel został pobrany.");
    }

