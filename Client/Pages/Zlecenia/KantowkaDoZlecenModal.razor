    public async Task WyliczIloscFarby()
    {
        if (kantowkaDoZlecen == null) return;
        const double z = 0.3;
        double pow = 0;
        foreach (var k in kantowkaDoZlecen)
        {
            var wym = k.Przekroj.Trim().ToLower().Split('x');
            if (wym.Length == 2 && double.TryParse(wym[0], out var a) && double.TryParse(wym[1], out var b))
                pow += ((a / 1000 * k.DlugoscZamawiana / 1000 * 2) + (b / 1000 * k.DlugoscZamawiana / 1000 * 2)) * k.IloscSztuk;
        }
        pow += 1;
        double l = pow * z;
        await ShowConfirmIcon(ConfirmIcon.Info,
            $"Ilość farby: {Math.Round(l, 1)} l (1x), {Math.Round(l * 2, 1)} l (2x), powierzchnia {Math.Round(pow, 1)} m² (zalecane {z} l/m²)");
    }

