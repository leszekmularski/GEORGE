    public async Task editRow(long id)
    {
        if (kantowkaDoZlecen == null) return;
        oryginalkantowkaDoZlecen = kantowkaDoZlecen.DeepCopyList();

        if (_visible) { _visible = false; await HideDialog(); }
        else
        {
            kantowka = new KantowkaDoZlecenViewModel();
            var l = kantowkaDoZlecen.Where(d => d.Id == id).ToArray();
            if (l.Length > 0)
            {
                cid = id;
                kantowka = l[0];
                _visible = true;
                await ShowDialog();
            }
        }
    }

    public async Task deleteRow(long id)
    {
