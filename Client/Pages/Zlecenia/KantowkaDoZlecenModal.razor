    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            if (file.Size > 10 * 1024 * 1024)
            {
                await _message.Error("Plik zbyt duży (max 10 MB)."); return;
            }

            if (file.ContentType == "application/pdf")
            {
                var path = Path.GetTempFileName();
                try
                {
                    await using (var s = file.OpenReadStream(10 * 1024 * 1024))
                    await using (var fs = new FileStream(path, FileMode.Create))
                        await s.CopyToAsync(fs);

                    pdfContent = PdfReaderService.ReadPdfTable(path);
                    zestawienie = PdfDataParser.ParsePdfData(pdfContent);
                    formatPlikuImport = "PDF";
                    StateHasChanged();
                }
                finally { try { if (File.Exists(path)) File.Delete(path); } catch { } }
                return;
            }

            if (file.ContentType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                || file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                await using var s = file.OpenReadStream(10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await s.CopyToAsync(ms);
                ms.Position = 0;
                var parser = new PDF.ExcelDataParser();
                zestawienie = parser.ParseExcelData(ms);
                formatPlikuImport = "EXCEL";
                StateHasChanged();
                return;
            }

            if (file.Name.EndsWith(".xls", StringComparison.OrdinalIgnoreCase))
            {
                await _message.Error("Format XLS nieobsługiwany – zapisz jako XLSX."); return;
            }

            await _message.Error("Niepoprawny format pliku (PDF/XLSX).");
        }
        catch (Exception ex)
        {
            await _notice.Error(new()
            {
                Message = "Błąd importu pliku.",
                Description = ex.Message + Environment.NewLine + ex.StackTrace,
                Placement = NotificationPlacement.BottomLeft
            });
        }
    }

    private async Task PasteStolcad()
    {
        try
        {
            var txt = await JSRuntime.InvokeAsync<string>("navigator.clipboard.readText");
            zestawienie = PdfDataParser.ParseClipboardData(txt);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _ = _notice.Error(new() { Message = ex.Message, Description = ex.StackTrace, Placement = NotificationPlacement.BottomLeft });
        }
    }

    private async Task SaveAll()
    {
        kantowki = new();
        if (zestawienie == null) return;

        string xv = System.Reflection.Assembly.GetExecutingAssembly().GetName().Version != null
            ? " [" + System.Reflection.Assembly.GetExecutingAssembly().GetName().Version + "]"
            : "";

        foreach (var item in zestawienie.ListaCieci)
        {
            kantowki.Add(new KantowkaDoZlecenViewModel
            {
                RowIdZlecenia = RowIdZlecenia,
                GatunekKantowki = item.Uwagi,
                Przekroj = item.Kolor,
                NazwaProduktu = item.Symbol,
                KodProduktu = "",
                Uwagi = $"Zaimportowano z {formatPlikuImport} dnia: {DateTime.Now}{xv}",
                DlugoscZamawiana = int.Parse(item.WymiarNaZamowienie),
                DlugoscNaGotowo = int.Parse(item.Wymiar),
                DlugoscNaGotowoGrupa = item.Wymiar,
                IloscSztuk = int.Parse(item.Ilosc),
                DataZamowienia = DateTime.MinValue,
                DataRealizacji = DateTime.MinValue,
                DataZapisu = DateTime.Now,
                KtoZapisal = user ?? "",
                DataDostarczenia = DateTime.MinValue,
                PozDostarczono = false,
                WyslanoDoZamowien = false,
                MaterialZeStanMagazyn = false,
            });
        }

        var resp = await Http.PostAsJsonAsync($"api/kantowkaDoZlecen/save-all/{isCheckedDelAll}", kantowki);
        if (resp.IsSuccessStatusCode)
        {
            kantowkaDoZlecen = await Http.GetFromJsonAsync<List<KantowkaDoZlecenViewModel>>($"api/KantowkaDoZlecen/rowid/{RowIdZlecenia}");
            zestawienie = null;
        }
    }

    private async Task SaveAllGrupa()
    {
        if (zestawienie == null) return;

        string xv = System.Reflection.Assembly.GetExecutingAssembly().GetName().Version != null
            ? " [" + System.Reflection.Assembly.GetExecutingAssembly().GetName().Version + "]"
            : "";

        var grouped = zestawienie.ListaCieci
            .GroupBy(i => new { G = i.Uwagi, P = i.Kolor, D = int.Parse(i.WymiarNaZamowienie) })
            .Select(g => new KantowkaDoZlecenViewModel
            {
                RowIdZlecenia = RowIdZlecenia,
                GatunekKantowki = g.Key.G,
                Przekroj = g.Key.P,
                NazwaProduktu = g.FirstOrDefault()?.Symbol ?? "",
                KodProduktu = "",
                Uwagi = $"Zaimportowano z {formatPlikuImport} dnia: {DateTime.Now}{xv}",
                DlugoscZamawiana = g.Key.D,
                DlugoscNaGotowo = g.FirstOrDefault()?.Wymiar != null ? int.Parse(g.First().Wymiar) : 0,
                DlugoscNaGotowoGrupa = string.Join("; ", g.Select(i => i.Wymiar)),
                IloscSztuk = g.Sum(i => int.Parse(i.Ilosc)),
                DataZamowienia = DateTime.MinValue,
                DataRealizacji = DateTime.MinValue,
                DataDostarczenia = DateTime.MinValue,
                DataZapisu = DateTime.Now,
                KtoZapisal = user ?? "",
                PozDostarczono = false,
                WyslanoDoZamowien = false,
                MaterialZeStanMagazyn = false,
            }).ToList();

        var resp = await Http.PostAsJsonAsync($"api/kantowkaDoZlecen/save-all/{isCheckedDelAll}", grouped);
        if (resp.IsSuccessStatusCode)
        {
            kantowkaDoZlecen = await Http.GetFromJsonAsync<List<KantowkaDoZlecenViewModel>>($"api/KantowkaDoZlecen/rowid/{RowIdZlecenia}");
            zestawienie = null;
        }
    }

