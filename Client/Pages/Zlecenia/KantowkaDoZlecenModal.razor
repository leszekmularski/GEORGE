    private async Task Laduj_Uprawnienia()
    {
        user = await LocalStorage.GetStringAsync("user");
        if (string.IsNullOrEmpty(user)) { user = "NaN"; return; }

        const string t = "KantowkaDoZlecen";
        try
        {
            uprawnienia = await Http.GetFromJsonAsync<List<UprawnieniaPracownikaViewModel>>($"/api/ZwrocSatus/{user}/{t}");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            await _message.Error("Brak danych - status użytkownika");
        }
        catch (Exception ex) { await _message.Error(ex.Message); }

        if (uprawnienia != null && uprawnienia.Count > 0)
        {
            var s = uprawnienia.FirstOrDefault(x => x.TableName == t);
            if (s != null)
            {
                boolOdczyt = s.Odczyt;
                boolZmiana = s.Zmiana;
                boolUsuniecia = s.Usuniecie;
                boolAdmin = s.Administrator;
                RowIdPracownika = s.RowId;
                adresEmail = s.Email;
                hasloPoczta = s.HasloDoPoczty;
                Uimie = s.Imie;
                Unazwisko = s.Nazwisko;
            }
        }
    }
