        var resp = await Http.DeleteAsync($"api/KantowkaDoZlecen/{id}");
        if (resp.IsSuccessStatusCode)
            kantowkaDoZlecen = kantowkaDoZlecen.Where(r => r.Id != id).ToList();
    }

    private async Task HandleSubmit()
    {
        if (!_visible || blokujDwuKlik) return;
        kantowka.Przekroj = kantowka.Przekroj.ToUpper();
        blokujDwuKlik = true;

        HttpResponseMessage resp;
        if (kantowka.Id == 0)
            resp = await Http.PostAsJsonAsync("api/KantowkaDoZlecen", kantowka);
        else
        {
            kantowka.DataDostarczenia = kantowka.PozDostarczono ? DateTime.Now : DateTime.MinValue;
            kantowka.KtoZapisal = user ?? "";
            kantowka.Uwagi = $"Zmiana z dnia: {DateTime.Now}";
            resp = await Http.PutAsJsonAsync($"api/KantowkaDoZlecen/{kantowka.Id}", kantowka);
        }

        if (resp.IsSuccessStatusCode)
        {
            kantowkaDoZlecen = await Http.GetFromJsonAsync<List<KantowkaDoZlecenViewModel>>($"api/KantowkaDoZlecen/rowid/{RowIdZlecenia}");
            if (kantowkaDoZlecen != null) oryginalkantowkaDoZlecen = kantowkaDoZlecen.DeepCopyList();
            _visible = false;
            kantowka = new KantowkaDoZlecenViewModel();
            await HideDialog();
            StateHasChanged();
        }
        blokujDwuKlik = false;
    }

