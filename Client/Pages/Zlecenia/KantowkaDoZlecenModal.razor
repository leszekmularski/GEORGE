    private bool _showPasteConfirm = false;
    private List<KantowkaDoZlecenViewModel> _pastePending = new();

    private async Task PasteKantowkiToClipboard()
    {
        try
        {
            var clipboardText = await JSRuntime.InvokeAsync<string>("navigator.clipboard.readText");

            if (string.IsNullOrWhiteSpace(clipboardText))
            {
                await _message.Warning("Schowek jest pusty.");
                return;
            }

            var parsed = ParseKantowkiFromClipboard(clipboardText);

            if (parsed.Count == 0)
            {
                await _message.Warning(
                    "Nie rozpoznano danych kantówki w schowku. " +
                    "Upewnij się, że dane zostały skopiowane przyciskiem Kopiuj.");
                return;
            }

            // ⬇ Zamiast confirm service – pokazujemy własny modal potwierdzenia
            _pastePending = parsed;
            _showPasteConfirm = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _notice.Error(new()
            {
                Message = "Błąd wklejania ze schowka.",
                Description = ex.Message,
                Placement = NotificationPlacement.BottomLeft
            });
        }
    }

    private async Task ConfirmPasteAsync()
    {
        if (_pastePending == null || _pastePending.Count == 0) return;

        _showPasteConfirm = false;
        StateHasChanged();

        int saved = 0;
        int failed = 0;

        foreach (var k in _pastePending)
        {
            var resp = await Http.PostAsJsonAsync("api/KantowkaDoZlecen", k);
            if (resp.IsSuccessStatusCode) saved++;
            else failed++;
        }

        kantowkaDoZlecen = await Http.GetFromJsonAsync<List<KantowkaDoZlecenViewModel>>(
            $"api/KantowkaDoZlecen/rowid/{RowIdZlecenia}");

        if (kantowkaDoZlecen != null)
            kantowkaDoZlecenSuma = kantowkaDoZlecen.Sum(k => k.DlugoscZamawiana * k.IloscSztuk);

        _pastePending.Clear();

        if (failed == 0)
            await _message.Success($"Wklejono i zapisano {saved} pozycji.");
        else
            await _message.Warning($"Zapisano {saved} pozycji, {failed} nie powiodło się.");

        StateHasChanged();
    }

    private List<KantowkaDoZlecenViewModel> ParseKantowkiFromClipboard(string text)
    {
        var result = new List<KantowkaDoZlecenViewModel>();
        if (string.IsNullOrWhiteSpace(text)) return result;

        var knownKeys = new[] {
        "RowIdZlecenia", "GatunekKantowki", "Przekroj", "NazwaProduktu", "KodProduktu",
        "Uwagi", "DlugoscZamawiana", "DlugoscNaGotowo", "DlugoscNaGotowoGrupa",
        "IloscSztuk", "DataZamowienia", "DataRealizacji", "DataDostarczenia", "DataZapisu",
        "KtoZapisal", "OstatniaZmiana",
        "WyslanoDoZamowien", "PozDostarczono", "MaterialZeStanMagazyn"
    };

        var keysPattern = string.Join("|", knownKeys.Select(Regex.Escape));
        var lineRegex = new Regex($@"({keysPattern}):\s*(.*?)(?=,\s*(?:{keysPattern}):\s|$)", RegexOptions.IgnoreCase);

        var lines = text.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);

        foreach (var line in lines)
        {
            if (string.IsNullOrWhiteSpace(line)) continue;

            var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (Match m in lineRegex.Matches(line))
                dict[m.Groups[1].Value] = m.Groups[2].Value.Trim();

            if (dict.Count == 0) continue;

            try
            {
                var originalUwagi = GetString(dict, "Uwagi");
                var note = $"Wklejono ze schowka: {DateTime.Now:yyyy-MM-dd HH:mm}";

                var k = new KantowkaDoZlecenViewModel
                {
                    RowIdZlecenia = RowIdZlecenia,
                    GatunekKantowki = GetString(dict, "GatunekKantowki"),
                    Przekroj = GetString(dict, "Przekroj"),
                    NazwaProduktu = GetString(dict, "NazwaProduktu"),
                    KodProduktu = GetString(dict, "KodProduktu"),
                    DlugoscNaGotowoGrupa = GetString(dict, "DlugoscNaGotowoGrupa"),
                    Uwagi = string.IsNullOrWhiteSpace(originalUwagi) ? note : $"{note} | {originalUwagi}",
                    DlugoscZamawiana = GetInt(dict, "DlugoscZamawiana"),
                    DlugoscNaGotowo = GetInt(dict, "DlugoscNaGotowo"),
                    IloscSztuk = GetInt(dict, "IloscSztuk"),
                    DataZamowienia = GetDate(dict, "DataZamowienia"),
                    DataRealizacji = GetDate(dict, "DataRealizacji"),
                    DataDostarczenia = GetDate(dict, "DataDostarczenia"),
                    DataZapisu = DateTime.Now,
                    KtoZapisal = user ?? "",
                    WyslanoDoZamowien = GetBool(dict, "WyslanoDoZamowien"),
                    PozDostarczono = GetBool(dict, "PozDostarczono"),
                    MaterialZeStanMagazyn = GetBool(dict, "MaterialZeStanMagazyn"),
                };

                // Walidacja minimalna
                if (string.IsNullOrWhiteSpace(k.Przekroj) && k.IloscSztuk == 0) continue;

                result.Add(k);
            }
            catch { /* pomiń błędne linie */ }
        }

        return result;
    }

    private static string GetString(Dictionary<string, string> d, string key)
        => d.TryGetValue(key, out var v) ? v : string.Empty;

    private static int GetInt(Dictionary<string, string> d, string key)
        => d.TryGetValue(key, out var v) && int.TryParse(v, out var i) ? i : 0;

    private static bool GetBool(Dictionary<string, string> d, string key)
        => d.TryGetValue(key, out var v) && bool.TryParse(v, out var b) && b;

    private static DateTime GetDate(Dictionary<string, string> d, string key)
    {
        if (!d.TryGetValue(key, out var v) || string.IsNullOrWhiteSpace(v))
            return DateTime.MinValue;
        if (v.StartsWith("0001")) return DateTime.MinValue;
        return DateTime.TryParse(v, out var dt) ? dt : DateTime.MinValue;
    }

