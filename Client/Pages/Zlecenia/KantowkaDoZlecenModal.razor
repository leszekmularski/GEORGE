@using GEORGE.Shared.Models
@using GEORGE.Shared.ViewModels
@using GEORGE.Shared.Class
@using Microsoft.AspNetCore.Components.Forms
@using System.Net
@using System.Text.Json
@using System.Text.RegularExpressions
@using AntDesign

@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject IMessageService _message
@inject PdfReaderService PdfReaderService
@inject GEORGE.Client.Pages.PDF.PdfDataParser PdfDataParser
@inject Utilities.ILocalStorage LocalStorage
@inject IConfirmService _confirmService
@inject INotificationService _notice

@if (!string.IsNullOrEmpty(Display) && Display != "none")
{
    <style>
        /* styl modala – scoped na tyle, na ile to możliwe */
        .kantowka-modal .custom-link { color: blue; }
        .kantowka-modal .zrealizowano, .kantowka-modal .zrealizowano > td {
            background-color: forestgreen !important; color: white;
        }
        .kantowka-modal .zrealizowano:hover, .kantowka-modal .zrealizowano:hover > td {
            background-color: mediumslateblue !important; font-size: 1.0em;
        }
        .kantowka-modal .zamowiono, .kantowka-modal .zamowiono > td {
            background-color: lightblue !important; color: black;
        }
        .kantowka-modal .zamowiono:hover, .kantowka-modal .zamowiono:hover > td {
            background-color: mediumslateblue !important; font-size: 1.0em;
        }
        .kantowka-modal .zlecenieNaN, .kantowka-modal .zlecenieNaN > td {
            background-color: whitesmoke !important; color: black;
        }
        .kantowka-modal .zlecenieNaN:hover, .kantowka-modal .zlecenieNaN:hover > td {
            background-color: mediumslateblue !important; font-size: 1.0em;
        }
        .kantowka-modal .highlighted-row, .kantowka-modal .highlighted-row > td {
            background-color: yellow !important; color: black !important;
        }

        .ant-modal-root,
        .ant-modal-wrap {
            z-index: 1200 !important;
        }

        .ant-modal-mask {
            z-index: 1190 !important;
        }
    </style>

    <div class="modal fade kantowka-modal @ClassShow"
         tabindex="-1"
         style="display: @Display; z-index: 1060; background-color: rgba(0,0,0,0.45);"
         @onclick="OnBackdropClick">
        <div class="modal-dialog modal-xl" style="max-width: 96%;" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Zamówiona kantówka do zlecenia: @dotyczyZlecenia</h5>
                    <button type="button" class="close" aria-label="Close" @onclick="HandleCloseModal">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body" style="max-height: 82vh; overflow-y: auto;">

                    @if (boolAdmin || boolZmiana)
                    {
                        <Button Type="primary" OnClick="@ShowDialogAddNew">
                            Dodaj nowe zestawienie materiałów
                        </Button>

                        @if (kantowkaDoZlecen == null || kantowkaDoZlecen.Count == 0)
                        {
                            <Tooltip Placement="@Placement.BottomCenter"
                                     Title="Wklej dane ze schowka (skopiowane z innego zlecenia) i zapisz do bazy">
                                <Button Type="reset" Icon="@IconType.Fill.Read" OnClick="PasteKantowkiToClipboard" />
                            </Tooltip>
                        }
                    }

                    @if (kantowkaDoZlecen != null && kantowkaDoZlecen.Count > 0)
                    {
                        @if (kopiuj)
                        {
                            <Tooltip Placement="@Placement.BottomCenter" Title="Kopiuj dane">
                                <Button Type="reset" Icon="@IconType.Fill.Copy" OnClick="CopyKantowkiToClipboard" />
                            </Tooltip>
                        }
                        else
                        {
                            <Tooltip Placement="@Placement.BottomCenter" Title="Wklej dane w innej aplikacji">
                                <Button Type="reset" Icon="@IconType.Fill.Read" OnClick="PasteKantowkiToClipboard" />
                            </Tooltip>
                        }

                        <Tooltip Placement="@Placement.BottomCenter" Title="Zapisz do pliku CSV - wszystko">
                            <Button Type="reset" Icon="@IconType.Fill.Save" OnClick="ExportToExcel" />
                        </Tooltip>

                        <Button Type="reset" OnClick="ExportSelectedColumnsToExcel">
                            Zapisz do pliku CSV - tylko wymagane kolumny
                        </Button>

                        <Tooltip Placement="@Placement.BottomCenter" Title="Wyślij zamówienie e-mailem (SMTP).">
                            <Button Type="reset" Icon="@IconType.Fill.Mail" OnClick="SendElementCheckToEmailViaSmtp" />
                        </Tooltip>

                        <Tooltip Placement="@Placement.BottomCenter" Title="Zapisz sformatowany dokument EXCEL.">
                            <Button Type="reset" Icon="@IconType.Fill.FileExcel"
                                    OnClick="@(() => ZapiszExcelKantowkiPoStronieKlienta(false))" />
                        </Tooltip>

                        <Tooltip Placement="@Placement.BottomCenter" Title="Zapisz EXCEL na produkcję.">
                            <Button Type="reset" Icon="@IconType.Fill.FileExcel"
                                    OnClick="@(() => ZapiszExcelKantowkiPoStronieKlienta(true))" />
                        </Tooltip>

                        <Button Type="reset" OnClick="UstawDateZamowienia">
                            Kantówkę zamówiono (wygeneruj wpis do zamówień)
                        </Button>

                        <Tooltip Placement="@Placement.BottomCenter" Title="Wylicz ilość farby">
                            <Button Icon="@IconType.Fill.Compass" Type="reset" OnClick="WyliczIloscFarby" />
                        </Tooltip>

                        <Tooltip Placement="@Placement.BottomCenter" Title="Sprawdź ilość sztang">
                            <Button Icon="@IconType.Fill.Calculator" Type="reset" OnClick="WyliczIloscSztang" />
                        </Tooltip>

                        <Tooltip Placement="@Placement.BottomCenter" Title="Ilość widocznych rekordów">
                            <AntDesign.InputNumber TValue="int"
                                                   @bind-Value="_pageSize"
                                                   Min="2" Max="25" Bordered="false"
                                                   OnChange="@(e => OnClickChange(e))"
                                                   Style="width: 60px; padding: 0;" />
                        </Tooltip>
                    }

                    @if (kantowkaDoZlecen == null)
                    {
                        <Spin Style="margin-left:47%" size="large" />
                        <p style="margin-left:43%"><em>Czekaj na załadowanie danych...</em></p>
                    }
                    else
                    {
                        <Divider>
                            Ilość pozycji: @kantowkaDoZlecen.Count(), suma sztuk: @kantowkaDoZlecen.Sum(x => x.IloscSztuk),
                            suma długości: @(kantowkaDoZlecenSuma / 1000) mb
                        </Divider>
                        @if (kantowkaDoZlecen.Count > 0)
                        {
                            <Table TItem="KantowkaDoZlecenViewModel"
                            DataSource="@kantowkaDoZlecen"
                            ScrollX="1950"
                            PageSize="@_pageSize"
                            Size="TableSize.Small"
                            RowClassName="@(x => x?.Data?.WyslanoDoZamowien == true
                                   ? (x?.Data?.PozDostarczono == true ? "zrealizowano" : "zamowiono")
                                   : (x?.Data?.PozDostarczono == true ? "zrealizowano" : "zlecenieNaN"))">

                                <Column Title="ID" @bind-Field="@context.Id" Hidden />
                                <Column Title="Gatunek" @bind-Field="@context.GatunekKantowki" Sortable OnFilter="(a,b) => a == b" Filterable />
                                <Column Title="Przekrój" @bind-Field="@context.Przekroj" Sortable OnFilter="(a,b) => a == b" Filterable />
                                <Column Title="Opis" @bind-Field="@context.NazwaProduktu" Sortable />
                                <Column Title="Długość na gotowo" @bind-Field="@context.DlugoscNaGotowo" Sortable />
                                <Column Width="150" Title="Długość na gotowo cd." @bind-Field="@context.DlugoscNaGotowoGrupa" Sortable />
                                <Column Title="Długość zamówiona" @bind-Field="@context.DlugoscZamawiana" Sortable />
                                <Column Title="Ilość sztuk" @bind-Field="@context.IloscSztuk" Sortable />
                                <Column Title="Ze stanu" TData="bool">
                                    <Template>
                                        <Checkbox @bind-Checked="@context.MaterialZeStanMagazyn"
                                        OnChange="(e)=>Handle(e, context.Id)" />
                                    </Template>
                                </Column>
                                <Column Width="350" Title="Uwagi" @bind-Field="@context.Uwagi" Sortable />
                                <Column Title="Autor zmian" @bind-Field="@context.KtoZapisal" Sortable />
                                <Column Title="Wysłano do zamówienia" @bind-Field="@context.WyslanoDoZamowien" Hidden />

                                <Column Title="Data zamówienia" TData="DateTime" DataIndex="DataZamowienia" Format="yyyy-MM-dd" Sortable />
                                <Column Title="Max. data realizacji" TData="DateTime" DataIndex="DataRealizacji" Format="yyyy-MM-dd" Sortable />
                                <Column Title="Data dostarczenia" TData="DateTime" DataIndex="DataDostarczenia" Format="yyyy-MM-dd" Sortable />
                                <Column Title="Data zapisu" TData="DateTime" DataIndex="DataZapisu" Format="yyyy-MM-dd" Sortable />

                                <ActionColumn Title="Akcja" Width="100" Fixed="right">
                                    @if (boolAdmin || boolZmiana)
                                    {
                                        <Popconfirm Title="Czy chcesz edytować pozycję?"
                                        OnConfirm="()=> editRow(context.Id)"
                                        OkText="Tak" CancelText="Nie">
                                            <a>Edytuj</a>
                                        </Popconfirm>
                                    }
                                    @if (boolAdmin || boolUsuniecia)
                                    {
                                        <Popconfirm Title="Czy chcesz usunąć pozycję?"
                                        OnConfirm="()=> deleteRow(context.Id)"
                                        OkText="Tak" CancelText="Nie">
                                            <a style="color:red">Usuń</a>
                                        </Popconfirm>
                                    }
                                </ActionColumn>
                            </Table>
                        }
                    }

                    <div style="margin-top: 15px;">
                        <h7>Wybierz plik z STOLCAD z listą materiałów (PDF/XLSX) lub wklej ze schowka</h7>
                        <InputFile OnChange="HandleFileSelected" />

                        <Button Type="@ButtonType.Link"
                                style="font-size:1.1em; height:30px; margin-top:10px; color:brown"
                                @onclick="PasteStolcad">
                            Wklej ze schowka dane pobrane z STOLCAD
                        </Button>

                        @if (zestawienie != null)
                        {
                            <Divider />
                            <Button Type="@ButtonType.Primary" Style="width:49%" Disabled="@isNotDisabled" OnClick="SaveAll">
                                Zapisz wszystkie z poniższej tabeli
                            </Button>
                            <Button Type="@ButtonType.Primary" Style="width:49%" Disabled="@isNotDisabled" OnClick="SaveAllGrupa">
                                Zapisz wszystkie oraz grupuj
                            </Button>
                            <Checkbox @bind-Checked="isCheckedDelAll">Usuń wszystkie dane przed zapisem nowych</Checkbox>

                            <h4>Zestawienie Nr: @zestawienie.NrZestawienia</h4>
                            <p>Data: @zestawienie.Data.ToString("yyyy/MM/dd")</p>
                            <p>Odbiorca: @zestawienie.Odbiorca</p>

                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Lp</th><th>Symbol</th><th>Przekrój</th><th>Ilość</th>
                                        <th>Wymiar</th><th>Kąt</th><th>Wymiar Zam.</th><th>Uwagi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in zestawienie.ListaCieci)
                                    {
                                        <tr>
                                            <td>@item.Lp</td>
                                            <td>@item.Symbol</td>
                                            <td>@item.Kolor</td>
                                            <td>@item.Ilosc</td>
                                            <td>@item.Wymiar</td>
                                            <td>@item.Kat</td>
                                            <td>@item.WymiarNaZamowienie</td>
                                            <td>@item.Uwagi</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Wewnętrzny modal: dodaj / zmień kantówkę ===== -->
    <div class="modal fade @classShow" tabindex="-1" style="display: @display; z-index: 1070;">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Kantówki dodaj / zmień</h5>
                    <button type="button" class="close" @onclick="HandleCancel">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <AntDesign.Form Model="@kantowka" Layout="FormLayout.Horizontal" OnFinish="HandleSubmit">
                        <div class="row">
                            <div class="col-md-6">
                                <AntDesign.FormItem Label="Gatunek drewna">
                                    <AntDesign.Input @bind-Value="kantowka.GatunekKantowki" MaxLength="80" Required />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Przekrój">
                                    <AntDesign.Input @bind-Value="kantowka.Przekroj" Required />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Nazwa produktu">
                                    <AntDesign.Input @bind-Value="kantowka.NazwaProduktu" Required />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Kod produktu">
                                    <AntDesign.Input @bind-Value="kantowka.KodProduktu" />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Długość wyliczona">
                                    <AntDesign.Input @bind-Value="kantowka.DlugoscNaGotowo" OnBlur="LiczDlugoscZam" />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Długość na gotowo(2) - grupa">
                                    <AntDesign.Input @bind-Value="kantowka.DlugoscNaGotowoGrupa" OnBlur="LiczDlugoscZam" />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Ilość sztuk">
                                    <AntDesign.InputNumber @bind-Value="kantowka.IloscSztuk" Required />
                                </AntDesign.FormItem>
                            </div>
                            <div class="col-md-6">
                                <AntDesign.FormItem Label="Uwagi">
                                    <AntDesign.Input @bind-Value="kantowka.Uwagi" />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Długość zamówiona">
                                    <AntDesign.Input @bind-Value="kantowka.DlugoscZamawiana" />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Data zamówienia">
                                    <AntDesign.DatePicker @bind-Value="kantowka.DataZamowienia" Required />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Data realizacji">
                                    <AntDesign.DatePicker @bind-Value="kantowka.DataRealizacji" Required />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Materiał ze stanu magazynowego">
                                    <AntDesign.Checkbox @bind-Value="kantowka.MaterialZeStanMagazyn" />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Wygenerowano zamówienie">
                                    <AntDesign.Checkbox @bind-Value="kantowka.WyslanoDoZamowien" />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Kantówkę dostarczono">
                                    <AntDesign.Checkbox @bind-Value="kantowka.PozDostarczono" />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Kto zapisał">
                                    <AntDesign.Input @bind-Value="kantowka.KtoZapisal" Required />
                                </AntDesign.FormItem>
                                <AntDesign.FormItem Label="Ostatnia zmiana">
                                    <AntDesign.Input @bind-Value="kantowka.OstatniaZmiana" />
                                </AntDesign.FormItem>
                            </div>
                        </div>
                        <AntDesign.FormItem Style="justify-content: flex-end; display: flex; gap: 10px;">
                            <AntDesign.Button Type="primary" @onclick="HandleAddNew" HtmlType="submit">Zapisz</AntDesign.Button>
                            <AntDesign.Button @onclick="HandleCancel">Anuluj</AntDesign.Button>
                        </AntDesign.FormItem>
                    </AntDesign.Form>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Wewnętrzny modal: wybór producenta ===== -->
    @if (_producenci != null && elementyZamowienia != null)
    {
        <div class="modal fade @classShowKantowka" tabindex="-1" style="display: @displayKantowka; z-index: 1070;">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Wybierz producenta kantówki</h5>
                        <button type="button" class="close" @onclick="HandleKantowkaCancel">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <AntDesign.Form Model="@elementyZamowienia" Layout="FormLayout.Horizontal" OnFinish="HandleKantowkaSubmit">
                            <FormItem Style="width:100%" Required Label="Wybierz producenta (dostawcę)">
                                <Select Mode="default"
                                        DataSource="@_producenci"
                                        @bind-Value="@context.ElemetZamDoZlecen.RowIdProducent"
                                        LabelName="@nameof(ProducenciPodwykonawcy.NazwaProducenta)"
                                        ValueName="@nameof(ProducenciPodwykonawcy.RowId)" />
                            </FormItem>
                            <AntDesign.FormItem Style="justify-content: flex-end; display: flex; gap: 10px;">
                                <AntDesign.Button Disabled="@wylaczZapiszKantowke" Type="primary"
                                                  @onclick="HandleAddNewKantowka" HtmlType="submit">
                                    Wybierz producenta i zapisz jako nową pozycję zamówienia
                                </AntDesign.Button>
                                <AntDesign.Button @onclick="HandleCancelKantowka">Anuluj</AntDesign.Button>
                            </AntDesign.FormItem>
                        </AntDesign.Form>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Dodaj na końcu modala kantówki *@
    @if (_showPasteConfirm)
    {
        <div class="modal fade show"
             style="display:block; z-index: 1200; background: rgba(0,0,0,.45);"
             @onclick="() => _showPasteConfirm = false">
            <div class="modal-dialog" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Wklej i zapisz do bazy</h5>
                        <button type="button" class="close" @onclick="() => _showPasteConfirm = false">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        Znaleziono <b>@_pastePending.Count</b> pozycji kantówki w schowku.<br />
                        Zapisać je jako nowe pozycje dla bieżącego zlecenia
                        (<b>@dotyczyZlecenia</b>)?
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-primary" @onclick="ConfirmPasteAsync">Zapisz</button>
                        <button class="btn btn-secondary" @onclick="() => _showPasteConfirm = false">Anuluj</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    // ============================================================
    // PARAMETRY
    // ============================================================
    [Parameter] public string? RowIdZlecenia { get; set; }
    [Parameter] public string? Typ { get; set; } = "zew";
    [Parameter] public string ClassShow { get; set; } = "";
    [Parameter] public string Display { get; set; } = "none";
    [Parameter] public EventCallback OnHideDialog { get; set; }

    [Inject] private AppState AppState { get; set; } = default!;

    // ============================================================
    // STAN
    // ============================================================
    private ElemetZamDoZlecenWithProducent? elementyZamowienia;
    private string? pdfContent;
    private List<KantowkaDoZlecenViewModel>? kantowkaDoZlecen;
    private List<KantowkaDoZlecenViewModel>? oryginalkantowkaDoZlecen;
    private GEORGE.Client.Pages.PDF.Zestawienie? zestawienie;
    private List<ProducenciPodwykonawcy>? _producenci;

    private bool _visible = false;
    private string display = "none";
    private string classShow = "";

    private bool _visibleKantowka = false;
    private string displayKantowka = "none";
    private string classShowKantowka = "";

    private long cid = -1;
    private KantowkaDoZlecenViewModel kantowka = new();
    private List<KantowkaDoZlecenViewModel>? kantowki;

    private bool kopiuj = true;
    private bool isCheckedDelAll = true;
    private int _pageSize = 7;

    private string dotyczyZlecenia = "";
    private string dotyczyKlienta = "";
    private int kantowkaDoZlecenSuma = 0;

    private string? adresEmail = "";
    private string? hasloPoczta = "";
    private string? Uimie = "";
    private string? Unazwisko = "";

    private string formatPlikuImport = "NaN";
    private bool blokujDwuKlik = false;
    private bool wylaczZapiszKantowke = false;
    private bool czekajNaWysWiad = false;

    // ============================================================
    // UPRAWNIENIA
    // ============================================================
    private bool boolOdczyt = false;
    private bool boolZmiana = false;
    private bool boolUsuniecia = false;
    private bool boolAdmin = false;
    private string RowIdPracownika = "";
    private string? user;
    private bool isNotDisabled => !boolZmiana || !boolAdmin;
    private List<UprawnieniaPracownikaViewModel>? uprawnienia;

    // ============================================================
    // KONTROLA ŁADOWANIA DANYCH PRZY POKAZYWANIU MODALA
    // ============================================================
    private string? _lastLoadedRowId;
    private bool _wasVisible = false;
    private bool _jsInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        await Laduj_Uprawnienia();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_jsInitialized)
        {
            _jsInitialized = true;
            // Definiujemy funkcje JS raz – jeżeli już istnieją, nie nadpisujemy
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (typeof window.copyToClipboard === 'undefined') {
                    window.copyToClipboard = function(text) {
                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(text);
                        } else {
                            var t = document.createElement('textarea');
                            t.value = text; document.body.appendChild(t); t.select();
                            document.execCommand('copy'); document.body.removeChild(t);
                        }
                    };
                }
                if (typeof window.saveAsExcel === 'undefined') {
                    window.saveAsExcel = function(jsonData) {
                        const data = JSON.parse(jsonData);
                        const csvRows = [];
                        const headers = Object.keys(data[0]);
                        csvRows.push(headers.join(','));
                        for (const row of data) {
                            csvRows.push(headers.map(h => '""' + ('' + row[h]).replace(/""/g, '\\""') + '""').join(','));
                        }
                        const blob = new Blob([csvRows.join('\n')], { type: 'text/csv' });
                        const a = document.createElement('a');
                        a.href = URL.createObjectURL(blob);
                        a.download = 'kantowka_all.csv';
                        document.body.appendChild(a); a.click(); document.body.removeChild(a);
                    };
                }
                if (typeof window.saveAsExcelSel === 'undefined') {
                    window.saveAsExcelSel = function(jsonData) {
                        const data = JSON.parse(jsonData);
                        const csvRows = [];
                        const headers = ['GatunekKantowki','Przekroj','NazwaProduktu','DlugoscZamawiana','DlugoscNaGotowoGrupa','IloscSztuk'];
                        csvRows.push(headers.join(','));
                        for (const row of data) {
                            csvRows.push(headers.map(h => '""' + ('' + row[h]).replace(/""/g, '\\""') + '""').join(','));
                        }
                        const blob = new Blob([csvRows.join('\n')], { type: 'text/csv' });
                        const a = document.createElement('a');
                        a.href = URL.createObjectURL(blob);
                        a.download = 'kantowka.csv';
                        document.body.appendChild(a); a.click(); document.body.removeChild(a);
                    };
                }
                if (typeof window.saveAsExcelKantowki === 'undefined') {
                    window.saveAsExcelKantowki = function(base64Excel, fileName) {
                        const binary = atob(base64Excel);
                        const bytes = new Uint8Array(binary.length);
                        for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
                        const blob = new Blob([bytes], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                        const a = document.createElement('a');
                        a.href = URL.createObjectURL(blob);
                        a.download = fileName;
                        document.body.appendChild(a); a.click(); document.body.removeChild(a);
                    };
                }
            ");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        bool isVisible = !string.IsNullOrEmpty(Display) && Display != "none";
        bool becameVisible = isVisible && !_wasVisible;
        bool rowChanged = RowIdZlecenia != _lastLoadedRowId;

        _wasVisible = isVisible;

        if ((becameVisible || rowChanged) && isVisible && !string.IsNullOrEmpty(RowIdZlecenia))
        {
            _lastLoadedRowId = RowIdZlecenia;
            await LoadDataAsync();
            StateHasChanged();
        }
    }

