    private async Task LoadDataAsync()
    {
        _pageSize = Convert.ToInt32(await LocalStorage.GetStringAsync("kantowka_ile_widocznych"));
        if (_pageSize == 0) _pageSize = 6;

        if (AppState != null) AppState.SomeData = "";

        // wyczyść stare dane
        kantowkaDoZlecen = null;
        zestawienie = null;
        dotyczyZlecenia = "";
        dotyczyKlienta = "";

        try
        {
            kantowkaDoZlecen = await Http.GetFromJsonAsync<List<KantowkaDoZlecenViewModel>>($"api/KantowkaDoZlecen/rowid/{RowIdZlecenia}");
            if (kantowkaDoZlecen != null)
                kantowkaDoZlecenSuma = kantowkaDoZlecen.Sum(k => k.DlugoscZamawiana * k.IloscSztuk);

            kantowka = new KantowkaDoZlecenViewModel { Id = 0 };
        }
        catch (Exception ex) { Console.WriteLine($"******* Błąd {ex.Message}"); }

        try
        {
            if (Typ == "zew")
            {
                var response = await Http.GetAsync($"api/ZlecenieProdukt/getzlecclickzew/{RowIdZlecenia}");
                if (response.IsSuccessStatusCode)
                {
                    var l = await response.Content.ReadFromJsonAsync<List<ZleceniaProdukcyjne>>();
                    if (l != null && l.Count > 0)
                    {
                        dotyczyZlecenia = $"{l[0].NumerZamowienia} / {l[0].Klient}";
                        dotyczyKlienta = l[0].Klient ?? "";
                    }
                }
            }
            else if (Typ == "wew")
            {
                var response = await Http.GetAsync($"api/ZlecenieProdukt/getzlecclickwew/{RowIdZlecenia}");
                if (response.IsSuccessStatusCode)
                {
                    var l = await response.Content.ReadFromJsonAsync<List<ZleceniaProdukcyjneWew>>();
                    if (l != null && l.Count > 0)
                    {
                        dotyczyZlecenia = $"{l[0].TypZamowienia ?? ""} / {l[0].NumerZamowienia ?? ""} / {l[0].Klient ?? ""}";
                        dotyczyKlienta = l[0].Klient ?? "";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Błąd pobierania zleceń produkcyjnych: {ex.Message}");
        }
    }

